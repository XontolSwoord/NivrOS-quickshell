//@ pragma UseQApplication
//@ pragma Env QT_QPA_PLATFORMTHEME=gtk3
//@ pragma Env QT_ICON_THEME=WhiteSur-dark
import QtQuick
import QtQuick.Layouts
import QtQuick.Controls
import Quickshell
import Quickshell.Wayland
import Quickshell.Io
import Quickshell.Services.Mpris

ShellRoot {
    id: root

    function formatTime(sec) {
        let s = Math.max(0, Math.floor(sec || 0));
        let m = Math.floor(s / 60);
        let r = s % 60;
        return m + ":" + (r < 10 ? "0" : "") + r;
    }

    property bool dockWidgetsEnabled: true
    property bool desktopEditMode: false
    property bool dockWidgetEditorOpen: false
    property var cpuHistory: [12, 16, 14, 20, 18, 15, 13, 17, 14, 12]
    property var dockItems: ({
        focus: true,
        calendar: true,
        cpu: true,
        battery: true,
        media: true,
        settings: true
    })
    property var dockLeftOrder: ["focus", "calendar", "cpu", "battery"]
    property var dockRightOrder: ["media", "settings"]

    function isDockWidgetOn(key) {
        return root.dockWidgetsEnabled && root.dockItems && !!root.dockItems[key];
    }

    function toggleDockWidget(key) {
        let next = JSON.parse(JSON.stringify(root.dockItems || { focus: true, calendar: true, cpu: true, battery: true, media: true, settings: true }));
        next[key] = !next[key];
        root.dockItems = next;
        let anyOn = false;
        for (let k in next) {
            if (next[k]) anyOn = true;
        }
        root.dockWidgetsEnabled = anyOn;
        if (typeof win !== "undefined" && win.saveLayout) win.saveLayout();
    }

    function moveDockWidget(side, key, dir) {
        let arr = (side === "left" ? root.dockLeftOrder : root.dockRightOrder).slice();
        let idx = arr.indexOf(key);
        let target = idx + dir;
        if (idx < 0 || target < 0 || target >= arr.length) return;
        let tmp = arr[idx];
        arr[idx] = arr[target];
        arr[target] = tmp;
        if (side === "left") root.dockLeftOrder = arr;
        else root.dockRightOrder = arr;
        if (typeof win !== "undefined" && win.saveLayout) win.saveLayout();
    }

    function setAllDockWidgets(enableAll) {
        root.dockItems = {
            focus: enableAll,
            calendar: enableAll,
            cpu: enableAll,
            battery: enableAll,
            media: enableAll,
            settings: enableAll
        };
        root.dockWidgetsEnabled = enableAll;
        if (typeof win !== "undefined" && win.saveLayout) win.saveLayout();
    }

    function openDockWidgetEditor() {
        if (typeof root.closePopups === "function") root.closePopups();
        if (typeof win !== "undefined") {
            if ("ctxMenuVisible" in win) win.ctxMenuVisible = false;
            win.editMode = false;
        }
        root.desktopEditMode = false;
        root.dockWidgetEditorOpen = true;
    }

    // ── State Animasi Bertahap Seluruh Sistem ───────────────────────────
    property int bootStage: 1
    Timer {
        id: bootStaggerTimer
        interval: 85
        repeat: true
        running: true
        onTriggered: {
            if (root.bootStage < 6) root.bootStage++;
            else stop();
        }
    }

    // ── State Sistem & Hardware Terverifikasi ───────────────────────────
    property var wallpaperList: []
    property string currentWallpaper: ""
    property string focusedAppName: "Finder"
    property var runningWindows: []
    property bool hasWindowOnActiveWs: false

    property string wifiName: "Memeriksa..."
    property bool wifiEnabled: true
    property bool wifiConnected: false
    property var wifiNetworks: []
    property bool wifiScanning: false
    property string wifiPasswordTarget: ""
    property string wifiStatusMsg: ""

    property bool btEnabled: false
    property string btDeviceName: ""
    property var btDevices: []
    property bool btScanning: false
    property string btBusyMac: ""

    property bool keepAwake: false
    property bool dndEnabled: false

    property int volumeLevel: 60
    property bool volumeMuted: false
    property int brightnessLevel: 80
    property int batteryPercent: -1
    property string batteryStatus: ""

    // ── State Popup Bertahap & Bergantian (Anti-Flicker) ────────────────
    property string activePopup: "" // "", "apple", "window", "desktop", "cc", "wifi", "bt", "music", "calendar", "launchpad", "spotlight"
    property string glassStyle: "mac"
    property string mediaTitle: "No Media"
    property string mediaArtist: "Idle"
    property string mediaArtUrl: ""
    property real mediaPosition: 0
    property real mediaLength: 0
    property bool mediaPlaying: false

    property string weatherCity: "Tulungagung"
    property string weatherTemp: "31°"
    property string weatherDesc: "Partly cloudy"
    property string weatherIcon: "☀"


    function refreshWeather() {
        weatherProc.running = false;
        weatherProc.running = true;
    }

    Process {
        id: mediaProc
        Component.onCompleted: running = true
        command: ["sh", "-c", "playerctl metadata --format '{{status}}|{{title}}|{{artist}}|{{mpris:artUrl}}|{{position}}|{{mpris:length}}' 2>/dev/null || echo 'Stopped|No Media|Idle||0|0'"]
        stdout: StdioCollector {
            onStreamFinished: {
                let raw = text.trim();
                if (!raw) return;
                let p = raw.split("|");
                root.mediaPlaying = (p[0] === "Playing");
                root.mediaTitle = (p[1] && p[1].trim() !== "") ? p[1].trim() : "No Media";
                root.mediaArtist = (p[2] && p[2].trim() !== "") ? p[2].trim() : (root.mediaPlaying ? "Playing" : "Idle");
                root.mediaArtUrl = (p[3] && p[3].trim() !== "") ? p[3].trim() : "";
                let pos = parseFloat(p[4]) || 0;
                let len = parseFloat(p[5]) || 0;
                if (pos > 100000) pos = pos / 1000000.0;
                if (len > 100000) len = len / 1000000.0;
                root.mediaPosition = pos;
                root.mediaLength = len;
            }
        }
    }

    Timer {
        interval: 1500
        running: true
        repeat: true
        onTriggered: { mediaProc.running = false; mediaProc.running = true; }
    }

    Process {
        id: weatherProc
        Component.onCompleted: running = true
        command: ["sh", "-c", "curl -fsS --max-time 6 'https://wttr.in/?format=%l|%t|%C|%c' 2>/dev/null || echo 'Tulungagung|31°|Partly cloudy|☀'"]
        stdout: StdioCollector {
            onStreamFinished: {
                let raw = text.trim();
                if (!raw) return;
                let p = raw.split("|");
                if (p.length >= 4) {
                    if (p[0].trim() !== "") root.weatherCity = p[0].trim().split(",")[0];
                    if (p[1].trim() !== "") root.weatherTemp = p[1].trim().replace("+", "").replace("C", "");
                    if (p[2].trim() !== "") root.weatherDesc = p[2].trim();
                    if (p[3].trim() !== "") root.weatherIcon = p[3].trim();
                }
            }
        }
    }

    Timer {
        interval: 900000
        running: true
        repeat: true
        onTriggered: root.refreshWeather()
    }
    property var widgetCfg: ({
        locked: false,
        noteText: "Catatan Kairo:
• Cek tugas & riset
• Atur widget dari menu Settings",
        items: {
            media:   { enabled: true,  x: 24,  y: 44 },
            clock:   { enabled: true,  x: 262, y: 44 },
            weather: { enabled: true,  x: 262, y: 204 },
            battery: { enabled: true,  x: 24,  y: 352 },
            sysmon:  { enabled: true,  x: 262, y: 352 },
            notes:   { enabled: false, x: 422, y: 44 }
        }
    })
    property int cpuUsagePct: 12
    property int ramUsagePct: 24
    property string ramUsageText: "3.6 / 15.0 GB"
    property int cpuTempC: 46
    property real macOpacity: 0.33
    property real macFrost: 0.42
    property real aeroBaseOpacity: 0.30
    property real aeroSheenBright: 0.46
    property real aeroSheenWidth: 0.48
    property real liquidOpacity: 0.28
    property real liquidRefraction: 0.64
    property real liquidFringing: 0.45
    property real aeroOpacity: glassStyle === "aero" ? aeroBaseOpacity : (glassStyle === "liquid" ? liquidOpacity : macOpacity)
    property real aeroReflection: glassStyle === "aero" ? aeroSheenBright : (glassStyle === "liquid" ? liquidRefraction : macFrost)
    property real activeGlassDetail: glassStyle === "liquid" ? liquidFringing : aeroSheenWidth
    property string activeGlassWall: ""
    property string prevGlassWall: ""
    property real glassFade: 1.0

    NumberAnimation {
        id: rootGlassFadeAnim
        target: root
        property: "glassFade"
        from: 0.0
        to: 1.0
        duration: 950
        easing.type: Easing.InOutCubic
    }

    Image {
        id: rootGlassCurImg
        visible: false
        source: root.currentWallpaper
        sourceSize: Qt.size(96, 54)
        smooth: true
        asynchronous: true
        onStatusChanged: {
            if (status === Image.Ready && String(source) !== "" && root.activeGlassWall !== String(source)) {
                root.prevGlassWall = root.activeGlassWall;
                root.activeGlassWall = String(source);
                if (root.prevGlassWall !== "") {
                    root.glassFade = 0.0;
                    rootGlassFadeAnim.restart();
                } else {
                    root.glassFade = 1.0;
                }
            }
        }
    }

    Image {
        id: rootGlassPrevImg
        visible: false
        source: root.prevGlassWall
        sourceSize: Qt.size(96, 54)
        smooth: true
        asynchronous: true
    }

    function drawWallLayerGlobal(ctx, imgItem, offX, offY, scrW, scrH) {
        if (!imgItem || imgItem.status !== Image.Ready || imgItem.implicitWidth <= 0 || imgItem.implicitHeight <= 0) return;
        let iw = imgItem.implicitWidth;
        let ih = imgItem.implicitHeight;
        let sc = Math.max(scrW / iw, scrH / ih);
        let dw = iw * sc;
        let dh = ih * sc;
        let dx = (scrW - dw) * 0.5 - offX;
        let dy = (scrH - dh) * 0.5 - offY;
        ctx.drawImage(imgItem, dx, dy, dw, dh);
    }

    function drawGlobalAeroGlass(ctx, w, h, rad, offX, offY, scrW, scrH, isCircular, drawRim) {
        if (w <= 1 || h <= 1) return;
        ctx.reset();
        ctx.save();

        if (rad > 0) {
            ctx.beginPath();
            ctx.roundedRect(0.5, 0.5, w - 1, h - 1, rad, rad);
            ctx.clip();
        }

        if (root.glassStyle === "aero") {
            // ── OPSI 2: AERO BLIN GLASS (PANTULAN CAHAYA DIAGONAL HALUS, BUKAN GARIS TAJAM) ──
            let op = root.aeroBaseOpacity;
            let bright = root.aeroSheenBright;
            let thick = root.aeroSheenWidth;

            let darkAlpha = Math.min(0.84, 0.08 + op * 0.54);
            ctx.fillStyle = "rgba(14, 16, 26, " + darkAlpha.toFixed(3) + ")";
            ctx.fillRect(0, 0, w, h);

            // Lapisan dasar kaca halus agar menyatu dengan wallpaper
            ctx.fillStyle = "rgba(255, 255, 255, " + (0.015 + bright * 0.035).toFixed(3) + ")";
            ctx.fillRect(0, 0, w, h);

            if (bright > 0.005) {
                if (isCircular) {
                    let radSpread = 0.28 + thick * 0.36;
                    let domeGrad = ctx.createRadialGradient(w * 0.34, h * 0.24, 2, w * 0.48, h * 0.48, w * radSpread);
                    domeGrad.addColorStop(0.0, "rgba(255, 255, 255, " + (0.20 * bright).toFixed(3) + ")");
                    domeGrad.addColorStop(0.55, "rgba(255, 255, 255, " + (0.07 * bright).toFixed(3) + ")");
                    domeGrad.addColorStop(1.0, "rgba(255, 255, 255, 0.0)");
                    ctx.fillStyle = domeGrad;
                    ctx.fillRect(0, 0, w, h);
                } else {
                    // Gradien diagonal lembut bertepi pudar (soft feathered blin) tanpa batas garis keras
                    let peak1 = 0.165 * bright;
                    let peak2 = 0.085 * bright;
                    let c1 = 0.33;
                    let c2 = 0.67;
                    let hw1 = 0.05 + thick * 0.21;
                    let hw2 = 0.035 + thick * 0.13;

                    let blinGrad = ctx.createLinearGradient(0, 0, w * 0.78, h * 0.78);
                    blinGrad.addColorStop(0.0, "rgba(255, 255, 255, 0.0)");
                    blinGrad.addColorStop(Math.max(0.01, c1 - hw1), "rgba(255, 255, 255, 0.0)");
                    blinGrad.addColorStop(Math.max(0.02, c1 - hw1 * 0.45), "rgba(255, 255, 255, " + (peak1 * 0.55).toFixed(3) + ")");
                    blinGrad.addColorStop(c1, "rgba(255, 255, 255, " + peak1.toFixed(3) + ")");
                    blinGrad.addColorStop(Math.min(0.98, c1 + hw1 * 0.45), "rgba(255, 255, 255, " + (peak1 * 0.55).toFixed(3) + ")");
                    blinGrad.addColorStop(Math.min(0.99, c1 + hw1), "rgba(255, 255, 255, 0.0)");

                    if (thick > 0.22 && (c1 + hw1) < (c2 - hw2 * 0.3)) {
                        let s2Start = Math.max(c1 + hw1, c2 - hw2);
                        blinGrad.addColorStop(Math.min(0.97, s2Start), "rgba(255, 255, 255, 0.0)");
                        blinGrad.addColorStop(c2, "rgba(255, 255, 255, " + peak2.toFixed(3) + ")");
                        blinGrad.addColorStop(Math.min(0.99, c2 + hw2), "rgba(255, 255, 255, 0.0)");
                    }

                    blinGrad.addColorStop(1.0, "rgba(255, 255, 255, 0.0)");
                    ctx.fillStyle = blinGrad;
                    ctx.fillRect(0, 0, w, h);
                }
            }

            if (rad > 0) {
                ctx.strokeStyle = "rgba(255, 255, 255, " + (0.15 + bright * 0.24).toFixed(3) + ")";
                ctx.lineWidth = 1.0;
                ctx.beginPath();
                ctx.roundedRect(0.5, 0.5, w - 1.0, h - 1.0, rad, rad);
                ctx.stroke();
            } else if (drawRim) {
                ctx.fillStyle = "rgba(255, 255, 255, " + (0.15 + bright * 0.22).toFixed(3) + ")";
                ctx.fillRect(0, h - 1, w, 1);
            }
        } else if (root.glassStyle === "liquid") {
            // ── OPSI 3: CLEAR LIQUID DROPLET (BENING KRISTAL + BEVEL TIMBUL SEPERTI ZAROUTT/NIRI-GLASS) ──
            let op = root.liquidOpacity;
            let refr = root.liquidRefraction;
            let fringe = root.liquidFringing;

            // Badan sangat bening agar wallpaper di belakangnya tetap jernih & tajam
            let clearAlpha = Math.min(0.28, 0.03 + op * 0.18);
            ctx.fillStyle = "rgba(16, 20, 30, " + clearAlpha.toFixed(3) + ")";
            ctx.fillRect(0, 0, w, h);

            // Kilau cembung atas & bawah (water-droplet inner bevel)
            let dropGrad = ctx.createLinearGradient(0, 0, 0, h);
            dropGrad.addColorStop(0.0, "rgba(255, 255, 255, " + (0.12 + refr * 0.14).toFixed(3) + ")");
            dropGrad.addColorStop(0.18, "rgba(255, 255, 255, 0.02)");
            dropGrad.addColorStop(0.82, "rgba(255, 255, 255, 0.01)");
            dropGrad.addColorStop(1.0, "rgba(235, 248, 255, " + (0.08 + refr * 0.12).toFixed(3) + ")");
            ctx.fillStyle = dropGrad;
            ctx.fillRect(0, 0, w, h);

            if (rad > 0) {
                if (fringe > 0.01) {
                    ctx.strokeStyle = "rgba(110, 215, 255, " + (0.30 * fringe).toFixed(3) + ")";
                    ctx.lineWidth = 1.25;
                    ctx.beginPath();
                    ctx.roundedRect(0.8, 0.8, w - 1.6, h - 1.6, rad, rad);
                    ctx.stroke();

                    ctx.strokeStyle = "rgba(255, 140, 215, " + (0.25 * fringe).toFixed(3) + ")";
                    ctx.lineWidth = 1.1;
                    ctx.beginPath();
                    ctx.roundedRect(1.4, 1.4, w - 2.8, h - 2.8, Math.max(1.0, rad - 0.6), Math.max(1.0, rad - 0.6));
                    ctx.stroke();
                }

                let rimGrad = ctx.createLinearGradient(0, 0, w, h);
                rimGrad.addColorStop(0.0, "rgba(255, 255, 255, " + (0.34 + refr * 0.28).toFixed(3) + ")");
                rimGrad.addColorStop(0.5, "rgba(255, 255, 255, 0.12)");
                rimGrad.addColorStop(1.0, "rgba(240, 250, 255, " + (0.28 + refr * 0.24).toFixed(3) + ")");
                ctx.strokeStyle = rimGrad;
                ctx.lineWidth = 1.2;
                ctx.beginPath();
                ctx.roundedRect(0.5, 0.5, w - 1.0, h - 1.0, rad, rad);
                ctx.stroke();
            } else if (drawRim) {
                ctx.fillStyle = "rgba(255, 255, 255, " + (0.24 + refr * 0.24).toFixed(3) + ")";
                ctx.fillRect(0, h - 1, w, 1);
            }
        } else {
            // ── OPSI 1: CLEAN GLASS (FROST PUTIH RATA HALUS SEPERTI GAMBAR 1) ──
            let op = root.macOpacity;
            let frost = root.macFrost;

            let darkAlpha = Math.min(0.84, 0.09 + op * 0.52);
            ctx.fillStyle = "rgba(14, 16, 24, " + darkAlpha.toFixed(3) + ")";
            ctx.fillRect(0, 0, w, h);

            if (frost > 0.005) {
                ctx.fillStyle = "rgba(255, 255, 255, " + (0.02 + frost * 0.10).toFixed(3) + ")";
                ctx.fillRect(0, 0, w, h);
            }

            if (rad > 0) {
                ctx.strokeStyle = "rgba(255, 255, 255, " + (0.16 + frost * 0.24).toFixed(3) + ")";
                ctx.lineWidth = 1.0;
                ctx.beginPath();
                ctx.roundedRect(0.5, 0.5, w - 1.0, h - 1.0, rad, rad);
                ctx.stroke();
            } else if (drawRim) {
                ctx.fillStyle = "rgba(255, 255, 255, " + (0.16 + frost * 0.22).toFixed(3) + ")";
                ctx.fillRect(0, h - 1, w, 1);
            }
        }

        ctx.restore();
    }
    property string settingsTab: "appearance"
    property string settingsSearch: ""
    property string dockHideMode: "smart" // "smart", "always", "never"
    property string localIpAddr: "127.0.0.1"
    property string powerProfile: "balanced"
    property var sysSpecs: ({
        osName: "Linux",
        kernel: "-",
        hostModel: "ThinkPad",
        userHost: "user@host",
        cpuModel: "AMD Ryzen",
        gpuModel: "AMD Radeon Graphics",
        ramUsed: "0 GiB",
        ramTotal: "0 GiB",
        ramPct: 0,
        diskUsed: "0 GB",
        diskTotal: "0 GB",
        diskPct: 0,
        displayInfo: "1920x1080",
        uptimeStr: "-",
        wmVer: "Niri",
        shellVer: "Quickshell"
    })
    property string copiedBannerMsg: ""
    property var allSystemApps: []
    property string launcherSearchText: ""
    property string queuedPopup: ""
    property bool musicPreviewVisible: false

    Timer {
        id: popupSwitchTimer
        interval: 165
        repeat: false
        onTriggered: {
            root.activePopup = root.queuedPopup;
            root.queuedPopup = "";
            if (root.activePopup === "cc" || root.activePopup === "calendar") {
                sysStatusProc.running = false;
                sysStatusProc.running = true;
            } else if (root.activePopup === "wifi") {
                root.scanWifiNetworks();
            } else if (root.activePopup === "bt") {
                root.scanBtDevices();
            }
        }
    }

    Timer {
        id: deferredPopupRefreshTimer
        interval: 35
        repeat: false
        property string targetPopup: ""
        onTriggered: {
            if (targetPopup === "settings") {
                sysStatusProc.running = false; sysStatusProc.running = true;
                settingsExtraProc.running = false; settingsExtraProc.running = true;
                root.scanWifiNetworks();
                root.scanBtDevices();
            } else if (targetPopup === "about") {
                sysStatusProc.running = false; sysStatusProc.running = true;
            } else if (targetPopup === "control") {
                sysStatusProc.running = false; sysStatusProc.running = true;
            }
        }
    }

    property bool preWarmDone: false
    Timer {
        id: preWarmTimer
        interval: 250
        running: true
        repeat: false
        onTriggered: root.preWarmDone = true
    }

    function switchPopup(name) {
        if (root.activePopup === name) {
            root.closePopups();
            return;
        }
        if (name === "settings") root.settingsSearch = "";
        // Langsung picu tampilan visual pada milidetik ke-0 (zero delay)
        root.activePopup = name;
        if (name !== "") {
            deferredPopupRefreshTimer.targetPopup = name;
            deferredPopupRefreshTimer.restart();
        }
    }

    function closePopups() {
        queuedPopup = "";
        launcherSearchText = "";
        popupSwitchTimer.stop();
        activePopup = "";
        musicPreviewVisible = false;
        wifiPasswordTarget = "";
        wifiStatusMsg = "";
    }

    function formatAppName(rawId) {
        if (!rawId || rawId === "") return "Finder";
        let low = rawId.toLowerCase();
        if (low.includes("nautilus") || low.includes("thunar") || low.includes("dolphin") || low.includes("nemo")) return "Finder";
        if (low.includes("firefox")) return "Firefox";
        if (low.includes("zen")) return "Zen";
        if (low.includes("chrome")) return "Chrome";
        if (low.includes("brave")) return "Brave";
        if (low.includes("alacritty") || low.includes("kitty") || low.includes("foot") || low.includes("wezterm")) return "Terminal";
        if (low.includes("code")) return "VS Code";
        if (low.includes("spotify")) return "Spotify";
        if (low.includes("amberol")) return "Amberol";
        if (low.includes("obsidian")) return "Obsidian";
        if (low.includes("telegram")) return "Telegram";
        if (low.includes("discord") || low.includes("vesktop")) return "Discord";
        if (low.includes("gnome-control-center")) return "Settings";
        let parts = rawId.split(".");
        let last = parts[parts.length - 1];
        return last.charAt(0).toUpperCase() + last.slice(1);
    }

    function pickRandomWallpaper() {
        if (wallpaperList.length === 0) return;
        if (wallpaperList.length === 1) {
            currentWallpaper = wallpaperList[0];
            return;
        }
        let next = currentWallpaper;
        let tries = 0;
        while (next === currentWallpaper && tries < 8) {
            next = wallpaperList[Math.floor(Math.random() * wallpaperList.length)];
            tries++;
        }
        currentWallpaper = next;
    }

    // ── Dedicated Process Runners ───────────────────────────────────────
    Process { id: actionProc }
    Process { id: briProc }
    Process { id: volProc }
    Process { id: wifiToggleProc }
    Process { id: btToggleProc }
    Process { id: awakeProc }
    Process { id: dndProc }

    function runCmd(cmd) {
        if (!cmd || cmd.trim() === "") return;
        let clean = cmd.replace(/%[fFuUdDnNickvm]/g, "").trim();
        Quickshell.execDetached(["sh", "-c", "setsid -f " + clean + " >/dev/null 2>&1 || (" + clean + " &)"]);
    }

    function setBrightnessPct(pct) {
        let clamped = Math.max(5, Math.min(100, Math.round(pct)));
        root.brightnessLevel = clamped;
        briProc.running = false;
        briProc.command = ["sh", "-c", "max=$(cat /sys/class/backlight/amdgpu_bl1/max_brightness 2>/dev/null || echo 255); val=$(( " + clamped + " * max / 100 )); if [ -w /sys/class/backlight/amdgpu_bl1/brightness ]; then echo $val > /sys/class/backlight/amdgpu_bl1/brightness; else gdbus call --system --dest org.freedesktop.login1 --object-path /org/freedesktop/login1/session/auto --method org.freedesktop.login1.Session.SetBrightness backlight amdgpu_bl1 $val >/dev/null 2>&1; fi"];
        briProc.running = true;
    }

    function setVolumePct(pct) {
        let clamped = Math.max(0, Math.min(100, Math.round(pct)));
        root.volumeLevel = clamped;
        root.volumeMuted = (clamped === 0);
        volProc.running = false;
        volProc.command = ["sh", "-c", "wpctl set-mute @DEFAULT_AUDIO_SINK@ 0 && wpctl set-volume @DEFAULT_AUDIO_SINK@ " + (clamped / 100).toFixed(2)];
        volProc.running = true;
    }

    function toggleMute() {
        root.volumeMuted = !root.volumeMuted;
        volProc.running = false;
        volProc.command = ["sh", "-c", "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"];
        volProc.running = true;
    }

    function toggleWifi() {
        let next = !root.wifiEnabled;
        root.wifiEnabled = next;
        if (!next) {
            root.wifiConnected = false;
            root.wifiName = "Mati";
            root.wifiNetworks = [];
        } else {
            root.wifiName = "Menghubungkan...";
        }
        wifiToggleProc.running = false;
        wifiToggleProc.command = ["sh", "-c", "LC_ALL=C nmcli radio wifi " + (next ? "on" : "off")];
        wifiToggleProc.running = true;
        refreshTimer.restart();
        if (next && root.activePopup === "wifi") {
            wifiRescanDelay.restart();
        }
    }

    function toggleBluetooth() {
        let next = !root.btEnabled;
        root.btEnabled = next;
        if (!next) {
            root.btDeviceName = "";
            root.btDevices = [];
        }
        btToggleProc.running = false;
        btToggleProc.command = ["sh", "-c", next ? "rfkill unblock bluetooth; LC_ALL=C bluetoothctl power on" : "LC_ALL=C bluetoothctl power off"];
        btToggleProc.running = true;
        refreshTimer.restart();
        if (next && root.activePopup === "bt") {
            btRescanDelay.restart();
        }
    }

    function toggleKeepAwake() {
        let next = !root.keepAwake;
        root.keepAwake = next;
        awakeProc.running = false;
        if (next) {
            awakeProc.command = ["sh", "-c", "systemd-inhibit --what=idle:sleep --who=Quickshell --reason=KeepAwake sleep infinity >/dev/null 2>&1 & echo $! > /tmp/qs-inhibit.pid"];
        } else {
            awakeProc.command = ["sh", "-c", "kill $(cat /tmp/qs-inhibit.pid 2>/dev/null) 2>/dev/null; rm -f /tmp/qs-inhibit.pid"];
        }
        awakeProc.running = true;
    }

    function toggleDnd() {
        let next = !root.dndEnabled;
        root.dndEnabled = next;
        dndProc.running = false;
        dndProc.command = ["sh", "-c", "command -v makoctl >/dev/null && makoctl mode " + (next ? "-a do-not-disturb" : "-r do-not-disturb") + "; command -v swaync-client >/dev/null && swaync-client -d " + (next ? "true" : "false") + "; true"];
        dndProc.running = true;
    }

    // ── Scanner Wi-Fi Sekitar & Koneksi ─────────────────────────────────
    function scanWifiNetworks() {
        if (!root.wifiEnabled) return;
        root.wifiScanning = true;
        wifiListProc.running = false;
        wifiListProc.running = true;
    }

    function connectWifi(ssid, password) {
        root.wifiStatusMsg = "Menghubungkan ke " + ssid + "...";
        wifiConnectProc.running = false;
        if (password && password.length > 0) {
            wifiConnectProc.command = ["sh", "-c", "LC_ALL=C nmcli dev wifi connect \"$1\" password \"$2\" 2>&1", "sh", ssid, password];
        } else {
            wifiConnectProc.command = ["sh", "-c", "LC_ALL=C nmcli dev wifi connect \"$1\" 2>&1", "sh", ssid];
        }
        wifiConnectProc.running = true;
    }

    Process {
        id: wifiListProc
        command: ["sh", "-c", "LC_ALL=C nmcli -t -f IN-USE,SSID,SIGNAL,SECURITY dev wifi list --rescan auto 2>/dev/null | awk -F: 'NF>=4 && $2!=\"\" { if (!seen[$2]++ || $1==\"*\") { gsub(/\\|/, \"-\", $2); data[$2]=($1==\"*\"?\"1\":\"0\")\"|\"$2\"|\"$3\"|\"$4 } } END { for (k in data) print data[k] }' | sort -t'|' -k1,1r -k3,3nr | head -n 10"]
        stdout: StdioCollector {
            onStreamFinished: {
                root.wifiScanning = false;
                let lines = text.trim().split("\n").filter(l => l.length > 0);
                let arr = [];
                for (let i = 0; i < lines.length; i++) {
                    let p = lines[i].split("|");
                    if (p.length >= 4) {
                        arr.push({
                            connected: p[0] === "1",
                            ssid: p[1],
                            signal: parseInt(p[2]) || 0,
                            secured: p[3] !== "" && p[3] !== "--"
                        });
                    }
                }
                root.wifiNetworks = arr;
            }
        }
    }

    Process {
        id: wifiConnectProc
        stdout: StdioCollector {
            onStreamFinished: {
                let out = text.trim();
                if (out.toLowerCase().includes("successfully activated") || out.toLowerCase().includes("berhasil")) {
                    root.wifiPasswordTarget = "";
                    root.wifiStatusMsg = "Terhubung";
                    sysStatusProc.running = false;
                    sysStatusProc.running = true;
                    wifiRescanDelay.restart();
                } else {
                    root.wifiStatusMsg = "Perlu kata sandi atau gagal";
                }
            }
        }
    }

    Timer {
        id: wifiRescanDelay
        interval: 1500
        repeat: false
        onTriggered: root.scanWifiNetworks()
    }

    // ── Scanner Bluetooth Tersedia & Koneksi ────────────────────────────
    function scanBtDevices() {
        if (!root.btEnabled) return;
        root.btScanning = true;
        btListProc.running = false;
        btListProc.running = true;
    }

    function toggleBtDevice(mac, currentlyConnected) {
        root.btBusyMac = mac;
        btDevActionProc.running = false;
        btDevActionProc.command = ["sh", "-c", "LC_ALL=C bluetoothctl " + (currentlyConnected ? "disconnect " : "connect ") + mac + " >/dev/null 2>&1"];
        btDevActionProc.running = true;
    }

    Process {
        id: btListProc
        command: ["sh", "-c", "LC_ALL=C; timeout 3 bluetoothctl scan on >/dev/null 2>&1 & bluetoothctl devices 2>/dev/null | while read -r _ mac name; do [ -z \"$mac\" ] && continue; info=$(bluetoothctl info \"$mac\" 2>/dev/null); conn=$(echo \"$info\" | grep -q 'Connected: yes' && echo 1 || echo 0); pair=$(echo \"$info\" | grep -q 'Paired: yes' && echo 1 || echo 0); printf '%s|%s|%s|%s\\n' \"$conn\" \"$pair\" \"$mac\" \"$name\"; done | sort -t'|' -k1,1r -k2,2r | head -n 10"]
        stdout: StdioCollector {
            onStreamFinished: {
                root.btScanning = false;
                let lines = text.trim().split("\n").filter(l => l.length > 0);
                let arr = [];
                for (let i = 0; i < lines.length; i++) {
                    let p = lines[i].split("|");
                    if (p.length >= 4) {
                        arr.push({
                            connected: p[0] === "1",
                            paired: p[1] === "1",
                            mac: p[2],
                            name: p[3] || p[2]
                        });
                    }
                }
                root.btDevices = arr;
            }
        }
    }

    Process {
        id: btDevActionProc
        onExited: {
            root.btBusyMac = "";
            sysStatusProc.running = false;
            sysStatusProc.running = true;
            btRescanDelay.restart();
        }
    }

    Timer {
        id: btRescanDelay
        interval: 1200
        repeat: false
        onTriggered: root.scanBtDevices()
    }

    // ── Proses Pembaca Status Latar Belakang (LC_ALL=C) ─────────────────
    Process {
        id: scanWallProc
        command: ["sh", "-c", "find \"$HOME/Pictures/Wallpapers\" -type f \\( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \\) | sort"]
        stdout: StdioCollector {
            onStreamFinished: {
                let lines = text.trim().split("\n").filter(l => l.length > 0);
                root.wallpaperList = lines.map(p => "file://" + p);
                if (root.wallpaperList.length > 0 && root.currentWallpaper === "") {
                    root.pickRandomWallpaper();
                }
            }
        }
    }

    Process {
        id: niriStateProc
        command: ["sh", "-c", "printf 'FOCUS:'; niri msg -j focused-window 2>/dev/null || echo 'null'; printf '\nWS:'; niri msg -j workspaces 2>/dev/null || echo '[]'; printf '\nWINS:'; niri msg -j windows 2>/dev/null || echo '[]'"]
        stdout: StdioCollector {
            onStreamFinished: {
                let lines = text.trim().split("\n");
                let activeWsId = -1;
                let hasFocusedWin = false;
                for (let i = 0; i < lines.length; i++) {
                    if (lines[i].startsWith("FOCUS:")) {
                        try {
                            let fw = JSON.parse(lines[i].slice(6));
                            hasFocusedWin = !!(fw && fw.id);
                            root.focusedAppName = (fw && fw.app_id) ? root.formatAppName(fw.app_id) : "Finder";
                        } catch (e) {
                            root.focusedAppName = "Finder";
                        }
                    } else if (lines[i].startsWith("WS:")) {
                        try {
                            let wss = JSON.parse(lines[i].slice(3));
                            if (Array.isArray(wss)) {
                                for (let k = 0; k < wss.length; k++) {
                                    if (wss[k].is_focused || wss[k].is_active) {
                                        activeWsId = wss[k].id;
                                        break;
                                    }
                                }
                            }
                        } catch (e) {}
                    } else if (lines[i].startsWith("WINS:")) {
                        try {
                            let ws = JSON.parse(lines[i].slice(5));
                            if (Array.isArray(ws)) {
                                root.runningWindows = ws;
                                if (activeWsId >= 0) {
                                    let found = false;
                                    for (let j = 0; j < ws.length; j++) {
                                        if (ws[j].workspace_id === activeWsId) {
                                            found = true;
                                            break;
                                        }
                                    }
                                    root.hasWindowOnActiveWs = found;
                                } else {
                                    root.hasWindowOnActiveWs = hasFocusedWin || ws.length > 0;
                                }
                            }
                        } catch (e) {}
                    }
                }
            }
        }
    }

    Process {
        id: sysStatusProc
        command: ["sh", "-c", "export LC_ALL=C; wifi_rad=$(nmcli radio wifi 2>/dev/null | tr -d '[:space:]'); wifi_ssid=$(nmcli -t -f active,ssid dev wifi 2>/dev/null | awk -F: '$1==\"yes\"{print $2; exit}'); bt_on=$(bluetoothctl show 2>/dev/null | grep -q 'Powered: yes' && echo 1 || echo 0); bt_dev=$(bluetoothctl devices Connected 2>/dev/null | head -n1 | cut -d' ' -f3-); vol_raw=$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null); vol=$(echo \"$vol_raw\" | awk '{print int($2*100+0.5)}'); muted=$(echo \"$vol_raw\" | grep -q 'MUTED' && echo 1 || echo 0); cur_b=$(cat /sys/class/backlight/amdgpu_bl1/brightness 2>/dev/null || echo 0); max_b=$(cat /sys/class/backlight/amdgpu_bl1/max_brightness 2>/dev/null || echo 255); bri=$(( max_b > 0 ? (cur_b * 100 + max_b / 2) / max_b : 80 )); bat_c=$(cat /sys/class/power_supply/BAT0/capacity 2>/dev/null || echo -1); bat_s=$(cat /sys/class/power_supply/BAT0/status 2>/dev/null || echo ''); awake=$([ -f /tmp/qs-inhibit.pid ] && kill -0 $(cat /tmp/qs-inhibit.pid 2>/dev/null) 2>/dev/null && echo 1 || echo 0); printf '%s|%s|%s|%s|%s|%s|%s|%s|%s|%s\\n' \"$wifi_rad\" \"$wifi_ssid\" \"$bt_on\" \"$bt_dev\" \"$vol\" \"$muted\" \"$bri\" \"$bat_c\" \"$bat_s\" \"$awake\""]
        stdout: StdioCollector {
            onStreamFinished: {
                let p = text.trim().split("|");
                if (p.length >= 10) {
                    root.wifiEnabled = (p[0] === "enabled");
                    root.wifiConnected = (p[1].length > 0);
                    root.wifiName = p[1].length > 0 ? p[1] : (root.wifiEnabled ? "Tidak Terhubung" : "Mati");
                    root.btEnabled = (p[2] === "1");
                    root.btDeviceName = p[3];
                    if (!isNaN(parseInt(p[4]))) root.volumeLevel = Math.max(0, Math.min(100, parseInt(p[4])));
                    root.volumeMuted = (p[5] === "1");
                    if (!isNaN(parseInt(p[6]))) root.brightnessLevel = Math.max(5, Math.min(100, parseInt(p[6])));
                    if (!isNaN(parseInt(p[7]))) root.batteryPercent = parseInt(p[7]);
                    root.batteryStatus = p[8];
                    root.keepAwake = (p[9] === "1");
                }
            }
        }
    }

    Timer {
        id: refreshTimer
        interval: 1600
        repeat: false
        onTriggered: {
            sysStatusProc.running = false;
            sysStatusProc.running = true;
        }
    }

    Timer {
        id: screenshotDelayTimer
        interval: 220
        repeat: false
        onTriggered: root.runCmd("niri msg action screenshot")
    }

    Component.onCompleted: {
        scanWallProc.running = true;
        niriStateProc.running = true;
        sysStatusProc.running = true;
    }

    Timer {
        interval: 260
        running: true
        repeat: true
        onTriggered: niriStateProc.running = true
    }

    Timer {
        interval: 4000
        running: true
        repeat: true
        onTriggered: sysStatusProc.running = true
    }

    Timer {
        interval: 15 * 60 * 1000
        running: true
        repeat: true
        onTriggered: root.pickRandomWallpaper()
    }

    IpcHandler {
        target: "wallpaper"
        function next(): void { root.pickRandomWallpaper(); }
    }

    IpcHandler {
        target: "widget"
        function edit(): void { win.editMode = !win.editMode; }
        function reset(): void { win.resetLayout(); }
        function set(x: real, y: real, scale: real): void {
            win.widgetScale = Math.max(0.55, Math.min(1.8, scale));
            win.posX = Math.max(0, x);
            win.posY = Math.max(36, y);
            win.saveLayout();
        }
    }

    // 1. FULLSCREEN WALLPAPER DENGAN 18 SHADER ANIMASI IRIS
    PanelWindow {
        id: bgWin
        WlrLayershell.layer: WlrLayer.Background
        WlrLayershell.namespace: "iris-wallpaper"
        exclusionMode: ExclusionMode.Ignore

        anchors { top: true; bottom: true; left: true; right: true }
        color: "#000000"

        WallpaperCrossfader {
            anchors.fill: parent
            source: root.currentWallpaper
            transitionType: "shaderRandom"
            transitionBaseDuration: 950
        }
    }

    // 2. MACOS TOP MENU BAR (SMOOTH STAGGERED ENTRANCE + SPRING HOVER)
    PanelWindow {
        id: topBar
        WlrLayershell.layer: WlrLayer.Top
        WlrLayershell.namespace: "macos-menubar"
        exclusionMode: ExclusionMode.Auto

        anchors { top: true; left: true; right: true }
        implicitHeight: 28
        color: "transparent"

        property string dateTimeStr: ""
        property var mediaPlayer: Mpris.players.values.length > 0 ? Mpris.players.values[0] : null

        function updateClock() {
            let d = new Date();
            let days = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];
            let months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
            let hr = d.getHours();
            let ampm = hr >= 12 ? "PM" : "AM";
            hr = hr % 12;
            if (hr === 0) hr = 12;
            let min = d.getMinutes();
            let minStr = min < 10 ? "0" + min : "" + min;
            dateTimeStr = days[d.getDay()] + " " + months[d.getMonth()] + " " + d.getDate() + "  " + hr + ":" + minStr + " " + ampm;
        }

        Component.onCompleted: updateClock()

        Timer {
            interval: 1000
            running: true
            repeat: true
            onTriggered: topBar.updateClock()
        }

        Rectangle {
            id: topBarSurface
            anchors.fill: parent
            color: "#8A141418"
            opacity: root.bootStage >= 1 ? 1.0 : 0.0
            transform: Translate {
                y: root.bootStage >= 1 ? 0 : -28
                Behavior on y { SpringAnimation { spring: 7.5; damping: 0.72 } }
            }
            Behavior on opacity { NumberAnimation { duration: 145; easing.type: Easing.InOutCubic } }

            Rectangle {
                anchors.bottom: parent.bottom
                anchors.left: parent.left
                anchors.right: parent.right
                height: 1
                color: "#1FFFFFFF"
            }

            // ZONA KIRI
            Row {
                anchors.left: parent.left
                anchors.leftMargin: 10
                anchors.verticalCenter: parent.verticalCenter
                spacing: 4

                Rectangle {
                    width: 28
                    height: 22
                    radius: 6
                    color: (root.activePopup === "apple" || logoM.containsMouse) ? "#2EFFFFFF" : "transparent"
                    scale: logoM.pressed ? 0.92 : (logoM.containsMouse ? 1.05 : 1.0)
                    Behavior on color { ColorAnimation { duration: 60 } }
                    Behavior on scale { SpringAnimation { spring: 7.5; damping: 0.72 } }

                    Canvas {
                        anchors.centerIn: parent
                        width: 14
                        height: 14
                        onPaint: {
                            let ctx = getContext("2d");
                            ctx.reset();
                            ctx.fillStyle = "#F5F5F7";
                            ctx.beginPath();
                            ctx.arc(7, 8.6, 4.6, 0, Math.PI * 2);
                            ctx.fill();
                            ctx.fillStyle = "#18181E";
                            ctx.beginPath();
                            ctx.arc(11.4, 7.8, 2.2, 0, Math.PI * 2);
                            ctx.fill();
                            ctx.fillStyle = "#F5F5F7";
                            ctx.beginPath();
                            ctx.ellipse(7.2, 1.3, 2.4, 1.3, -0.6, 0, Math.PI * 2);
                            ctx.fill();
                        }
                    }

                    MouseArea {
                        id: logoM
                        anchors.fill: parent
                        hoverEnabled: true
                        cursorShape: Qt.PointingHandCursor
                        onPressed: root.switchPopup("apple")
                    }
                }

                Rectangle {
                    height: 22
                    width: appTitleTxt.implicitWidth + 12
                    radius: 6
                    color: "transparent"

                    Text {
                        id: appTitleTxt
                        anchors.centerIn: parent
                        text: root.focusedAppName
                        color: "#FFFFFF"
                        font.pixelSize: 13
                        font.weight: Font.Bold
                    }
                }

                Rectangle {
                    height: 22
                    width: winMenuTxt.implicitWidth + 14
                    radius: 6
                    color: (root.activePopup === "window" || winMenuM.containsMouse) ? "#2EFFFFFF" : "transparent"
                    scale: winMenuM.pressed ? 0.94 : (winMenuM.containsMouse ? 1.03 : 1.0)
                    Behavior on color { ColorAnimation { duration: 60 } }
                    Behavior on scale { SpringAnimation { spring: 7.5; damping: 0.72 } }

                    Text {
                        id: winMenuTxt
                        anchors.centerIn: parent
                        text: "Window"
                        color: "#E5F5F7"
                        font.pixelSize: 13
                    }

                    MouseArea {
                        id: winMenuM
                        anchors.fill: parent
                        hoverEnabled: true
                        cursorShape: Qt.PointingHandCursor
                        onPressed: root.switchPopup("window")
                    }
                }

                Rectangle {
                    height: 22
                    width: deskMenuTxt.implicitWidth + 14
                    radius: 6
                    color: (root.activePopup === "desktop" || deskMenuM.containsMouse) ? "#2EFFFFFF" : "transparent"
                    scale: deskMenuM.pressed ? 0.94 : (deskMenuM.containsMouse ? 1.03 : 1.0)
                    Behavior on color { ColorAnimation { duration: 60 } }
                    Behavior on scale { SpringAnimation { spring: 7.5; damping: 0.72 } }

                    Text {
                        id: deskMenuTxt
                        anchors.centerIn: parent
                        text: "Desktop"
                        color: "#E5F5F7"
                        font.pixelSize: 13
                    }

                    MouseArea {
                        id: deskMenuM
                        anchors.fill: parent
                        hoverEnabled: true
                        cursorShape: Qt.PointingHandCursor
                        onPressed: root.switchPopup("desktop")
                    }
                }
            }

            // ZONA TENGAH: MUSIC PLAYER PILL
            Timer {
                id: musicHoverOpenTimer
                interval: 160
                repeat: false
                onTriggered: {
                    if (root.activePopup !== "music") {
                        root.musicPreviewVisible = true;
                    }
                }
            }

            Timer {
                id: musicPreviewCloseTimer
                interval: 260
                repeat: false
                onTriggered: {
                    if (!npPillM.containsMouse && !musicPreviewHover.hovered) {
                        root.musicPreviewVisible = false;
                    }
                }
            }

            Rectangle {
                id: centerMusicPill
                anchors.centerIn: parent
                height: 21
                width: Math.min(276, nowPlayingRow.implicitWidth + 20)
                radius: 10.5
                color: (root.activePopup === "music" || root.musicPreviewVisible || npPillM.containsMouse) ? "#38FFFFFF" : "#22FFFFFF"
                border.width: 1
                border.color: (root.activePopup === "music" || root.musicPreviewVisible) ? "#55A1C6FF" : "#28FFFFFF"
                scale: npPillM.pressed ? 0.95 : (npPillM.containsMouse ? 1.03 : 1.0)

                Behavior on color { ColorAnimation { duration: 60 } }
                Behavior on border.color { ColorAnimation { duration: 180 } }
                Behavior on scale { SpringAnimation { spring: 7.5; damping: 0.72 } }
                Behavior on width { NumberAnimation { duration: 145; easing.type: Easing.InOutCubic } }

                Row {
                    id: nowPlayingRow
                    anchors.centerIn: parent
                    spacing: 6

                    Rectangle {
                        anchors.verticalCenter: parent.verticalCenter
                        width: 14
                        height: 14
                        radius: 7
                        color: (topBar.mediaPlayer && topBar.mediaPlayer.isPlaying) ? "#32D74B" : "#A1C6FF"
                        Behavior on color { ColorAnimation { duration: 220 } }

                        Text {
                            anchors.centerIn: parent
                            text: "♫"
                            color: "#141418"
                            font.pixelSize: 9
                            font.bold: true
                        }
                    }

                    Text {
                        anchors.verticalCenter: parent.verticalCenter
                        text: (topBar.mediaPlayer && topBar.mediaPlayer.trackTitle !== "")
                              ? topBar.mediaPlayer.trackTitle : "Music"
                        color: "#F5F5F7"
                        font.pixelSize: 11
                        font.weight: Font.Medium
                        elide: Text.ElideRight
                        maximumLineCount: 1
                        width: Math.min(205, implicitWidth)
                    }

                    Text {
                        anchors.verticalCenter: parent.verticalCenter
                        text: (root.activePopup === "music" || root.musicPreviewVisible) ? "▴" : "▾"
                        color: "#AEAEB2"
                        font.pixelSize: 9
                    }
                }

                MouseArea {
                    id: npPillM
                    anchors.fill: parent
                    hoverEnabled: true
                    cursorShape: Qt.PointingHandCursor
                    onEntered: {
                        musicPreviewCloseTimer.stop();
                        if (root.activePopup !== "music") {
                            musicHoverOpenTimer.restart();
                        }
                    }
                    onExited: {
                        musicHoverOpenTimer.stop();
                        musicPreviewCloseTimer.restart();
                    }
                    onClicked: {
                        musicHoverOpenTimer.stop();
                        root.musicPreviewVisible = false;
                        root.switchPopup("music");
                    }
                }
            }

            // ZONA KANAN
            Row {
                anchors.right: parent.right
                anchors.rightMargin: 10
                anchors.verticalCenter: parent.verticalCenter
                spacing: 4

                Rectangle {
                    height: 22
                    width: batRow.implicitWidth + 10
                    radius: 6
                    color: "transparent"
                    visible: root.batteryPercent >= 0

                    Row {
                        id: batRow
                        anchors.centerIn: parent
                        spacing: 4

                        Text {
                            anchors.verticalCenter: parent.verticalCenter
                            text: root.batteryPercent + "%"
                            color: "#E5F5F7"
                            font.pixelSize: 11
                            font.weight: Font.Medium
                        }

                        Item {
                            anchors.verticalCenter: parent.verticalCenter
                            width: 22
                            height: 11

                            Rectangle {
                                anchors.left: parent.left
                                anchors.verticalCenter: parent.verticalCenter
                                width: 19
                                height: 11
                                radius: 3
                                color: "transparent"
                                border.width: 1
                                border.color: "#AAF5F5F7"

                                Rectangle {
                                    anchors.left: parent.left
                                    anchors.leftMargin: 2
                                    anchors.verticalCenter: parent.verticalCenter
                                    width: Math.max(2, Math.round(15 * (root.batteryPercent / 100)))
                                    height: 7
                                    radius: 1.5
                                    color: root.batteryStatus === "Charging" ? "#32D74B"
                                         : (root.batteryPercent <= 20 ? "#FF453A" : "#F5F5F7")
                                }
                            }

                            Rectangle {
                                anchors.right: parent.right
                                anchors.verticalCenter: parent.verticalCenter
                                width: 2
                                height: 4
                                radius: 1
                                color: "#AAF5F5F7"
                            }
                        }
                    }
                }

                Rectangle {
                    width: 26
                    height: 22
                    radius: 6
                    color: (root.activePopup === "wifi" || wifiTopM.containsMouse) ? "#2EFFFFFF" : "transparent"
                    scale: wifiTopM.pressed ? 0.92 : (wifiTopM.containsMouse ? 1.05 : 1.0)
                    Behavior on color { ColorAnimation { duration: 60 } }
                    Behavior on scale { SpringAnimation { spring: 7.5; damping: 0.72 } }

                    Canvas {
                        id: topWifiCanvas
                        anchors.centerIn: parent
                        width: 16
                        height: 14
                        property bool active: root.wifiConnected
                        onActiveChanged: requestPaint()
                        onPaint: {
                            let ctx = getContext("2d");
                            ctx.reset();
                            ctx.strokeStyle = active ? "#F5F5F7" : "#66F5F5F7";
                            ctx.lineWidth = 1.5;
                            ctx.lineCap = "round";
                            for (let r = 3; r <= 9; r += 3) {
                                ctx.beginPath();
                                ctx.arc(8, 11.5, r, -Math.PI * 0.78, -Math.PI * 0.22);
                                ctx.stroke();
                            }
                            ctx.fillStyle = active ? "#F5F5F7" : "#66F5F5F7";
                            ctx.beginPath();
                            ctx.arc(8, 11.8, 1.3, 0, Math.PI * 2);
                            ctx.fill();
                        }
                    }

                    MouseArea {
                        id: wifiTopM
                        anchors.fill: parent
                        hoverEnabled: true
                        acceptedButtons: Qt.LeftButton | Qt.RightButton
                        cursorShape: Qt.PointingHandCursor
                        onClicked: (mouse) => {
                            if (mouse.button === Qt.RightButton) root.switchPopup("wifi");
                            else root.switchPopup("cc");
                        }
                    }
                }

                Rectangle {
                    width: 26
                    height: 22
                    radius: 6
                    color: spotM.containsMouse ? "#2EFFFFFF" : "transparent"
                    scale: spotM.pressed ? 0.92 : (spotM.containsMouse ? 1.05 : 1.0)
                    Behavior on color { ColorAnimation { duration: 60 } }
                    Behavior on scale { SpringAnimation { spring: 7.5; damping: 0.72 } }

                    Canvas {
                        anchors.centerIn: parent
                        width: 14
                        height: 14
                        onPaint: {
                            let ctx = getContext("2d");
                            ctx.reset();
                            ctx.strokeStyle = "#F5F5F7";
                            ctx.lineWidth = 1.6;
                            ctx.lineCap = "round";
                            ctx.beginPath();
                            ctx.arc(6, 6, 4.2, 0, Math.PI * 2);
                            ctx.stroke();
                            ctx.beginPath();
                            ctx.moveTo(9.2, 9.2);
                            ctx.lineTo(12.5, 12.5);
                            ctx.stroke();
                        }
                    }

                    MouseArea {
                        id: spotM
                        anchors.fill: parent
                        hoverEnabled: true
                        cursorShape: Qt.PointingHandCursor
                        onPressed: root.switchPopup("spotlight")
                    }
                }

                Rectangle {
                    width: 28
                    height: 22
                    radius: 6
                    color: (root.activePopup === "cc" || ccTopM.containsMouse) ? "#34FFFFFF" : "transparent"
                    scale: ccTopM.pressed ? 0.92 : (ccTopM.containsMouse ? 1.05 : 1.0)
                    Behavior on color { ColorAnimation { duration: 60 } }
                    Behavior on scale { SpringAnimation { spring: 7.5; damping: 0.72 } }

                    Canvas {
                        anchors.centerIn: parent
                        width: 16
                        height: 14
                        onPaint: {
                            let ctx = getContext("2d");
                            ctx.reset();
                            ctx.strokeStyle = "#F5F5F7";
                            ctx.fillStyle = "#F5F5F7";
                            ctx.lineWidth = 1.2;
                            ctx.beginPath();
                            ctx.roundedRect(2, 2, 12, 4, 2, 2);
                            ctx.stroke();
                            ctx.beginPath();
                            ctx.arc(11.5, 4, 1.5, 0, Math.PI * 2);
                            ctx.fill();
                            ctx.beginPath();
                            ctx.roundedRect(2, 8, 12, 4, 2, 2);
                            ctx.stroke();
                            ctx.beginPath();
                            ctx.arc(4.5, 10, 1.5, 0, Math.PI * 2);
                            ctx.fill();
                        }
                    }

                    MouseArea {
                        id: ccTopM
                        anchors.fill: parent
                        hoverEnabled: true
                        cursorShape: Qt.PointingHandCursor
                        onPressed: root.switchPopup("cc")
                    }
                }

                Rectangle {
                    height: 22
                    width: clockTxt.implicitWidth + 12
                    radius: 6
                    color: (root.activePopup === "calendar" || clockTopM.containsMouse) ? "#2EFFFFFF" : "transparent"
                    scale: clockTopM.pressed ? 0.94 : (clockTopM.containsMouse ? 1.03 : 1.0)
                    Behavior on color { ColorAnimation { duration: 60 } }
                    Behavior on scale { SpringAnimation { spring: 7.5; damping: 0.72 } }

                    Text {
                        id: clockTxt
                        anchors.centerIn: parent
                        text: topBar.dateTimeStr
                        color: "#F5F5F7"
                        font.pixelSize: 13
                        font.weight: Font.Medium
                    }

                    MouseArea {
                        id: clockTopM
                        anchors.fill: parent
                        hoverEnabled: true
                        cursorShape: Qt.PointingHandCursor
                        onPressed: root.switchPopup("calendar")
                    }
                }
            }
        }
    }

    // 3. POPUP HOVER PREVIEW MUSIC PLAYER (TENGAH ATAS TANPA KLIK)
    PanelWindow {
        id: musicPreviewWin
        WlrLayershell.layer: WlrLayer.Overlay
        WlrLayershell.namespace: "macos-music-preview"
        exclusionMode: ExclusionMode.Ignore
        visible: (root.musicPreviewVisible && root.activePopup !== "music") || musicPreviewCard.opacity > 0.01

        anchors { top: true }
        margins { top: 32 }
        implicitWidth: 286
        implicitHeight: 82
        color: "transparent"

        property var mediaPlayer: Mpris.players.values.length > 0 ? Mpris.players.values[0] : null

        HoverHandler {
            id: musicPreviewHover
            onHoveredChanged: {
                if (hovered) musicPreviewCloseTimer.stop();
                else musicPreviewCloseTimer.restart();
            }
        }

        Rectangle {
            id: musicPreviewCard
            anchors.horizontalCenter: parent.horizontalCenter
            width: 278
            height: 72
            radius: 18
            color: "#EB18181E"
            border.width: 1
            border.color: "#38FFFFFF"

            property bool isOpen: root.musicPreviewVisible && root.activePopup !== "music"
            opacity: isOpen ? 1.0 : 0.0
            scale: isOpen ? 1.0 : 0.90
            y: isOpen ? 0 : -10
            transformOrigin: Item.Top

            Behavior on opacity { NumberAnimation { duration: 420; easing.type: Easing.InOutCubic } }
            Behavior on scale { SpringAnimation { spring: 7.5; damping: 0.72 } }
            Behavior on y { SpringAnimation { spring: 7.5; damping: 0.72 } }

            Row {
                anchors.fill: parent
                anchors.margins: 10
                spacing: 10

                Rectangle {
                    width: 52; height: 52; radius: 12
                    color: "#2A2A32"; clip: true

                    Image {
                        id: prevArt
                        anchors.fill: parent
                        source: musicPreviewWin.mediaPlayer ? musicPreviewWin.mediaPlayer.trackArtUrl : ""
                        fillMode: Image.PreserveAspectCrop
                        visible: status === Image.Ready
                    }

                    Text {
                        anchors.centerIn: parent
                        text: "♫"
                        color: "#A1C6FF"
                        font.pixelSize: 20
                        visible: prevArt.status !== Image.Ready
                    }
                }

                Column {
                    anchors.verticalCenter: parent.verticalCenter
                    width: 192
                    spacing: 3

                    Text {
                        width: 192
                        text: (musicPreviewWin.mediaPlayer && musicPreviewWin.mediaPlayer.trackTitle)
                              ? musicPreviewWin.mediaPlayer.trackTitle : "Tidak Ada Pemutar Aktif"
                        color: "#F5F5F7"
                        font.pixelSize: 12
                        font.bold: true
                        elide: Text.ElideRight
                    }

                    Text {
                        width: 192
                        text: (musicPreviewWin.mediaPlayer && musicPreviewWin.mediaPlayer.trackArtist)
                              ? musicPreviewWin.mediaPlayer.trackArtist : "Klik kapsul untuk membuka kontrol"
                        color: "#AEAEB2"
                        font.pixelSize: 10
                        elide: Text.ElideRight
                    }

                    Rectangle {
                        width: 192
                        height: 3
                        radius: 1.5
                        color: "#28FFFFFF"

                        Rectangle {
                            width: {
                                let _ = win.tick;
                                return (musicPreviewWin.mediaPlayer && musicPreviewWin.mediaPlayer.length > 0)
                                    ? Math.min(192, 192 * (musicPreviewWin.mediaPlayer.position / musicPreviewWin.mediaPlayer.length)) : 0;
                            }
                            height: 3
                            radius: 1.5
                            color: "#A1C6FF"
                            Behavior on width { NumberAnimation { duration: 145; easing.type: Easing.InOutCubic } }
                        }
                    }
                }
            }

            MouseArea {
                anchors.fill: parent
                cursorShape: Qt.PointingHandCursor
                onClicked: {
                    root.musicPreviewVisible = false;
                    root.switchPopup("music");
                }
            }
        }
    }

    // 4. OVERLAY UNIFIED UNTUK SEMUA POPUP + BACKDROP PENUTUP
    PanelWindow {
        id: popupOverlayWin
        WlrLayershell.layer: WlrLayer.Overlay
        WlrLayershell.namespace: "macos-popups-overlay"
        WlrLayershell.keyboardFocus: (root.wifiPasswordTarget !== "" || root.activePopup === "launchpad" || (root.activePopup === "spotlight" || (root.activePopup === "about" || root.activePopup === "settings"))) ? WlrKeyboardFocus.OnDemand : WlrKeyboardFocus.None
        exclusionMode: ExclusionMode.Ignore

        visible: !root.preWarmDone || root.activePopup !== ""
              || appleCard.opacity > 0.01
              || winCard.opacity > 0.01
              || deskCard.opacity > 0.01
              || ccCard.opacity > 0.01
              || wifiCard.opacity > 0.01
              || btCard.opacity > 0.01
              || musicFullCard.opacity > 0.01
              || calCard.opacity > 0.01
              || launcherCard.opacity > 0.01
              || aboutCard.opacity > 0.01
              || settingsCard.opacity > 0.01

        anchors { top: true; bottom: true; left: true; right: true }
        margins { top: 28 }
        color: "transparent"

        property var mediaPlayer: Mpris.players.values.length > 0 ? Mpris.players.values[0] : null

        MouseArea {
            id: backdropMouse
            anchors.fill: parent
            z: 0
            acceptedButtons: Qt.LeftButton | Qt.RightButton
            onClicked: root.closePopups()
        }

        // ── 4A. DROPDOWN MENU KIRI: SYSTEM MENU (LOGO APPLE) ────────────
        Rectangle {
            id: appleCard
            z: 10
            anchors.top: parent.top
            anchors.left: parent.left
            anchors.topMargin: 4
            anchors.leftMargin: 10
            width: 220
            height: appleCol.implicitHeight + 12
            radius: 14
            color: "transparent"
            Canvas {
                anchors.fill: parent
                z: -1
                property real dO: root.aeroOpacity
                property real dR: root.aeroReflection
                property real dF: root.glassFade
                property string dW: root.activeGlassWall
                property string dSt: root.glassStyle
                property real dTh: root.activeGlassDetail
                onDOChanged: requestPaint()
                onDRChanged: requestPaint()
                onDFChanged: requestPaint()
                onDWChanged: requestPaint()
                onDStChanged: requestPaint()
                onDThChanged: requestPaint()
                onPaint: {
                    let sw = Screen.width || 1366;
                    let sh = Screen.height || 768;
                    let pos = parent.mapToItem(null, 0, 0);
                    root.drawGlobalAeroGlass(getContext("2d"), width, height, parent.radius, pos.x, pos.y, sw, sh, false, false);
                }
            }
            border.width: 1
            border.color: "#38FFFFFF"
            visible: !root.preWarmDone || (root.activePopup === "apple" || opacity > 0.01)

            property bool isOpen: root.activePopup === "apple"
            property int stage: 0
            onIsOpenChanged: {
                if (isOpen) { stage = 0; appleStagger.restart(); }
                else { appleStagger.stop(); stage = 0; }
            }
            Timer {
                id: appleStagger
                interval: 34; repeat: true
                onTriggered: { if (appleCard.stage < 6) appleCard.stage++; else stop(); }
            }

            opacity: isOpen ? 1.0 : 0.0
            scale: isOpen ? 1.0 : 0.90
            transform: Translate {
                y: appleCard.isOpen ? 0 : -8
                Behavior on y { SpringAnimation { spring: 7.5; damping: 0.72 } }
            }
            transformOrigin: Item.TopLeft

            Behavior on opacity { NumberAnimation { duration: 150; easing.type: Easing.InOutCubic } }
            Behavior on scale { SpringAnimation { spring: 7.5; damping: 0.72 } }

            Column {
                id: appleCol
                anchors.left: parent.left
                anchors.right: parent.right
                anchors.top: parent.top
                anchors.margins: 6
                spacing: 2

                Repeater {
                    model: [
                        { label: "About This System", sep: false, action: "about", cmd: "" },
                        { label: "System Settings...", sep: true, action: "settings", cmd: "" },
                        { label: "Lock Screen", sep: false, cmd: "swaylock -f -c 000000 || loginctl lock-session" },
                        { label: "Sleep", sep: true, cmd: "systemctl suspend" },
                        { label: "Restart...", sep: false, cmd: "systemctl reboot" },
                        { label: "Shut Down...", sep: false, cmd: "systemctl poweroff" }
                    ]

                    Column {
                        width: appleCol.width
                        spacing: 2
                        opacity: appleCard.stage >= (index + 1) ? 1.0 : 0.0
                        transform: Translate {
                            y: appleCard.stage >= (index + 1) ? 0 : 6
                            Behavior on y { NumberAnimation { duration: 190; easing.type: Easing.InOutCubic } }
                        }
                        Behavior on opacity { NumberAnimation { duration: 145; easing.type: Easing.InOutCubic } }

                        Rectangle {
                            width: appleCol.width
                            height: 28
                            radius: 7
                            color: mItem1.containsMouse ? "#0A84FF" : "transparent"
                            Behavior on color { ColorAnimation { duration: 130 } }

                            Text {
                                anchors.left: parent.left
                                anchors.leftMargin: 10
                                anchors.verticalCenter: parent.verticalCenter
                                text: modelData.label
                                color: "#F5F5F7"
                                font.pixelSize: 12
                                font.weight: Font.Medium
                            }

                            MouseArea {
                                id: mItem1
                                anchors.fill: parent
                                z: 5
                                hoverEnabled: true
                                cursorShape: Qt.PointingHandCursor
                                onClicked: {
                                    if (modelData.action === "about") {
                                        root.switchPopup("about");
                                    } else if (modelData.action === "settings") {
                                        root.switchPopup("settings");
                                    } else {
                                        root.closePopups();
                                        root.runCmd(modelData.cmd);
                                    }
                                }
                            }
                        }

                        Rectangle {
                            width: appleCol.width - 16
                            anchors.horizontalCenter: parent.horizontalCenter
                            height: 1
                            color: "#22FFFFFF"
                            visible: modelData.sep
                        }
                    }
                }
            }
        }

        // ── 4B. DROPDOWN MENU KIRI: WINDOW ACTIONS ──────────────────────
        Rectangle {
            id: winCard
            z: 10
            anchors.top: parent.top
            anchors.left: parent.left
            anchors.topMargin: 4
            anchors.leftMargin: 96
            width: 210
            height: winMenuCol.implicitHeight + 12
            radius: 14
            color: "transparent"
            Canvas {
                anchors.fill: parent
                z: -1
                property real dO: root.aeroOpacity
                property real dR: root.aeroReflection
                property real dF: root.glassFade
                property string dW: root.activeGlassWall
                property string dSt: root.glassStyle
                property real dTh: root.activeGlassDetail
                onDOChanged: requestPaint()
                onDRChanged: requestPaint()
                onDFChanged: requestPaint()
                onDWChanged: requestPaint()
                onDStChanged: requestPaint()
                onDThChanged: requestPaint()
                onPaint: {
                    let sw = Screen.width || 1366;
                    let sh = Screen.height || 768;
                    let pos = parent.mapToItem(null, 0, 0);
                    root.drawGlobalAeroGlass(getContext("2d"), width, height, parent.radius, pos.x, pos.y, sw, sh, false, false);
                }
            }
            border.width: 1
            border.color: "#38FFFFFF"
            visible: !root.preWarmDone || (root.activePopup === "window" || opacity > 0.01)

            property bool isOpen: root.activePopup === "window"
            property int stage: 0
            onIsOpenChanged: {
                if (isOpen) { stage = 0; winStagger.restart(); }
                else { winStagger.stop(); stage = 0; }
            }
            Timer {
                id: winStagger
                interval: 34; repeat: true
                onTriggered: { if (winCard.stage < 4) winCard.stage++; else stop(); }
            }

            opacity: isOpen ? 1.0 : 0.0
            scale: isOpen ? 1.0 : 0.90
            transform: Translate {
                y: winCard.isOpen ? 0 : -8
                Behavior on y { SpringAnimation { spring: 7.5; damping: 0.72 } }
            }
            transformOrigin: Item.TopLeft

            Behavior on opacity { NumberAnimation { duration: 150; easing.type: Easing.InOutCubic } }
            Behavior on scale { SpringAnimation { spring: 7.5; damping: 0.72 } }

            Column {
                id: winMenuCol
                anchors.left: parent.left
                anchors.right: parent.right
                anchors.top: parent.top
                anchors.margins: 6
                spacing: 2

                Repeater {
                    model: [
                        { label: "Toggle Overview", cmd: "niri msg action toggle-overview" },
                        { label: "Toggle Fullscreen", cmd: "niri msg action fullscreen-window" },
                        { label: "Center Focused Column", cmd: "niri msg action center-column" },
                        { label: "Close Focused Window", cmd: "niri msg action close-window" }
                    ]

                    Rectangle {
                        width: winMenuCol.width
                        height: 28
                        radius: 7
                        color: mItem2.containsMouse ? "#0A84FF" : "transparent"
                        opacity: winCard.stage >= (index + 1) ? 1.0 : 0.0
                        transform: Translate {
                            y: winCard.stage >= (index + 1) ? 0 : 6
                            Behavior on y { NumberAnimation { duration: 190; easing.type: Easing.InOutCubic } }
                        }
                        Behavior on opacity { NumberAnimation { duration: 145; easing.type: Easing.InOutCubic } }
                        Behavior on color { ColorAnimation { duration: 130 } }

                        Text {
                            anchors.left: parent.left
                            anchors.leftMargin: 10
                            anchors.verticalCenter: parent.verticalCenter
                            text: modelData.label
                            color: "#F5F5F7"
                            font.pixelSize: 12
                            font.weight: Font.Medium
                        }

                        MouseArea {
                            id: mItem2
                            anchors.fill: parent
                            z: 5
                            hoverEnabled: true
                            cursorShape: Qt.PointingHandCursor
                            onClicked: {
                                root.closePopups();
                                root.runCmd(modelData.cmd);
                            }
                        }
                    }
                }
            }
        }

        // ── 4C. DROPDOWN MENU KIRI: DESKTOP ACTIONS ─────────────────────
        Rectangle {
            id: deskCard
            z: 10
            anchors.top: parent.top
            anchors.left: parent.left
            anchors.topMargin: 4
            anchors.leftMargin: 162
            width: 220
            height: deskMenuCol.implicitHeight + 12
            radius: 14
            color: "transparent"
            Canvas {
                anchors.fill: parent
                z: -1
                property real dO: root.aeroOpacity
                property real dR: root.aeroReflection
                property real dF: root.glassFade
                property string dW: root.activeGlassWall
                property string dSt: root.glassStyle
                property real dTh: root.activeGlassDetail
                onDOChanged: requestPaint()
                onDRChanged: requestPaint()
                onDFChanged: requestPaint()
                onDWChanged: requestPaint()
                onDStChanged: requestPaint()
                onDThChanged: requestPaint()
                onPaint: {
                    let sw = Screen.width || 1366;
                    let sh = Screen.height || 768;
                    let pos = parent.mapToItem(null, 0, 0);
                    root.drawGlobalAeroGlass(getContext("2d"), width, height, parent.radius, pos.x, pos.y, sw, sh, false, false);
                }
            }
            border.width: 1
            border.color: "#38FFFFFF"
            visible: !root.preWarmDone || (root.activePopup === "desktop" || opacity > 0.01)

            property bool isOpen: root.activePopup === "desktop"
            property int stage: 0
            onIsOpenChanged: {
                if (isOpen) { stage = 0; deskStagger.restart(); }
                else { deskStagger.stop(); stage = 0; }
            }
            Timer {
                id: deskStagger
                interval: 34; repeat: true
                onTriggered: { if (deskCard.stage < 4) deskCard.stage++; else stop(); }
            }

            opacity: isOpen ? 1.0 : 0.0
            scale: isOpen ? 1.0 : 0.90
            transform: Translate {
                y: deskCard.isOpen ? 0 : -8
                Behavior on y { SpringAnimation { spring: 7.5; damping: 0.72 } }
            }
            transformOrigin: Item.TopLeft

            Behavior on opacity { NumberAnimation { duration: 150; easing.type: Easing.InOutCubic } }
            Behavior on scale { SpringAnimation { spring: 7.5; damping: 0.72 } }

            Column {
                id: deskMenuCol
                anchors.left: parent.left
                anchors.right: parent.right
                anchors.top: parent.top
                anchors.margins: 6
                spacing: 2

                Repeater {
                    model: [
                        { label: "Next Wallpaper (Shader)", action: "wp" },
                        { label: "Take Screenshot...", action: "ss" },
                        { label: "Atur Posisi & Ukuran Widget", action: "edit" },
                        { label: "Reset Layout Widget", action: "reset" }
                    ]

                    Rectangle {
                        width: deskMenuCol.width
                        height: 28
                        radius: 7
                        color: mItem3.containsMouse ? "#0A84FF" : "transparent"
                        opacity: deskCard.stage >= (index + 1) ? 1.0 : 0.0
                        transform: Translate {
                            y: deskCard.stage >= (index + 1) ? 0 : 6
                            Behavior on y { NumberAnimation { duration: 190; easing.type: Easing.InOutCubic } }
                        }
                        Behavior on opacity { NumberAnimation { duration: 145; easing.type: Easing.InOutCubic } }
                        Behavior on color { ColorAnimation { duration: 130 } }

                        Text {
                            anchors.left: parent.left
                            anchors.leftMargin: 10
                            anchors.verticalCenter: parent.verticalCenter
                            text: modelData.label
                            color: "#F5F5F7"
                            font.pixelSize: 12
                            font.weight: Font.Medium
                        }

                        MouseArea {
                            id: mItem3
                            anchors.fill: parent
                            z: 5
                            hoverEnabled: true
                            cursorShape: Qt.PointingHandCursor
                            onClicked: {
                                root.closePopups();
                                if (modelData.action === "wp") root.pickRandomWallpaper();
                                else if (modelData.action === "ss") screenshotDelayTimer.restart();
                                else if (modelData.action === "edit") { win.editMode = true; }
                                else if (modelData.action === "reset") win.resetLayout();
                            }
                        }
                    }
                }
            }
        }

        // ── 4D. CONTROL CENTER ALA MACOS ────────────────────────────────
        Rectangle {
            id: ccCard
            z: 10
            anchors.right: parent.right
            anchors.top: parent.top
            anchors.topMargin: 4
            anchors.rightMargin: 10
            width: 338
            height: 460
            radius: 22
            color: "transparent"
            Canvas {
                anchors.fill: parent
                z: -1
                property real dO: root.aeroOpacity
                property real dR: root.aeroReflection
                property real dF: root.glassFade
                property string dW: root.activeGlassWall
                property string dSt: root.glassStyle
                property real dTh: root.activeGlassDetail
                onDOChanged: requestPaint()
                onDRChanged: requestPaint()
                onDFChanged: requestPaint()
                onDWChanged: requestPaint()
                onDStChanged: requestPaint()
                onDThChanged: requestPaint()
                onPaint: {
                    let sw = Screen.width || 1366;
                    let sh = Screen.height || 768;
                    let pos = parent.mapToItem(null, 0, 0);
                    root.drawGlobalAeroGlass(getContext("2d"), width, height, parent.radius, pos.x, pos.y, sw, sh, false, false);
                }
            }
            border.width: 1
            border.color: "#38FFFFFF"
            visible: !root.preWarmDone || (root.activePopup === "cc" || opacity > 0.01)

            MouseArea { anchors.fill: parent; z: 0 }

            property bool isOpen: root.activePopup === "cc"
            property int stage: 0
            onIsOpenChanged: {
                if (isOpen) {
                    stage = 1;
                    ccStaggerTimer.restart();
                } else {
                    ccStaggerTimer.stop();
                    stage = 0;
                }
            }

            Timer {
                id: ccStaggerTimer
                interval: 34
                repeat: true
                onTriggered: {
                    if (ccCard.stage < 5) ccCard.stage++;
                    else stop();
                }
            }

            opacity: isOpen ? 1.0 : 0.0
            scale: isOpen ? 1.0 : 0.90
            transform: Translate {
                y: ccCard.isOpen ? 0 : -12
                Behavior on y { SpringAnimation { spring: 7.5; damping: 0.72 } }
            }
            transformOrigin: Item.TopRight

            Behavior on opacity { NumberAnimation { duration: 160; easing.type: Easing.InOutCubic } }
            Behavior on scale { SpringAnimation { spring: 7.5; damping: 0.72 } }

            Column {
                x: 12
                y: 12
                z: 2
                width: 314
                spacing: 10

                // BARIS 1: KONEKTIVITAS + FOCUS & CAPTURE (STAGE 1)
                Row {
                    width: 314
                    height: 154
                    spacing: 10
                    opacity: ccCard.stage >= 1 ? 1.0 : 0.0
                    transform: Translate {
                        y: ccCard.stage >= 1 ? 0 : 12
                        Behavior on y { NumberAnimation { duration: 145; easing.type: Easing.InOutCubic } }
                    }
                    Behavior on opacity { NumberAnimation { duration: 145; easing.type: Easing.InOutCubic } }

                    Rectangle {
                        width: 152
                        height: 154
                        radius: 18
                        color: "#22FFFFFF"
                        border.width: 1
                        border.color: "#1AFFFFFF"

                        Column {
                            x: 10
                            y: 10
                            width: 132
                            spacing: 7

                            // 1. Wi-Fi
                            Rectangle {
                                width: 132
                                height: 40
                                radius: 11
                                color: wifiRowM.containsMouse ? "#24FFFFFF" : "transparent"
                                Behavior on color { ColorAnimation { duration: 160 } }

                                Rectangle {
                                    x: 2; y: 3
                                    width: 34; height: 34; radius: 17
                                    color: root.wifiEnabled ? "#0A84FF" : "#3A3A40"
                                    Behavior on color { ColorAnimation { duration: 220 } }

                                    Canvas {
                                        anchors.centerIn: parent
                                        width: 16; height: 14
                                        onPaint: {
                                            let ctx = getContext("2d"); ctx.reset();
                                            ctx.strokeStyle = "#FFFFFF"; ctx.lineWidth = 1.6; ctx.lineCap = "round";
                                            for (let r = 3; r <= 9; r += 3) {
                                                ctx.beginPath();
                                                ctx.arc(8, 11.5, r, -Math.PI * 0.78, -Math.PI * 0.22);
                                                ctx.stroke();
                                            }
                                            ctx.fillStyle = "#FFFFFF";
                                            ctx.beginPath(); ctx.arc(8, 11.8, 1.3, 0, Math.PI * 2); ctx.fill();
                                        }
                                    }
                                }

                                Text { x: 44; y: 4; width: 74; text: "Wi-Fi"; color: "#F5F5F7"; font.pixelSize: 12; font.bold: true }
                                Text { x: 44; y: 20; width: 74; text: root.wifiName; color: "#AEAEB2"; font.pixelSize: 10; elide: Text.ElideRight }
                                Text { x: 121; y: 12; text: "›"; color: "#8E8E93"; font.pixelSize: 13; font.bold: true }

                                MouseArea {
                                    id: wifiRowM
                                    anchors.fill: parent
                                    z: 5
                                    hoverEnabled: true
                                    acceptedButtons: Qt.LeftButton | Qt.RightButton
                                    cursorShape: Qt.PointingHandCursor
                                    onClicked: (mouse) => {
                                        if (mouse.button === Qt.RightButton || mouse.x > 110) root.switchPopup("wifi");
                                        else root.toggleWifi();
                                    }
                                }
                            }

                            // 2. Bluetooth
                            Rectangle {
                                width: 132
                                height: 40
                                radius: 11
                                color: btRowM.containsMouse ? "#24FFFFFF" : "transparent"
                                Behavior on color { ColorAnimation { duration: 160 } }

                                Rectangle {
                                    x: 2; y: 3
                                    width: 34; height: 34; radius: 17
                                    color: root.btEnabled ? "#0A84FF" : "#3A3A40"
                                    Behavior on color { ColorAnimation { duration: 220 } }

                                    Canvas {
                                        anchors.centerIn: parent
                                        width: 14; height: 16
                                        onPaint: {
                                            let ctx = getContext("2d"); ctx.reset();
                                            ctx.strokeStyle = "#FFFFFF"; ctx.lineWidth = 1.5; ctx.lineCap = "round"; ctx.lineJoin = "round";
                                            ctx.beginPath();
                                            ctx.moveTo(4, 5); ctx.lineTo(10, 11); ctx.lineTo(7, 14);
                                            ctx.moveTo(7, 2); ctx.lineTo(7, 14);
                                            ctx.moveTo(7, 2); ctx.lineTo(10, 5); ctx.lineTo(4, 11);
                                            ctx.stroke();
                                        }
                                    }
                                }

                                Text { x: 44; y: 4; width: 74; text: "Bluetooth"; color: "#F5F5F7"; font.pixelSize: 12; font.bold: true }
                                Text { x: 44; y: 20; width: 74; text: root.btEnabled ? (root.btDeviceName !== "" ? root.btDeviceName : "Aktif") : "Mati"; color: "#AEAEB2"; font.pixelSize: 10; elide: Text.ElideRight }
                                Text { x: 121; y: 12; text: "›"; color: "#8E8E93"; font.pixelSize: 13; font.bold: true }

                                MouseArea {
                                    id: btRowM
                                    anchors.fill: parent
                                    z: 5
                                    hoverEnabled: true
                                    acceptedButtons: Qt.LeftButton | Qt.RightButton
                                    cursorShape: Qt.PointingHandCursor
                                    onClicked: (mouse) => {
                                        if (mouse.button === Qt.RightButton || mouse.x > 110) root.switchPopup("bt");
                                        else root.toggleBluetooth();
                                    }
                                }
                            }

                            // 3. Keep Awake
                            Rectangle {
                                width: 132
                                height: 40
                                radius: 11
                                color: awakeRowM.containsMouse ? "#24FFFFFF" : "transparent"
                                Behavior on color { ColorAnimation { duration: 160 } }

                                Rectangle {
                                    x: 2; y: 3
                                    width: 34; height: 34; radius: 17
                                    color: root.keepAwake ? "#FF9F0A" : "#3A3A40"
                                    Behavior on color { ColorAnimation { duration: 220 } }

                                    Canvas {
                                        anchors.centerIn: parent
                                        width: 14; height: 14
                                        onPaint: {
                                            let ctx = getContext("2d"); ctx.reset();
                                            ctx.strokeStyle = "#FFFFFF"; ctx.lineWidth = 1.6;
                                            ctx.beginPath(); ctx.arc(7, 7, 4.5, 0, Math.PI * 2); ctx.stroke();
                                            ctx.beginPath(); ctx.moveTo(7, 4.5); ctx.lineTo(7, 7.2); ctx.lineTo(9, 8.8); ctx.stroke();
                                        }
                                    }
                                }

                                Text { x: 44; y: 4; width: 84; text: "Keep Awake"; color: "#F5F5F7"; font.pixelSize: 12; font.bold: true }
                                Text { x: 44; y: 20; width: 84; text: root.keepAwake ? "Layar Terjaga" : "Normal"; color: "#AEAEB2"; font.pixelSize: 10; elide: Text.ElideRight }

                                MouseArea {
                                    id: awakeRowM
                                    anchors.fill: parent
                                    z: 5
                                    hoverEnabled: true
                                    cursorShape: Qt.PointingHandCursor
                                    onClicked: root.toggleKeepAwake()
                                }
                            }
                        }
                    }

                    Column {
                        width: 152
                        height: 154
                        spacing: 10

                        Rectangle {
                            width: 152
                            height: 72
                            radius: 18
                            color: dndM.containsMouse ? "#30FFFFFF" : "#22FFFFFF"
                            border.width: 1
                            border.color: "#1AFFFFFF"
                            Behavior on color { ColorAnimation { duration: 160 } }

                            Rectangle {
                                x: 12; y: 18
                                width: 36; height: 36; radius: 18
                                color: root.dndEnabled ? "#5E5CE6" : "#3A3A40"
                                Behavior on color { ColorAnimation { duration: 220 } }

                                Canvas {
                                    anchors.centerIn: parent
                                    width: 16; height: 16
                                    onPaint: {
                                        let ctx = getContext("2d"); ctx.reset();
                                        ctx.fillStyle = "#FFFFFF";
                                        ctx.beginPath();
                                        ctx.arc(8.5, 8, 5.2, 0.35 * Math.PI, 1.65 * Math.PI);
                                        ctx.arc(11.2, 6.2, 4.2, 1.55 * Math.PI, 0.45 * Math.PI, true);
                                        ctx.closePath();
                                        ctx.fill();
                                    }
                                }
                            }

                            Text { x: 56; y: 19; width: 86; text: "Focus"; color: "#F5F5F7"; font.pixelSize: 12; font.bold: true }
                            Text { x: 56; y: 36; width: 86; text: root.dndEnabled ? "Do Not Disturb" : "Off"; color: "#AEAEB2"; font.pixelSize: 10; elide: Text.ElideRight }

                            MouseArea {
                                id: dndM
                                anchors.fill: parent
                                z: 5
                                hoverEnabled: true
                                cursorShape: Qt.PointingHandCursor
                                onClicked: root.toggleDnd()
                            }
                        }

                        Row {
                            width: 152
                            height: 72
                            spacing: 10

                            Rectangle {
                                width: 71
                                height: 72
                                radius: 18
                                color: ssTileM.containsMouse ? "#30FFFFFF" : "#22FFFFFF"
                                border.width: 1
                                border.color: "#1AFFFFFF"
                                scale: ssTileM.pressed ? 0.94 : 1.0
                                Behavior on color { ColorAnimation { duration: 160 } }
                                Behavior on scale { SpringAnimation { spring: 7.5; damping: 0.72 } }

                                Canvas {
                                    x: 25; y: 14
                                    width: 20; height: 18
                                    onPaint: {
                                        let ctx = getContext("2d"); ctx.reset();
                                        ctx.strokeStyle = "#F5F5F7"; ctx.lineWidth = 1.6;
                                        ctx.strokeRect(2, 4, 16, 11);
                                        ctx.beginPath(); ctx.arc(10, 9.5, 3, 0, Math.PI * 2); ctx.stroke();
                                    }
                                }

                                Text { x: 4; y: 42; width: 63; horizontalAlignment: Text.AlignHCenter; text: "Capture"; color: "#F5F5F7"; font.pixelSize: 11; font.weight: Font.Medium }

                                MouseArea {
                                    id: ssTileM
                                    anchors.fill: parent
                                    z: 5
                                    hoverEnabled: true
                                    cursorShape: Qt.PointingHandCursor
                                    onClicked: {
                                        root.closePopups();
                                        screenshotDelayTimer.restart();
                                    }
                                }
                            }

                            Rectangle {
                                width: 71
                                height: 72
                                radius: 18
                                color: wpTileM.containsMouse ? "#30FFFFFF" : "#22FFFFFF"
                                border.width: 1
                                border.color: "#1AFFFFFF"
                                scale: wpTileM.pressed ? 0.94 : 1.0
                                Behavior on color { ColorAnimation { duration: 160 } }
                                Behavior on scale { SpringAnimation { spring: 7.5; damping: 0.72 } }

                                Canvas {
                                    x: 25; y: 14
                                    width: 20; height: 18
                                    onPaint: {
                                        let ctx = getContext("2d"); ctx.reset();
                                        ctx.strokeStyle = "#FF9F0A"; ctx.lineWidth = 1.6;
                                        ctx.strokeRect(2, 3, 16, 12);
                                        ctx.beginPath(); ctx.moveTo(3, 14); ctx.lineTo(8, 8); ctx.lineTo(12, 12); ctx.lineTo(14, 9); ctx.lineTo(17, 14); ctx.stroke();
                                    }
                                }

                                Text { x: 4; y: 42; width: 63; horizontalAlignment: Text.AlignHCenter; text: "Wallpaper"; color: "#F5F5F7"; font.pixelSize: 11; font.weight: Font.Medium }

                                MouseArea {
                                    id: wpTileM
                                    anchors.fill: parent
                                    z: 5
                                    hoverEnabled: true
                                    cursorShape: Qt.PointingHandCursor
                                    onClicked: root.pickRandomWallpaper()
                                }
                            }
                        }
                    }
                }

                // BARIS 2: DISPLAY BRIGHTNESS SLIDER (STAGE 2)
                Rectangle {
                    width: 314
                    height: 66
                    radius: 18
                    color: "#22FFFFFF"
                    border.width: 1
                    border.color: "#1AFFFFFF"
                    opacity: ccCard.stage >= 2 ? 1.0 : 0.0
                    transform: Translate {
                        y: ccCard.stage >= 2 ? 0 : 12
                        Behavior on y { NumberAnimation { duration: 145; easing.type: Easing.InOutCubic } }
                    }
                    Behavior on opacity { NumberAnimation { duration: 145; easing.type: Easing.InOutCubic } }

                    Text { x: 14; y: 10; text: "Display"; color: "#F5F5F7"; font.pixelSize: 11; font.bold: true }
                    Text { anchors.right: parent.right; anchors.rightMargin: 14; y: 10; text: root.brightnessLevel + "%"; color: "#AEAEB2"; font.pixelSize: 11 }

                    Rectangle {
                        id: briTrack
                        x: 12; y: 32
                        width: 290
                        height: 24
                        radius: 12
                        color: "#38000000"
                        clip: true

                        Rectangle {
                            width: Math.max(24, 290 * (root.brightnessLevel / 100))
                            height: 24
                            radius: 12
                            color: "#F5F5F7"
                            Behavior on width { NumberAnimation { duration: 110; easing.type: Easing.InOutCubic } }
                        }

                        Canvas {
                            x: 6; y: 6
                            width: 12; height: 12
                            onPaint: {
                                let ctx = getContext("2d"); ctx.reset();
                                ctx.fillStyle = "#1C1C22";
                                ctx.beginPath(); ctx.arc(6, 6, 3.2, 0, Math.PI * 2); ctx.fill();
                            }
                        }

                        MouseArea {
                            anchors.fill: parent
                            z: 5
                            cursorShape: Qt.PointingHandCursor
                            onPressed: (m) => root.setBrightnessPct((m.x / 290) * 100)
                            onPositionChanged: (m) => { if (pressed) root.setBrightnessPct((m.x / 290) * 100); }
                        }
                    }
                }

                // BARIS 3: SOUND VOLUME SLIDER (STAGE 3)
                Rectangle {
                    width: 314
                    height: 66
                    radius: 18
                    color: "#22FFFFFF"
                    border.width: 1
                    border.color: "#1AFFFFFF"
                    opacity: ccCard.stage >= 3 ? 1.0 : 0.0
                    transform: Translate {
                        y: ccCard.stage >= 3 ? 0 : 12
                        Behavior on y { NumberAnimation { duration: 145; easing.type: Easing.InOutCubic } }
                    }
                    Behavior on opacity { NumberAnimation { duration: 145; easing.type: Easing.InOutCubic } }

                    Text { x: 14; y: 10; text: "Sound"; color: "#F5F5F7"; font.pixelSize: 11; font.bold: true }

                    Text {
                        anchors.right: parent.right
                        anchors.rightMargin: 14
                        y: 10
                        text: root.volumeMuted ? "Muted" : (root.volumeLevel + "%")
                        color: root.volumeMuted ? "#FF453A" : "#AEAEB2"
                        font.pixelSize: 11

                        MouseArea {
                            anchors.fill: parent
                            z: 5
                            cursorShape: Qt.PointingHandCursor
                            onClicked: root.toggleMute()
                        }
                    }

                    Rectangle {
                        id: volTrack
                        x: 12; y: 32
                        width: 290
                        height: 24
                        radius: 12
                        color: "#38000000"
                        clip: true

                        Rectangle {
                            width: root.volumeMuted ? 24 : Math.max(24, 290 * (root.volumeLevel / 100))
                            height: 24
                            radius: 12
                            color: "#F5F5F7"
                            Behavior on width { NumberAnimation { duration: 110; easing.type: Easing.InOutCubic } }
                        }

                        Canvas {
                            x: 6; y: 6
                            width: 12; height: 12
                            onPaint: {
                                let ctx = getContext("2d"); ctx.reset();
                                ctx.fillStyle = "#1C1C22";
                                ctx.beginPath();
                                ctx.moveTo(2, 4.5); ctx.lineTo(4.5, 4.5); ctx.lineTo(8, 2);
                                ctx.lineTo(8, 10); ctx.lineTo(4.5, 7.5); ctx.lineTo(2, 7.5);
                                ctx.closePath(); ctx.fill();
                            }
                        }

                        MouseArea {
                            anchors.fill: parent
                            z: 5
                            cursorShape: Qt.PointingHandCursor
                            onPressed: (m) => root.setVolumePct((m.x / 290) * 100)
                            onPositionChanged: (m) => { if (pressed) root.setVolumePct((m.x / 290) * 100); }
                        }
                    }
                }

                // BARIS 4: NOW PLAYING MEDIA CARD (STAGE 4)
                Rectangle {
                    width: 314
                    height: 72
                    radius: 18
                    color: "#22FFFFFF"
                    border.width: 1
                    border.color: "#1AFFFFFF"
                    opacity: ccCard.stage >= 4 ? 1.0 : 0.0
                    transform: Translate {
                        y: ccCard.stage >= 4 ? 0 : 12
                        Behavior on y { NumberAnimation { duration: 145; easing.type: Easing.InOutCubic } }
                    }
                    Behavior on opacity { NumberAnimation { duration: 145; easing.type: Easing.InOutCubic } }

                    Rectangle {
                        x: 12; y: 12
                        width: 48; height: 48; radius: 11
                        color: "#2C2C34"
                        clip: true

                        Image {
                            id: ccArt
                            anchors.fill: parent
                            source: popupOverlayWin.mediaPlayer ? popupOverlayWin.mediaPlayer.trackArtUrl : ""
                            fillMode: Image.PreserveAspectCrop
                            visible: status === Image.Ready
                        }

                        Text {
                            anchors.centerIn: parent
                            text: "♫"
                            color: "#A1C6FF"
                            font.pixelSize: 19
                            visible: ccArt.status !== Image.Ready
                        }
                    }

                    Text {
                        x: 70; y: 18
                        width: 134
                        text: (popupOverlayWin.mediaPlayer && popupOverlayWin.mediaPlayer.trackTitle) ? popupOverlayWin.mediaPlayer.trackTitle : "Not Playing"
                        color: "#F5F5F7"
                        font.pixelSize: 12
                        font.bold: true
                        elide: Text.ElideRight
                    }

                    Text {
                        x: 70; y: 37
                        width: 134
                        text: (popupOverlayWin.mediaPlayer && popupOverlayWin.mediaPlayer.trackArtist) ? popupOverlayWin.mediaPlayer.trackArtist : "MPRIS Audio"
                        color: "#AEAEB2"
                        font.pixelSize: 10
                        elide: Text.ElideRight
                    }

                    Row {
                        x: 210; y: 21
                        spacing: 4

                        Rectangle {
                            width: 28; height: 30; radius: 15
                            color: ccPrevM.containsMouse ? "#33FFFFFF" : "transparent"
                            Behavior on color { ColorAnimation { duration: 60 } }
                            Text { anchors.centerIn: parent; text: "|◀"; color: "#F5F5F7"; font.pixelSize: 10 }
                            MouseArea {
                                id: ccPrevM; anchors.fill: parent; z: 5; hoverEnabled: true; cursorShape: Qt.PointingHandCursor
                                onClicked: if (popupOverlayWin.mediaPlayer) popupOverlayWin.mediaPlayer.previous()
                            }
                        }

                        Rectangle {
                            width: 32; height: 30; radius: 15
                            color: ccPlayM.containsMouse ? "#33FFFFFF" : "transparent"
                            Behavior on color { ColorAnimation { duration: 60 } }
                            Text {
                                anchors.centerIn: parent
                                text: (popupOverlayWin.mediaPlayer && popupOverlayWin.mediaPlayer.isPlaying) ? "❚❚" : "▶"
                                color: "#F5F5F7"
                                font.pixelSize: 11
                            }
                            MouseArea {
                                id: ccPlayM; anchors.fill: parent; z: 5; hoverEnabled: true; cursorShape: Qt.PointingHandCursor
                                onClicked: if (popupOverlayWin.mediaPlayer) popupOverlayWin.mediaPlayer.togglePlaying()
                            }
                        }

                        Rectangle {
                            width: 28; height: 30; radius: 15
                            color: ccNextM.containsMouse ? "#33FFFFFF" : "transparent"
                            Behavior on color { ColorAnimation { duration: 60 } }
                            Text { anchors.centerIn: parent; text: "▶|"; color: "#F5F5F7"; font.pixelSize: 10 }
                            MouseArea {
                                id: ccNextM; anchors.fill: parent; z: 5; hoverEnabled: true; cursorShape: Qt.PointingHandCursor
                                onClicked: if (popupOverlayWin.mediaPlayer) popupOverlayWin.mediaPlayer.next()
                            }
                        }
                    }
                }

                // BARIS 5: BATTERY + ATUR WIDGET + SETTINGS + LOCK (STAGE 5)
                Row {
                    width: 314
                    height: 38
                    spacing: 8
                    opacity: ccCard.stage >= 5 ? 1.0 : 0.0
                    transform: Translate {
                        y: ccCard.stage >= 5 ? 0 : 12
                        Behavior on y { NumberAnimation { duration: 145; easing.type: Easing.InOutCubic } }
                    }
                    Behavior on opacity { NumberAnimation { duration: 145; easing.type: Easing.InOutCubic } }

                    Rectangle {
                        width: 94
                        height: 38
                        radius: 13
                        color: "#22FFFFFF"
                        border.width: 1
                        border.color: "#1AFFFFFF"

                        Text {
                            anchors.centerIn: parent
                            text: root.batteryPercent >= 0 ? ("BAT " + root.batteryPercent + "%") : "AC Power"
                            color: root.batteryStatus === "Charging" ? "#32D74B" : "#F5F5F7"
                            font.pixelSize: 11
                            font.bold: true
                        }
                    }

                    Rectangle {
                        width: 78
                        height: 38
                        radius: 13
                        color: ccEditM.containsMouse ? "#38FFFFFF" : "#22FFFFFF"
                        border.width: 1
                        border.color: "#1AFFFFFF"
                        Behavior on color { ColorAnimation { duration: 60 } }

                        Text { anchors.centerIn: parent; text: "Atur Widget"; color: "#F5F5F7"; font.pixelSize: 11; font.bold: true }

                        MouseArea {
                            id: ccEditM; anchors.fill: parent; z: 5; hoverEnabled: true; cursorShape: Qt.PointingHandCursor
                            onClicked: {
                                root.closePopups();
                                win.posY = win.resolvedY;
                                win.editMode = true;
                            }
                        }
                    }

                    Rectangle {
                        width: 66
                        height: 38
                        radius: 13
                        color: ccSetM.containsMouse ? "#38FFFFFF" : "#22FFFFFF"
                        border.width: 1
                        border.color: "#1AFFFFFF"
                        Behavior on color { ColorAnimation { duration: 60 } }

                        Text { anchors.centerIn: parent; text: "Settings"; color: "#F5F5F7"; font.pixelSize: 11; font.bold: true }

                        MouseArea {
                            id: ccSetM; anchors.fill: parent; z: 5; hoverEnabled: true; cursorShape: Qt.PointingHandCursor
                            onPressed: root.switchPopup("settings")
                        }
                    }

                    Rectangle {
                        width: 52
                        height: 38
                        radius: 13
                        color: ccLockM.containsMouse ? "#38FFFFFF" : "#22FFFFFF"
                        border.width: 1
                        border.color: "#1AFFFFFF"
                        Behavior on color { ColorAnimation { duration: 60 } }

                        Text { anchors.centerIn: parent; text: "Lock"; color: "#F5F5F7"; font.pixelSize: 11; font.bold: true }

                        MouseArea {
                            id: ccLockM; anchors.fill: parent; z: 5; hoverEnabled: true; cursorShape: Qt.PointingHandCursor
                            onClicked: {
                                root.closePopups();
                                root.runCmd("swaylock -f -c 000000 || loginctl lock-session");
                            }
                        }
                    }
                }
            }
        }

        // ── 4E. POPUP WIFI SEKITAR (KLIK KANAN WIFI) ────────────────────
        Rectangle {
            id: wifiCard
            z: 10
            anchors.right: parent.right
            anchors.top: parent.top
            anchors.topMargin: 4
            anchors.rightMargin: 10
            width: 318
            height: wifiPopupCol.implicitHeight + 24
            radius: 22
            color: "transparent"
            Canvas {
                anchors.fill: parent
                z: -1
                property real dO: root.aeroOpacity
                property real dR: root.aeroReflection
                property real dF: root.glassFade
                property string dW: root.activeGlassWall
                property string dSt: root.glassStyle
                property real dTh: root.activeGlassDetail
                onDOChanged: requestPaint()
                onDRChanged: requestPaint()
                onDFChanged: requestPaint()
                onDWChanged: requestPaint()
                onDStChanged: requestPaint()
                onDThChanged: requestPaint()
                onPaint: {
                    let sw = Screen.width || 1366;
                    let sh = Screen.height || 768;
                    let pos = parent.mapToItem(null, 0, 0);
                    root.drawGlobalAeroGlass(getContext("2d"), width, height, parent.radius, pos.x, pos.y, sw, sh, false, false);
                }
            }
            border.width: 1
            border.color: "#38FFFFFF"
            visible: !root.preWarmDone || (root.activePopup === "wifi" || opacity > 0.01)

            MouseArea { anchors.fill: parent; z: 0 }

            property bool isOpen: root.activePopup === "wifi"
            property int stage: 0
            onIsOpenChanged: {
                if (isOpen) {
                    stage = 1;
                    wifiStaggerTimer.restart();
                } else {
                    wifiStaggerTimer.stop();
                    stage = 0;
                }
            }

            Timer {
                id: wifiStaggerTimer
                interval: 34
                repeat: true
                onTriggered: {
                    if (wifiCard.stage < 12) wifiCard.stage++;
                    else stop();
                }
            }

            opacity: isOpen ? 1.0 : 0.0
            scale: isOpen ? 1.0 : 0.90
            transform: Translate {
                y: wifiCard.isOpen ? 0 : -12
                Behavior on y { SpringAnimation { spring: 7.5; damping: 0.72 } }
            }
            transformOrigin: Item.TopRight

            Behavior on opacity { NumberAnimation { duration: 170; easing.type: Easing.InOutCubic } }
            Behavior on scale { SpringAnimation { spring: 7.5; damping: 0.72 } }
            Behavior on height { NumberAnimation { duration: 145; easing.type: Easing.InOutCubic } }

            Column {
                id: wifiPopupCol
                x: 14
                y: 12
                z: 2
                width: 290
                spacing: 10

                RowLayout {
                    width: 290
                    opacity: wifiCard.stage >= 1 ? 1.0 : 0.0
                    Behavior on opacity { NumberAnimation { duration: 145; easing.type: Easing.InOutCubic } }

                    Rectangle {
                        width: 26; height: 26; radius: 13
                        color: backWifiM.containsMouse ? "#2EFFFFFF" : "#1AFFFFFF"
                        Text { anchors.centerIn: parent; text: "‹"; color: "#F5F5F7"; font.pixelSize: 15; font.bold: true }
                        MouseArea {
                            id: backWifiM; anchors.fill: parent; z: 5; hoverEnabled: true; cursorShape: Qt.PointingHandCursor
                            onPressed: root.switchPopup("cc")
                        }
                    }

                    Text { text: "Wi-Fi Sekitar"; color: "#F5F5F7"; font.pixelSize: 13; font.bold: true }
                    Item { Layout.fillWidth: true }

                    Rectangle {
                        width: 26; height: 26; radius: 13
                        color: scanWifiM.containsMouse ? "#2EFFFFFF" : "#1AFFFFFF"
                        visible: root.wifiEnabled
                        Text { anchors.centerIn: parent; text: root.wifiScanning ? "…" : "↻"; color: "#A1C6FF"; font.pixelSize: 12; font.bold: true }
                        MouseArea {
                            id: scanWifiM; anchors.fill: parent; z: 5; hoverEnabled: true; cursorShape: Qt.PointingHandCursor
                            onClicked: root.scanWifiNetworks()
                        }
                    }

                    Rectangle {
                        width: 42; height: 24; radius: 12
                        color: root.wifiEnabled ? "#0A84FF" : "#3A3A40"
                        Behavior on color { ColorAnimation { duration: 200 } }

                        Rectangle {
                            x: root.wifiEnabled ? 20 : 2
                            y: 2
                            width: 20; height: 20; radius: 10
                            color: "#FFFFFF"
                            Behavior on x { SpringAnimation { spring: 7.5; damping: 0.72 } }
                        }

                        MouseArea {
                            anchors.fill: parent
                            z: 5
                            cursorShape: Qt.PointingHandCursor
                            onClicked: root.toggleWifi()
                        }
                    }
                }

                Rectangle {
                    width: 290
                    height: 68
                    radius: 14
                    color: "#26FFFFFF"
                    border.width: 1
                    border.color: "#44A1C6FF"
                    visible: root.wifiPasswordTarget !== ""

                    Column {
                        anchors.fill: parent
                        anchors.margins: 8
                        spacing: 6

                        Text {
                            text: "Sandi untuk " + root.wifiPasswordTarget
                            color: "#F5F5F7"
                            font.pixelSize: 11
                            font.bold: true
                            elide: Text.ElideRight
                            width: parent.width
                        }

                        Row {
                            width: parent.width
                            spacing: 6

                            TextField {
                                id: wifiPassField
                                width: 196
                                height: 28
                                echoMode: TextInput.Password
                                placeholderText: "Masukkan sandi Wi-Fi..."
                                color: "#FFFFFF"
                                font.pixelSize: 11
                                background: Rectangle {
                                    radius: 8
                                    color: "#44000000"
                                    border.width: 1
                                    border.color: "#33FFFFFF"
                                }
                                onAccepted: root.connectWifi(root.wifiPasswordTarget, text)
                            }

                            Rectangle {
                                width: 72
                                height: 28
                                radius: 8
                                color: "#0A84FF"
                                Text { anchors.centerIn: parent; text: "Hubungkan"; color: "#FFFFFF"; font.pixelSize: 10; font.bold: true }
                                MouseArea {
                                    anchors.fill: parent
                                    z: 5
                                    cursorShape: Qt.PointingHandCursor
                                    onClicked: root.connectWifi(root.wifiPasswordTarget, wifiPassField.text)
                                }
                            }
                        }
                    }
                }

                Text { width: 290; text: root.wifiStatusMsg; color: "#A1C6FF"; font.pixelSize: 11; visible: root.wifiStatusMsg !== "" }

                Column {
                    width: 290
                    spacing: 5
                    visible: root.wifiEnabled

                    Text {
                        width: 290
                        horizontalAlignment: Text.AlignHCenter
                        text: root.wifiScanning ? "Memindai jaringan Wi-Fi..." : "Tidak ada jaringan ditemukan"
                        color: "#8E8E93"
                        font.pixelSize: 11
                        visible: root.wifiNetworks.length === 0
                    }

                    Repeater {
                        model: root.wifiNetworks

                        Rectangle {
                            width: 290
                            height: 36
                            radius: 11
                            color: netRowM.containsMouse ? "#2AFFFFFF" : (modelData.connected ? "#220A84FF" : "#18FFFFFF")
                            border.width: modelData.connected ? 1 : 0
                            border.color: "#550A84FF"

                            opacity: wifiCard.stage >= (index + 2) ? 1.0 : 0.0
                            transform: Translate {
                                y: wifiCard.stage >= (index + 2) ? 0 : 8
                                Behavior on y { NumberAnimation { duration: 145; easing.type: Easing.InOutCubic } }
                            }
                            Behavior on opacity { NumberAnimation { duration: 145; easing.type: Easing.InOutCubic } }
                            Behavior on color { ColorAnimation { duration: 60 } }

                            Row {
                                anchors.fill: parent
                                anchors.leftMargin: 10
                                anchors.rightMargin: 10
                                spacing: 8

                                Rectangle {
                                    anchors.verticalCenter: parent.verticalCenter
                                    width: 22; height: 22; radius: 11
                                    color: modelData.connected ? "#0A84FF" : "#3A3A40"
                                    Text {
                                        anchors.centerIn: parent
                                        text: modelData.connected ? "✓" : "ᯤ"
                                        color: "#FFFFFF"
                                        font.pixelSize: 11
                                        font.bold: true
                                    }
                                }

                                Text {
                                    anchors.verticalCenter: parent.verticalCenter
                                    width: 175
                                    text: modelData.ssid
                                    color: "#F5F5F7"
                                    font.pixelSize: 12
                                    font.weight: modelData.connected ? Font.Bold : Font.Normal
                                    elide: Text.ElideRight
                                }

                                Text {
                                    anchors.verticalCenter: parent.verticalCenter
                                    text: (modelData.secured ? "🔒 " : "") + modelData.signal + "%"
                                    color: "#AEAEB2"
                                    font.pixelSize: 10
                                }
                            }

                            MouseArea {
                                id: netRowM
                                anchors.fill: parent
                                z: 5
                                hoverEnabled: true
                                cursorShape: Qt.PointingHandCursor
                                onClicked: {
                                    if (modelData.connected) return;
                                    if (modelData.secured) {
                                        root.wifiPasswordTarget = modelData.ssid;
                                        wifiPassField.text = "";
                                        wifiPassField.forceActiveFocus();
                                    }
                                    root.connectWifi(modelData.ssid, "");
                                }
                            }
                        }
                    }
                }

                Text {
                    width: 290
                    horizontalAlignment: Text.AlignHCenter
                    text: "Wi-Fi dimatikan. Aktifkan sakelar di atas untuk memindai."
                    color: "#8E8E93"
                    font.pixelSize: 11
                    wrapMode: Text.WordWrap
                    visible: !root.wifiEnabled
                }
            }
        }

        // ── 4F. POPUP BLUETOOTH TERSEDIA (KLIK KANAN BLUETOOTH) ─────────
        Rectangle {
            id: btCard
            z: 10
            anchors.right: parent.right
            anchors.top: parent.top
            anchors.topMargin: 4
            anchors.rightMargin: 10
            width: 318
            height: btPopupCol.implicitHeight + 24
            radius: 22
            color: "transparent"
            Canvas {
                anchors.fill: parent
                z: -1
                property real dO: root.aeroOpacity
                property real dR: root.aeroReflection
                property real dF: root.glassFade
                property string dW: root.activeGlassWall
                property string dSt: root.glassStyle
                property real dTh: root.activeGlassDetail
                onDOChanged: requestPaint()
                onDRChanged: requestPaint()
                onDFChanged: requestPaint()
                onDWChanged: requestPaint()
                onDStChanged: requestPaint()
                onDThChanged: requestPaint()
                onPaint: {
                    let sw = Screen.width || 1366;
                    let sh = Screen.height || 768;
                    let pos = parent.mapToItem(null, 0, 0);
                    root.drawGlobalAeroGlass(getContext("2d"), width, height, parent.radius, pos.x, pos.y, sw, sh, false, false);
                }
            }
            border.width: 1
            border.color: "#38FFFFFF"
            visible: !root.preWarmDone || (root.activePopup === "bt" || opacity > 0.01)

            MouseArea { anchors.fill: parent; z: 0 }

            property bool isOpen: root.activePopup === "bt"
            property int stage: 0
            onIsOpenChanged: {
                if (isOpen) {
                    stage = 1;
                    btStaggerTimer.restart();
                } else {
                    btStaggerTimer.stop();
                    stage = 0;
                }
            }

            Timer {
                id: btStaggerTimer
                interval: 34
                repeat: true
                onTriggered: {
                    if (btCard.stage < 12) btCard.stage++;
                    else stop();
                }
            }

            opacity: isOpen ? 1.0 : 0.0
            scale: isOpen ? 1.0 : 0.90
            transform: Translate {
                y: btCard.isOpen ? 0 : -12
                Behavior on y { SpringAnimation { spring: 7.5; damping: 0.72 } }
            }
            transformOrigin: Item.TopRight

            Behavior on opacity { NumberAnimation { duration: 170; easing.type: Easing.InOutCubic } }
            Behavior on scale { SpringAnimation { spring: 7.5; damping: 0.72 } }
            Behavior on height { NumberAnimation { duration: 145; easing.type: Easing.InOutCubic } }

            Column {
                id: btPopupCol
                x: 14
                y: 12
                z: 2
                width: 290
                spacing: 10

                RowLayout {
                    width: 290
                    opacity: btCard.stage >= 1 ? 1.0 : 0.0
                    Behavior on opacity { NumberAnimation { duration: 145; easing.type: Easing.InOutCubic } }

                    Rectangle {
                        width: 26; height: 26; radius: 13
                        color: backBtM.containsMouse ? "#2EFFFFFF" : "#1AFFFFFF"
                        Text { anchors.centerIn: parent; text: "‹"; color: "#F5F5F7"; font.pixelSize: 15; font.bold: true }
                        MouseArea {
                            id: backBtM; anchors.fill: parent; z: 5; hoverEnabled: true; cursorShape: Qt.PointingHandCursor
                            onPressed: root.switchPopup("cc")
                        }
                    }

                    Text { text: "Bluetooth Tersedia"; color: "#F5F5F7"; font.pixelSize: 13; font.bold: true }
                    Item { Layout.fillWidth: true }

                    Rectangle {
                        width: 26; height: 26; radius: 13
                        color: scanBtM.containsMouse ? "#2EFFFFFF" : "#1AFFFFFF"
                        visible: root.btEnabled
                        Text { anchors.centerIn: parent; text: root.btScanning ? "…" : "↻"; color: "#A1C6FF"; font.pixelSize: 12; font.bold: true }
                        MouseArea {
                            id: scanBtM; anchors.fill: parent; z: 5; hoverEnabled: true; cursorShape: Qt.PointingHandCursor
                            onClicked: root.scanBtDevices()
                        }
                    }

                    Rectangle {
                        width: 42; height: 24; radius: 12
                        color: root.btEnabled ? "#0A84FF" : "#3A3A40"
                        Behavior on color { ColorAnimation { duration: 200 } }

                        Rectangle {
                            x: root.btEnabled ? 20 : 2
                            y: 2
                            width: 20; height: 20; radius: 10
                            color: "#FFFFFF"
                            Behavior on x { SpringAnimation { spring: 7.5; damping: 0.72 } }
                        }

                        MouseArea {
                            anchors.fill: parent
                            z: 5
                            cursorShape: Qt.PointingHandCursor
                            onClicked: root.toggleBluetooth()
                        }
                    }
                }

                Column {
                    width: 290
                    spacing: 5
                    visible: root.btEnabled

                    Text {
                        width: 290
                        horizontalAlignment: Text.AlignHCenter
                        text: root.btScanning ? "Memindai perangkat Bluetooth..." : "Tidak ada perangkat ditemukan"
                        color: "#8E8E93"
                        font.pixelSize: 11
                        visible: root.btDevices.length === 0
                    }

                    Repeater {
                        model: root.btDevices

                        Rectangle {
                            width: 290
                            height: 38
                            radius: 11
                            color: btDevM.containsMouse ? "#2AFFFFFF" : (modelData.connected ? "#220A84FF" : "#18FFFFFF")
                            border.width: modelData.connected ? 1 : 0
                            border.color: "#550A84FF"

                            opacity: btCard.stage >= (index + 2) ? 1.0 : 0.0
                            transform: Translate {
                                y: btCard.stage >= (index + 2) ? 0 : 8
                                Behavior on y { NumberAnimation { duration: 145; easing.type: Easing.InOutCubic } }
                            }
                            Behavior on opacity { NumberAnimation { duration: 145; easing.type: Easing.InOutCubic } }
                            Behavior on color { ColorAnimation { duration: 60 } }

                            Row {
                                anchors.fill: parent
                                anchors.leftMargin: 10
                                anchors.rightMargin: 10
                                spacing: 8

                                Rectangle {
                                    anchors.verticalCenter: parent.verticalCenter
                                    width: 24; height: 24; radius: 12
                                    color: modelData.connected ? "#0A84FF" : "#3A3A40"
                                    Text {
                                        anchors.centerIn: parent
                                        text: modelData.connected ? "✓" : "ᛒ"
                                        color: "#FFFFFF"
                                        font.pixelSize: 11
                                        font.bold: true
                                    }
                                }

                                Text {
                                    anchors.verticalCenter: parent.verticalCenter
                                    width: 162
                                    text: modelData.name
                                    color: "#F5F5F7"
                                    font.pixelSize: 12
                                    font.weight: modelData.connected ? Font.Bold : Font.Normal
                                    elide: Text.ElideRight
                                }

                                Text {
                                    anchors.verticalCenter: parent.verticalCenter
                                    text: root.btBusyMac === modelData.mac ? "Proses..."
                                          : (modelData.connected ? "Terhubung" : (modelData.paired ? "Tersimpan" : "Pasangkan"))
                                    color: modelData.connected ? "#32D74B" : "#AEAEB2"
                                    font.pixelSize: 10
                                }
                            }

                            MouseArea {
                                id: btDevM
                                anchors.fill: parent
                                z: 5
                                hoverEnabled: true
                                cursorShape: Qt.PointingHandCursor
                                onClicked: root.toggleBtDevice(modelData.mac, modelData.connected)
                            }
                        }
                    }
                }

                Text {
                    width: 290
                    horizontalAlignment: Text.AlignHCenter
                    text: "Bluetooth dimatikan. Aktifkan sakelar di atas untuk memindai perangkat."
                    color: "#8E8E93"
                    font.pixelSize: 11
                    wrapMode: Text.WordWrap
                    visible: !root.btEnabled
                }
            }
        }

        // ── 4G. POPUP FULL MUSIC PLAYER (KLIK KAPSUL TENGAH) ────────────
        Rectangle {
            id: musicFullCard
            z: 10
            anchors.horizontalCenter: parent.horizontalCenter
            anchors.top: parent.top
            anchors.topMargin: 4
            width: 324
            height: 194
            radius: 22
            color: "transparent"
            Canvas {
                anchors.fill: parent
                z: -1
                property real dO: root.aeroOpacity
                property real dR: root.aeroReflection
                property real dF: root.glassFade
                property string dW: root.activeGlassWall
                property string dSt: root.glassStyle
                property real dTh: root.activeGlassDetail
                onDOChanged: requestPaint()
                onDRChanged: requestPaint()
                onDFChanged: requestPaint()
                onDWChanged: requestPaint()
                onDStChanged: requestPaint()
                onDThChanged: requestPaint()
                onPaint: {
                    let sw = Screen.width || 1366;
                    let sh = Screen.height || 768;
                    let pos = parent.mapToItem(null, 0, 0);
                    root.drawGlobalAeroGlass(getContext("2d"), width, height, parent.radius, pos.x, pos.y, sw, sh, false, false);
                }
            }
            border.width: 1
            border.color: "#38FFFFFF"
            visible: !root.preWarmDone || (root.activePopup === "music" || opacity > 0.01)

            MouseArea { anchors.fill: parent; z: 0 }

            property bool isOpen: root.activePopup === "music"
            property int stage: 0
            onIsOpenChanged: {
                if (isOpen) {
                    stage = 1;
                    musicStaggerTimer.restart();
                } else {
                    musicStaggerTimer.stop();
                    stage = 0;
                }
            }

            Timer {
                id: musicStaggerTimer
                interval: 34
                repeat: true
                onTriggered: {
                    if (musicFullCard.stage < 3) musicFullCard.stage++;
                    else stop();
                }
            }

            opacity: isOpen ? 1.0 : 0.0
            scale: isOpen ? 1.0 : 0.90
            transform: Translate {
                y: musicFullCard.isOpen ? 0 : -12
                Behavior on y { SpringAnimation { spring: 7.5; damping: 0.72 } }
            }
            transformOrigin: Item.Top

            Behavior on opacity { NumberAnimation { duration: 145; easing.type: Easing.InOutCubic } }
            Behavior on scale { SpringAnimation { spring: 7.5; damping: 0.72 } }

            Column {
                x: 16
                y: 14
                z: 2
                width: 292
                spacing: 12

                Row {
                    width: 292
                    spacing: 12
                    opacity: musicFullCard.stage >= 1 ? 1.0 : 0.0
                    transform: Translate {
                        y: musicFullCard.stage >= 1 ? 0 : 10
                        Behavior on y { NumberAnimation { duration: 145; easing.type: Easing.InOutCubic } }
                    }
                    Behavior on opacity { NumberAnimation { duration: 145; easing.type: Easing.InOutCubic } }

                    Rectangle {
                        width: 64; height: 64; radius: 14
                        color: "#2A2A32"; clip: true

                        Image {
                            id: fullArt
                            anchors.fill: parent
                            source: popupOverlayWin.mediaPlayer ? popupOverlayWin.mediaPlayer.trackArtUrl : ""
                            fillMode: Image.PreserveAspectCrop
                            visible: status === Image.Ready
                        }

                        Text {
                            anchors.centerIn: parent
                            text: "♫"
                            color: "#A1C6FF"
                            font.pixelSize: 24
                            visible: fullArt.status !== Image.Ready
                        }
                    }

                    Column {
                        anchors.verticalCenter: parent.verticalCenter
                        width: 214
                        spacing: 4

                        Text {
                            width: 214
                            text: (popupOverlayWin.mediaPlayer && popupOverlayWin.mediaPlayer.trackTitle)
                                  ? popupOverlayWin.mediaPlayer.trackTitle : "Not Playing"
                            color: "#F5F5F7"
                            font.pixelSize: 14
                            font.bold: true
                            elide: Text.ElideRight
                        }

                        Text {
                            width: 214
                            text: (popupOverlayWin.mediaPlayer && popupOverlayWin.mediaPlayer.trackArtist)
                                  ? popupOverlayWin.mediaPlayer.trackArtist : "MPRIS Media Player"
                            color: "#AEAEB2"
                            font.pixelSize: 11
                            elide: Text.ElideRight
                        }

                        Text {
                            width: 214
                            text: (popupOverlayWin.mediaPlayer && popupOverlayWin.mediaPlayer.identity)
                                  ? popupOverlayWin.mediaPlayer.identity : "Audio Output"
                            color: "#A1C6FF"
                            font.pixelSize: 10
                            elide: Text.ElideRight
                        }
                    }
                }

                Column {
                    width: 292
                    spacing: 5
                    opacity: musicFullCard.stage >= 2 ? 1.0 : 0.0
                    transform: Translate {
                        y: musicFullCard.stage >= 2 ? 0 : 10
                        Behavior on y { NumberAnimation { duration: 145; easing.type: Easing.InOutCubic } }
                    }
                    Behavior on opacity { NumberAnimation { duration: 145; easing.type: Easing.InOutCubic } }

                    Rectangle {
                        width: 292
                        height: 5
                        radius: 2.5
                        color: "#2CFFFFFF"

                        Rectangle {
                            width: {
                                let _ = win.tick;
                                return (popupOverlayWin.mediaPlayer && popupOverlayWin.mediaPlayer.length > 0)
                                    ? Math.min(292, 292 * (popupOverlayWin.mediaPlayer.position / popupOverlayWin.mediaPlayer.length)) : 0;
                            }
                            height: 5
                            radius: 2.5
                            color: "#A1C6FF"
                            Behavior on width { NumberAnimation { duration: 145; easing.type: Easing.InOutCubic } }
                        }
                    }

                    RowLayout {
                        width: 292
                        Text {
                            text: { let _ = win.tick; return popupOverlayWin.mediaPlayer ? win.formatTime(popupOverlayWin.mediaPlayer.position) : "0:00"; }
                            color: "#8E8E93"
                            font.pixelSize: 10
                        }
                        Item { Layout.fillWidth: true }
                        Text {
                            text: popupOverlayWin.mediaPlayer ? win.formatTime(popupOverlayWin.mediaPlayer.length) : "0:00"
                            color: "#8E8E93"
                            font.pixelSize: 10
                        }
                    }
                }

                Row {
                    anchors.horizontalCenter: parent.horizontalCenter
                    spacing: 22
                    opacity: musicFullCard.stage >= 3 ? 1.0 : 0.0
                    transform: Translate {
                        y: musicFullCard.stage >= 3 ? 0 : 10
                        Behavior on y { NumberAnimation { duration: 145; easing.type: Easing.InOutCubic } }
                    }
                    Behavior on opacity { NumberAnimation { duration: 145; easing.type: Easing.InOutCubic } }

                    Rectangle {
                        width: 38; height: 38; radius: 19
                        color: mpPrevM.containsMouse ? "#2EFFFFFF" : "#18FFFFFF"
                        Behavior on color { ColorAnimation { duration: 60 } }
                        Text { anchors.centerIn: parent; text: "|◀"; color: "#F5F5F7"; font.pixelSize: 12 }
                        MouseArea {
                            id: mpPrevM; anchors.fill: parent; z: 5; hoverEnabled: true; cursorShape: Qt.PointingHandCursor
                            onClicked: if (popupOverlayWin.mediaPlayer) popupOverlayWin.mediaPlayer.previous()
                        }
                    }

                    Rectangle {
                        width: 44; height: 44; radius: 22
                        color: "#A1C6FF"
                        scale: mpPlayM.pressed ? 0.90 : (mpPlayM.containsMouse ? 1.06 : 1.0)
                        Behavior on scale { SpringAnimation { spring: 7.5; damping: 0.72 } }
                        Text {
                            anchors.centerIn: parent
                            text: (popupOverlayWin.mediaPlayer && popupOverlayWin.mediaPlayer.isPlaying) ? "❚❚" : "▶"
                            color: "#141418"
                            font.pixelSize: 13
                            font.bold: true
                        }
                        MouseArea {
                            id: mpPlayM; anchors.fill: parent; z: 5; hoverEnabled: true; cursorShape: Qt.PointingHandCursor
                            onClicked: if (popupOverlayWin.mediaPlayer) popupOverlayWin.mediaPlayer.togglePlaying()
                        }
                    }

                    Rectangle {
                        width: 38; height: 38; radius: 19
                        color: mpNextM.containsMouse ? "#2EFFFFFF" : "#18FFFFFF"
                        Behavior on color { ColorAnimation { duration: 60 } }
                        Text { anchors.centerIn: parent; text: "▶|"; color: "#F5F5F7"; font.pixelSize: 12 }
                        MouseArea {
                            id: mpNextM; anchors.fill: parent; z: 5; hoverEnabled: true; cursorShape: Qt.PointingHandCursor
                            onClicked: if (popupOverlayWin.mediaPlayer) popupOverlayWin.mediaPlayer.next()
                        }
                    }
                }
            }
        }

        // ── 4H. POPUP KALENDER BULANAN INTERAKTIF ───────────────────────
        Rectangle {
            id: calCard
            z: 10
            anchors.right: parent.right
            anchors.top: parent.top
            anchors.topMargin: 4
            anchors.rightMargin: 10
            width: 288
            height: calCol.implicitHeight + 24
            radius: 20
            color: "transparent"
            Canvas {
                anchors.fill: parent
                z: -1
                property real dO: root.aeroOpacity
                property real dR: root.aeroReflection
                property real dF: root.glassFade
                property string dW: root.activeGlassWall
                property string dSt: root.glassStyle
                property real dTh: root.activeGlassDetail
                onDOChanged: requestPaint()
                onDRChanged: requestPaint()
                onDFChanged: requestPaint()
                onDWChanged: requestPaint()
                onDStChanged: requestPaint()
                onDThChanged: requestPaint()
                onPaint: {
                    let sw = Screen.width || 1366;
                    let sh = Screen.height || 768;
                    let pos = parent.mapToItem(null, 0, 0);
                    root.drawGlobalAeroGlass(getContext("2d"), width, height, parent.radius, pos.x, pos.y, sw, sh, false, false);
                }
            }
            border.width: 1
            border.color: "#38FFFFFF"
            visible: !root.preWarmDone || (root.activePopup === "calendar" || opacity > 0.01)

            MouseArea { anchors.fill: parent; z: 0 }

            property int viewYear: (new Date()).getFullYear()
            property int viewMonth: (new Date()).getMonth()
            property var calendarCells: []

            function rebuildCalendar() {
                let firstDay = new Date(viewYear, viewMonth, 1).getDay();
                let daysInMonth = new Date(viewYear, viewMonth + 1, 0).getDate();
                let today = new Date();
                let isCurrentMonth = (today.getFullYear() === viewYear && today.getMonth() === viewMonth);
                let todayDate = today.getDate();

                let cells = [];
                for (let i = 0; i < firstDay; i++) {
                    cells.push({ day: 0, isToday: false });
                }
                for (let d = 1; d <= daysInMonth; d++) {
                    cells.push({ day: d, isToday: isCurrentMonth && d === todayDate });
                }
                while (cells.length % 7 !== 0) {
                    cells.push({ day: 0, isToday: false });
                }
                calendarCells = cells;
            }

            function monthTitle() {
                let months = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
                return months[viewMonth] + " " + viewYear;
            }

            Component.onCompleted: rebuildCalendar()

            property bool isOpen: root.activePopup === "calendar"
            property int stage: 0
            onIsOpenChanged: {
                if (isOpen) { stage = 0; calStagger.restart(); }
                else { calStagger.stop(); stage = 0; }
            }
            Timer {
                id: calStagger
                interval: 34; repeat: true
                onTriggered: { if (calCard.stage < 3) calCard.stage++; else stop(); }
            }

            opacity: isOpen ? 1.0 : 0.0
            scale: isOpen ? 1.0 : 0.90
            transform: Translate {
                y: calCard.isOpen ? 0 : -12
                Behavior on y { SpringAnimation { spring: 7.5; damping: 0.72 } }
            }
            transformOrigin: Item.TopRight

            Behavior on opacity { NumberAnimation { duration: 170; easing.type: Easing.InOutCubic } }
            Behavior on scale { SpringAnimation { spring: 7.5; damping: 0.72 } }

            ColumnLayout {
                id: calCol
                z: 2
                anchors.left: parent.left
                anchors.right: parent.right
                anchors.top: parent.top
                anchors.margins: 14
                spacing: 10

                RowLayout {
                    Layout.fillWidth: true
                    opacity: calCard.stage >= 1 ? 1.0 : 0.0
                    transform: Translate {
                        y: calCard.stage >= 1 ? 0 : 8
                        Behavior on y { NumberAnimation { duration: 145; easing.type: Easing.InOutCubic } }
                    }
                    Behavior on opacity { NumberAnimation { duration: 145; easing.type: Easing.InOutCubic } }

                    Text { text: calCard.monthTitle(); color: "#F5F5F7"; font.pixelSize: 14; font.bold: true }
                    Item { Layout.fillWidth: true }

                    Rectangle {
                        width: 24; height: 24; radius: 12
                        color: prevMoM.containsMouse ? "#2EFFFFFF" : "#1AFFFFFF"
                        Text { anchors.centerIn: parent; text: "‹"; color: "#F5F5F7"; font.pixelSize: 14; font.bold: true }
                        MouseArea {
                            id: prevMoM; anchors.fill: parent; z: 5; hoverEnabled: true; cursorShape: Qt.PointingHandCursor
                            onClicked: {
                                if (calCard.viewMonth === 0) { calCard.viewMonth = 11; calCard.viewYear--; }
                                else calCard.viewMonth--;
                                calCard.rebuildCalendar();
                            }
                        }
                    }

                    Rectangle {
                        width: 44; height: 24; radius: 12
                        color: todayMoM.containsMouse ? "#2EFFFFFF" : "#1AFFFFFF"
                        Text { anchors.centerIn: parent; text: "Today"; color: "#F5F5F7"; font.pixelSize: 10; font.bold: true }
                        MouseArea {
                            id: todayMoM; anchors.fill: parent; z: 5; hoverEnabled: true; cursorShape: Qt.PointingHandCursor
                            onClicked: {
                                let n = new Date();
                                calCard.viewYear = n.getFullYear();
                                calCard.viewMonth = n.getMonth();
                                calCard.rebuildCalendar();
                            }
                        }
                    }

                    Rectangle {
                        width: 24; height: 24; radius: 12
                        color: nextMoM.containsMouse ? "#2EFFFFFF" : "#1AFFFFFF"
                        Text { anchors.centerIn: parent; text: "›"; color: "#F5F5F7"; font.pixelSize: 14; font.bold: true }
                        MouseArea {
                            id: nextMoM; anchors.fill: parent; z: 5; hoverEnabled: true; cursorShape: Qt.PointingHandCursor
                            onClicked: {
                                if (calCard.viewMonth === 11) { calCard.viewMonth = 0; calCard.viewYear++; }
                                else calCard.viewMonth++;
                                calCard.rebuildCalendar();
                            }
                        }
                    }
                }

                GridLayout {
                    Layout.fillWidth: true
                    columns: 7
                    columnSpacing: 4
                    rowSpacing: 4
                    opacity: calCard.stage >= 2 ? 1.0 : 0.0
                    transform: Translate {
                        y: calCard.stage >= 2 ? 0 : 8
                        Behavior on y { NumberAnimation { duration: 145; easing.type: Easing.InOutCubic } }
                    }
                    Behavior on opacity { NumberAnimation { duration: 145; easing.type: Easing.InOutCubic } }

                    Repeater {
                        model: ["S", "M", "T", "W", "T", "F", "S"]
                        Text {
                            Layout.fillWidth: true
                            horizontalAlignment: Text.AlignHCenter
                            text: modelData
                            color: index === 0 ? "#FF453A" : "#8E8E93"
                            font.pixelSize: 11
                            font.bold: true
                        }
                    }

                    Repeater {
                        model: calCard.calendarCells

                        Rectangle {
                            Layout.fillWidth: true
                            height: 28
                            radius: 14
                            color: modelData.isToday ? "#FF3B30" : "transparent"

                            Text {
                                anchors.centerIn: parent
                                text: modelData.day > 0 ? modelData.day : ""
                                color: modelData.isToday ? "#FFFFFF" : "#F5F5F7"
                                font.pixelSize: 12
                                font.weight: modelData.isToday ? Font.Bold : Font.Normal
                            }
                        }
                    }
                }

                Rectangle {
                    Layout.fillWidth: true
                    height: 32
                    radius: 10
                    color: "#1EFFFFFF"
                    opacity: calCard.stage >= 3 ? 1.0 : 0.0
                    transform: Translate {
                        y: calCard.stage >= 3 ? 0 : 8
                        Behavior on y { NumberAnimation { duration: 145; easing.type: Easing.InOutCubic } }
                    }
                    Behavior on opacity { NumberAnimation { duration: 145; easing.type: Easing.InOutCubic } }

                    RowLayout {
                        anchors.fill: parent
                        anchors.leftMargin: 10
                        anchors.rightMargin: 10

                        Text { text: "Niri 26.04 • ThinkPad AMD"; color: "#AEAEB2"; font.pixelSize: 10 }
                        Item { Layout.fillWidth: true }
                        Text { text: root.batteryPercent >= 0 ? ("BAT " + root.batteryPercent + "%") : ""; color: "#32D74B"; font.pixelSize: 10; font.bold: true }
                    }
                }
            }
        }

        // ── 4I. MACOS LAUNCHPAD & SPOTLIGHT LIQUID GLASS LAUNCHER ───────
        Process {
            id: allAppsScanProc
            command: ["python3", "-c", `
import os, glob, configparser

dirs = ['/usr/share/applications', os.path.expanduser('~/.local/share/applications'), '/var/lib/flatpak/exports/share/applications', os.path.expanduser('~/.local/share/flatpak/exports/share/applications')]
seen = set()
apps = []
for d in dirs:
    if not os.path.isdir(d): continue
    for p in sorted(glob.glob(os.path.join(d, '*.desktop'))):
        cp = configparser.ConfigParser(interpolation=None)
        try:
            cp.read(p, encoding='utf-8')
        except Exception:
            continue
        if 'Desktop Entry' not in cp: continue
        de = cp['Desktop Entry']
        if de.get('NoDisplay', 'false').lower() == 'true' or de.get('Hidden', 'false').lower() == 'true':
            continue
        if de.get('Type', 'Application') != 'Application':
            continue
        name = de.get('Name', '').strip()
        exec_cmd = de.get('Exec', '').strip()
        icon = de.get('Icon', '').strip()
        if not name or not exec_cmd or name in seen:
            continue
        seen.add(name)
        for code in ['%f', '%F', '%u', '%U', '%d', '%D', '%n', '%N', '%i', '%c', '%k', '%v', '%m']:
            exec_cmd = exec_cmd.replace(code, '')
        exec_cmd = exec_cmd.strip()
        apps.append((name, icon, exec_cmd))

apps.sort(key=lambda x: x[0].lower())
for n, ic, ex in apps:
    print(f"{n.replace('|',' ')}|{ic.replace('|','')}|{ex.replace('|',' ')}")
`]
            stdout: StdioCollector {
                onStreamFinished: {
                    let lines = text.trim().split("\n").filter(l => l.length > 0);
                    let arr = [];
                    let palette = ["#0A84FF", "#30D158", "#FF9F0A", "#5E5CE6", "#FF375F", "#64D2FF", "#BF5AF2"];
                    for (let i = 0; i < lines.length; i++) {
                        let p = lines[i].split("|");
                        if (p.length >= 3) {
                            arr.push({
                                name: p[0],
                                icon: p[1],
                                cmd: p[2],
                                bg: palette[i % palette.length],
                                glyph: p[0].slice(0, 2).toUpperCase()
                            });
                        }
                    }
                    root.allSystemApps = arr;
                }
            }
        }

        Component.onCompleted: allAppsScanProc.running = true

        Rectangle {
            id: launcherCard
            z: 15
            anchors.horizontalCenter: parent.horizontalCenter
            anchors.verticalCenter: parent.verticalCenter
            anchors.verticalCenterOffset: root.activePopup === "spotlight" ? -42 : -10
            width: root.activePopup === "spotlight" ? 560 : 720
            height: root.activePopup === "spotlight" ? 410 : 470
            radius: 26
            color: "transparent"
            Canvas {
                anchors.fill: parent
                z: -1
                property real dO: root.aeroOpacity
                property real dR: root.aeroReflection
                property real dF: root.glassFade
                property string dW: root.activeGlassWall
                property string dSt: root.glassStyle
                property real dTh: root.activeGlassDetail
                onDOChanged: requestPaint()
                onDRChanged: requestPaint()
                onDFChanged: requestPaint()
                onDWChanged: requestPaint()
                onDStChanged: requestPaint()
                onDThChanged: requestPaint()
                onPaint: {
                    let sw = Screen.width || 1366;
                    let sh = Screen.height || 768;
                    let pos = parent.mapToItem(null, 0, 0);
                    root.drawGlobalAeroGlass(getContext("2d"), width, height, parent.radius, pos.x, pos.y, sw, sh, false, false);
                }
            }
            border.width: 1
            border.color: "#3CFFFFFF"
            visible: !root.preWarmDone || ((root.activePopup === "launchpad" || root.activePopup === "spotlight") || opacity > 0.01)

            MouseArea { anchors.fill: parent; z: 0 }

            property bool isOpen: root.activePopup === "launchpad" || root.activePopup === "spotlight"
            property var filteredApps: {
                let q = root.launcherSearchText.trim().toLowerCase();
                if (q === "") return root.allSystemApps;
                return root.allSystemApps.filter(a => a.name.toLowerCase().includes(q) || a.cmd.toLowerCase().includes(q));
            }

            onIsOpenChanged: {
                if (isOpen) {
                    launcherSearchInput.text = "";
                    launcherSearchInput.forceActiveFocus();
                    if (typeof appsScanProc !== "undefined") {
                        appsScanProc.running = false;
                        appsScanProc.running = true;
                    }
                }
            }

            opacity: isOpen ? 1.0 : 0.0
            scale: isOpen ? 1.0 : 0.90
            transform: Translate {
                y: launcherCard.isOpen ? 0 : 18
                Behavior on y { SpringAnimation { spring: 7.5; damping: 0.72 } }
            }

            Behavior on opacity { NumberAnimation { duration: 170; easing.type: Easing.InOutCubic } }
            Behavior on scale { SpringAnimation { spring: 7.5; damping: 0.72 } }
            Behavior on width { NumberAnimation { duration: 145; easing.type: Easing.InOutCubic } }
            Behavior on height { NumberAnimation { duration: 145; easing.type: Easing.InOutCubic } }

            ColumnLayout {
                anchors.fill: parent
                anchors.margins: 20
                spacing: 14
                z: 2

                // Bilah Pencarian Spotlight / Launchpad
                Rectangle {
                    Layout.fillWidth: true
                    height: 44
                    radius: 14
                    color: "#26FFFFFF"
                    border.width: 1
                    border.color: launcherSearchInput.activeFocus ? "#77A1C6FF" : "#28FFFFFF"

                    RowLayout {
                        anchors.fill: parent
                        anchors.leftMargin: 14
                        anchors.rightMargin: 14
                        spacing: 10

                        Text {
                            text: "⌕"
                            color: "#AEAEB2"
                            font.pixelSize: 18
                        }

                        TextInput {
                            id: launcherSearchInput
                            Layout.fillWidth: true
                            color: "#F5F5F7"
                            font.pixelSize: 15
                            selectionColor: "#0A84FF"
                            clip: true
                            onTextChanged: root.launcherSearchText = text
                            Keys.onEscapePressed: root.closePopups()
                            Keys.onReturnPressed: {
                                if (launcherCard.filteredApps.length > 0) {
                                    let chosen = launcherCard.filteredApps[0];
                                    root.closePopups();
                                    root.runCmd(chosen.cmd);
                                }
                            }

                            Text {
                                anchors.fill: parent
                                verticalAlignment: Text.AlignVCenter
                                text: root.activePopup === "spotlight" ? "Spotlight Search — Ketik nama aplikasi..." : "Cari Aplikasi di Launchpad..."
                                color: "#8E8E93"
                                font.pixelSize: 14
                                visible: launcherSearchInput.text === ""
                            }
                        }

                        Rectangle {
                            width: 52
                            height: 22
                            radius: 6
                            color: "#22FFFFFF"
                            Text {
                                anchors.centerIn: parent
                                text: root.activePopup === "spotlight" ? "Spotlight" : "Launchpad"
                                color: "#AEAEB2"
                                font.pixelSize: 10
                                font.bold: true
                            }
                        }
                    }
                }

                // Grid Ikon Aplikasi macOS
                GridView {
                    id: appGridView
                    Layout.fillWidth: true
                    Layout.fillHeight: true
                    clip: true
                    cellWidth: Math.floor(width / (root.activePopup === "spotlight" ? 5 : 6))
                    cellHeight: 96
                    model: launcherCard.filteredApps

                    delegate: Item {
                        width: appGridView.cellWidth
                        height: appGridView.cellHeight

                        Rectangle {
                            anchors.fill: parent
                            anchors.margins: 4
                            radius: 16
                            color: gridItemM.containsMouse ? "#26FFFFFF" : "transparent"
                            scale: gridItemM.pressed ? 0.92 : (gridItemM.containsMouse ? 1.05 : 1.0)
                            Behavior on color { ColorAnimation { duration: 60 } }
                            Behavior on scale { SpringAnimation { spring: 7.5; damping: 0.72 } }

                            Column {
                                anchors.centerIn: parent
                                spacing: 6
                                width: parent.width - 8

                                Rectangle {
                                    anchors.horizontalCenter: parent.horizontalCenter
                                    width: 48
                                    height: 48
                                    radius: 12
                                    color: gridIconImg.status === Image.Ready ? "transparent" : modelData.bg

                                    Image {
                                        id: gridIconImg
                                        anchors.fill: parent
                                        source: modelData.icon !== "" ? Quickshell.iconPath(modelData.icon, true) : ""
                                        sourceSize: Qt.size(96, 96)
                                        smooth: true
                                        mipmap: true
                                        visible: status === Image.Ready
                                    }

                                    Text {
                                        anchors.centerIn: parent
                                        text: modelData.glyph
                                        color: "#FFFFFF"
                                        font.pixelSize: 16
                                        font.bold: true
                                        visible: gridIconImg.status !== Image.Ready
                                    }
                                }

                                Text {
                                    width: parent.width
                                    horizontalAlignment: Text.AlignHCenter
                                    text: modelData.name
                                    color: "#F5F5F7"
                                    font.pixelSize: 11
                                    font.weight: Font.Medium
                                    elide: Text.ElideRight
                                    maximumLineCount: 1
                                }
                            }

                            MouseArea {
                                id: gridItemM
                                anchors.fill: parent
                                hoverEnabled: true
                                cursorShape: Qt.PointingHandCursor
                                onPressed: {
                                    let targetCmd = modelData.cmd;
                                    root.closePopups();
                                    if (targetCmd && targetCmd !== "") root.runCmd(targetCmd);
                                }
                            }
                        }
                    }
                }
            }
        }

        // ── 4J. ABOUT THIS SYSTEM (CUSTOM ROM GLASS GRADIENT + LIVE SPECS) ──
        Process {
            id: sysSpecsProc
            Component.onCompleted: running = true
            command: ["python3", "-c", "import os, subprocess, socket, getpass\n\ndef read_first(paths, default=\"\"):\n    for p in paths:\n        try:\n            with open(p, \"r\", encoding=\"utf-8\") as f:\n                v = f.read().strip()\n                if v: return v\n        except Exception:\n            pass\n    return default\n\ndef run_out(cmd, default=\"\"):\n    try:\n        return subprocess.check_output(cmd, shell=True, text=True, stderr=subprocess.DEVNULL).strip() or default\n    except Exception:\n        return default\n\nos_name = \"Linux\"\ntry:\n    with open(\"/etc/os-release\", \"r\", encoding=\"utf-8\") as f:\n        for line in f:\n            if line.startswith(\"PRETTY_NAME=\"):\n                os_name = line.split(\"=\", 1)[1].strip().strip('\"')\n                break\nexcept Exception:\n    pass\n\nkernel = os.uname().release\nprod_ver = read_first([\"/sys/devices/virtual/dmi/id/product_version\"], \"\")\nprod_name = read_first([\"/sys/devices/virtual/dmi/id/product_name\"], \"\")\nif \"thinkpad\" in prod_ver.lower():\n    host_model = prod_ver\nelif prod_name and prod_name.lower() != \"to be filled by o.e.m.\":\n    host_model = prod_name\nelse:\n    host_model = socket.gethostname()\n\nuser_host = f\"{getpass.getuser()}@{socket.gethostname()}\"\n\ncpu_model = \"Processor\"\ncores = os.cpu_count() or 1\ntry:\n    with open(\"/proc/cpuinfo\", \"r\", encoding=\"utf-8\") as f:\n        for line in f:\n            if line.startswith(\"model name\"):\n                raw = line.split(\":\", 1)[1].strip()\n                for junk in [\"(R)\", \"(TM)\", \"with Radeon Graphics\", \"CPU\"]:\n                    raw = raw.replace(junk, \"\")\n                cpu_model = f\"{' '.join(raw.split())} ({cores} Threads)\"\n                break\nexcept Exception:\n    pass\n\ngpu_raw = run_out(\"lspci 2>/dev/null | grep -iE 'vga|3d|display' | head -n1 | cut -d':' -f3-\", \"Integrated Graphics\")\ngpu_model = gpu_raw.split(\"(rev\")[0].strip()\nif \"[\" in gpu_model and \"]\" in gpu_model:\n    parts = [p.split(\"]\")[0] for p in gpu_model.split(\"[\")[1:]]\n    if parts:\n        gpu_model = \"AMD \" + parts[-1] if \"amd\" in gpu_raw.lower() or \"ati\" in gpu_raw.lower() else parts[-1]\n\nmem_tot_kb = 1\nmem_avail_kb = 0\ntry:\n    with open(\"/proc/meminfo\", \"r\", encoding=\"utf-8\") as f:\n        for line in f:\n            if line.startswith(\"MemTotal:\"):\n                mem_tot_kb = int(line.split()[1])\n            elif line.startswith(\"MemAvailable:\"):\n                mem_avail_kb = int(line.split()[1])\nexcept Exception:\n    pass\nmem_used_kb = max(0, mem_tot_kb - mem_avail_kb)\nram_used = f\"{mem_used_kb / 1048576:.1f} GiB\"\nram_total = f\"{mem_tot_kb / 1048576:.1f} GiB\"\nram_pct = int(round((mem_used_kb / max(1, mem_tot_kb)) * 100))\n\ndf_out = run_out(\"df -BG --output=used,size,pcent / | tail -n1\", \"0G 0G 0%\").split()\ndisk_used = df_out[0].replace(\"G\", \" GB\") if len(df_out) >= 1 else \"0 GB\"\ndisk_total = df_out[1].replace(\"G\", \" GB\") if len(df_out) >= 2 else \"0 GB\"\ndisk_pct = int(df_out[2].replace(\"%\", \"\")) if len(df_out) >= 3 and df_out[2].replace(\"%\", \"\").isdigit() else 0\n\ndisp = run_out(\"niri msg outputs 2>/dev/null | grep -E 'Current mode:' | head -n1 | sed 's/.*Current mode: //'\", \"\")\nif not disp:\n    disp = read_first([\"/sys/class/drm/card0-eDP-1/modes\", \"/sys/class/drm/card1-eDP-1/modes\"], \"1920x1080\").splitlines()[0]\n\nup_str = run_out(\"uptime -p 2>/dev/null | sed 's/^up //'\", \"-\")\nwm_ver = run_out(\"niri --version 2>/dev/null | awk '{print $1\" \"$2}'\", \"Niri Wayland\")\nqs_ver = run_out(\"qs --version 2>/dev/null | head -n1\", \"Quickshell\")\n\nfields = [os_name, kernel, host_model, user_host, cpu_model, gpu_model, ram_used, ram_total, str(ram_pct), disk_used, disk_total, str(disk_pct), disp, up_str, wm_ver, qs_ver]\nprint(\"|\".join(x.replace(\"|\", \" \") for x in fields))"]
            stdout: StdioCollector {
                onStreamFinished: {
                    let p = text.trim().split("|");
                    if (p.length >= 16) {
                        root.sysSpecs = {
                            osName: p[0],
                            kernel: p[1],
                            hostModel: p[2],
                            userHost: p[3],
                            cpuModel: p[4],
                            gpuModel: p[5],
                            ramUsed: p[6],
                            ramTotal: p[7],
                            ramPct: parseInt(p[8]) || 0,
                            diskUsed: p[9],
                            diskTotal: p[10],
                            diskPct: parseInt(p[11]) || 0,
                            displayInfo: p[12],
                            uptimeStr: p[13],
                            wmVer: p[14],
                            shellVer: p[15]
                        };
                    }
                }
            }
        }


        Timer {
            id: copiedToastTimer
            interval: 1800
            repeat: false
            onTriggered: root.copiedBannerMsg = ""
        }

        Rectangle {
            id: aboutCard
            z: 16
            anchors.centerIn: parent
            width: 760
            height: 468
            radius: 28
            color: "#9E12131B"
            border.width: 1
            border.color: "#44FFFFFF"
            clip: true
            visible: !root.preWarmDone || (root.activePopup === "about" || opacity > 0.01)

            MouseArea { anchors.fill: parent; z: 0 }

            // Lapisan Windows 7 Aero + iOS Liquid Glass Real-Time
            Canvas {
                anchors.fill: parent
                z: 0
                property real dO: root.aeroOpacity
                property real dR: root.aeroReflection
                property real dF: root.glassFade
                property string dW: root.activeGlassWall
                property string dSt: root.glassStyle
                property real dTh: root.activeGlassDetail
                onDOChanged: requestPaint()
                onDRChanged: requestPaint()
                onDFChanged: requestPaint()
                onDWChanged: requestPaint()
                onDStChanged: requestPaint()
                onDThChanged: requestPaint()
                onPaint: {
                    let sw = Screen.width || 1366;
                    let sh = Screen.height || 768;
                    root.drawGlobalAeroGlass(getContext("2d"), width, height, 28, (sw - width) * 0.5, (sh - height) * 0.5, sw, sh, false, false);
                }
            }

            // Specular highlight atas ala Liquid Glass
            Rectangle {
                anchors.top: parent.top
                anchors.left: parent.left
                anchors.right: parent.right
                anchors.topMargin: 1
                anchors.leftMargin: 22
                anchors.rightMargin: 22
                height: 1
                color: "#38FFFFFF"
            }

            property bool isOpen: root.activePopup === "about"
            property int stage: 0

            onIsOpenChanged: {
                if (isOpen) {
                    root.copiedBannerMsg = "";
                    sysSpecsProc.running = false;
                    sysSpecsProc.running = true;
                    stage = 1;
                    aboutStaggerTimer.restart();
                    aboutKeyCatcher.forceActiveFocus();
                } else {
                    aboutStaggerTimer.stop();
                    stage = 0;
                }
            }

            Timer {
                id: aboutStaggerTimer
                interval: 34
                repeat: true
                onTriggered: {
                    if (aboutCard.stage < 6) aboutCard.stage++;
                    else stop();
                }
            }

            Item {
                id: aboutKeyCatcher
                focus: aboutCard.isOpen
                Keys.onEscapePressed: root.closePopups()
            }

            opacity: isOpen ? 1.0 : 0.0
            scale: isOpen ? 1.0 : 0.90
            transform: Translate {
                y: aboutCard.isOpen ? 0 : 14
                Behavior on y { SpringAnimation { spring: 7.5; damping: 0.72 } }
            }

            Behavior on opacity { NumberAnimation { duration: 145; easing.type: Easing.InOutCubic } }
            Behavior on scale { SpringAnimation { spring: 7.5; damping: 0.72 } }

            ColumnLayout {
                anchors.fill: parent
                anchors.margins: 20
                spacing: 14
                z: 2

                // ── TOP BAR JENDELA ─────────────────────────────────────
                RowLayout {
                    Layout.fillWidth: true
                    spacing: 10

                    Row {
                        spacing: 7
                        Rectangle {
                            width: 12; height: 12; radius: 6
                            color: closeAboutM.containsMouse ? "#FF3B30" : "#FF5F56"
                            Text {
                                anchors.centerIn: parent
                                text: "×"
                                color: "#4D0000"
                                font.pixelSize: 10
                                font.bold: true
                                visible: closeAboutM.containsMouse
                            }
                            MouseArea {
                                id: closeAboutM
                                anchors.fill: parent
                                hoverEnabled: true
                                cursorShape: Qt.PointingHandCursor
                                onClicked: root.closePopups()
                            }
                        }
                        Rectangle { width: 12; height: 12; radius: 6; color: "#FFBD2E" }
                        Rectangle { width: 12; height: 12; radius: 6; color: "#27C93F" }
                    }

                    Item { width: 6 }

                    Text {
                        text: "About System"
                        color: "#F5F5F7"
                        font.pixelSize: 15
                        font.bold: true
                    }

                    Rectangle {
                        height: 21
                        width: badgeRomTxt.implicitWidth + 14
                        radius: 10.5
                        color: "#2EFFFFFF"
                        border.width: 1
                        border.color: "#44FFFFFF"
                        Text {
                            id: badgeRomTxt
                            anchors.centerIn: parent
                            text: "Kairo 26.04"
                            color: "#FFFFFF"
                            font.pixelSize: 10
                            font.bold: true
                        }
                    }

                    Item { Layout.fillWidth: true }

                    // Toast notifikasi saat baris spesifikasi disalin
                    Rectangle {
                        height: 24
                        width: toastTxt.implicitWidth + 16
                        radius: 12
                        color: "#4432D74B"
                        border.width: 1
                        border.color: "#7732D74B"
                        visible: root.copiedBannerMsg !== ""
                        Text {
                            id: toastTxt
                            anchors.centerIn: parent
                            text: root.copiedBannerMsg
                            color: "#E5FFE9"
                            font.pixelSize: 10
                            font.bold: true
                        }
                    }

                    // Tombol Copy All Specs
                    Rectangle {
                        height: 26
                        width: copyAllTxt.implicitWidth + 18
                        radius: 13
                        color: copyAllM.containsMouse ? "#38FFFFFF" : "#22FFFFFF"
                        border.width: 1
                        border.color: "#36FFFFFF"
                        Behavior on color { ColorAnimation { duration: 60 } }

                        Text {
                            id: copyAllTxt
                            anchors.centerIn: parent
                            text: "Copy All Specs"
                            color: "#F5F5F7"
                            font.pixelSize: 11
                            font.weight: Font.Medium
                        }

                        MouseArea {
                            id: copyAllM
                            anchors.fill: parent
                            hoverEnabled: true
                            cursorShape: Qt.PointingHandCursor
                            onClicked: {
                                let s = root.sysSpecs;
                                let summary = "Device: " + s.hostModel + " (" + s.userHost + ")\n"
                                            + "OS: " + s.osName + " | Kernel: " + s.kernel + "\n"
                                            + "Shell: " + s.wmVer + " + " + s.shellVer + "\n"
                                            + "CPU: " + s.cpuModel + "\n"
                                            + "GPU: " + s.gpuModel + " (" + s.displayInfo + ")\n"
                                            + "RAM: " + s.ramUsed + " / " + s.ramTotal + "\n"
                                            + "Disk: " + s.diskUsed + " / " + s.diskTotal;
                                root.runCmd("printf \'%s\' \"" + summary.replace(/"/g, "\'") + "\" | wl-copy");
                                root.copiedBannerMsg = "All Specs Copied ✓";
                                copiedToastTimer.restart();
                            }
                        }
                    }
                }

                // ── BODY: KIRI HERO BANNER WALLPAPER | KANAN CUSTOM ROM LIST ──
                RowLayout {
                    Layout.fillWidth: true
                    Layout.fillHeight: true
                    spacing: 18

                    // KOLOM KIRI: BANNER WALLPAPER ALA CUSTOM ROM HP
                    ColumnLayout {
                        Layout.preferredWidth: 284
                        Layout.fillHeight: true
                        spacing: 9

                        opacity: aboutCard.stage >= 1 ? 1.0 : 0.0
                        transform: Translate {
                            y: aboutCard.stage >= 1 ? 0 : 12
                            Behavior on y { SpringAnimation { spring: 7.5; damping: 0.72 } }
                        }
                        Behavior on opacity { NumberAnimation { duration: 145; easing.type: Easing.InOutCubic } }

                        Rectangle {
                            id: romHeroBanner
                            Layout.fillWidth: true
                            Layout.fillHeight: true
                            radius: 22
                            color: "#22222C"
                            border.width: 1
                            border.color: "#44FFFFFF"
                            clip: true
                            scale: bannerM.pressed ? 0.97 : 1.0
                            Behavior on scale { SpringAnimation { spring: 7.5; damping: 0.72 } }

                            Image {
                                id: bannerWallpaperImg
                                anchors.fill: parent
                                source: root.currentWallpaper
                                fillMode: Image.PreserveAspectCrop
                                smooth: true
                                mipmap: true
                                visible: status === Image.Ready
                            }

                            Rectangle {
                                anchors.fill: parent
                                gradient: Gradient {
                                    GradientStop { position: 0.0; color: "#28000000" }
                                    GradientStop { position: 0.55; color: "#44000000" }
                                    GradientStop { position: 1.0; color: "#88000000" }
                                }
                            }

                            // Ikon refresh wallpaper di sudut kanan atas banner
                            Rectangle {
                                anchors.top: parent.top
                                anchors.right: parent.right
                                anchors.margins: 12
                                width: 28
                                height: 28
                                radius: 14
                                color: bannerM.containsMouse ? "#66FFFFFF" : "#34000000"
                                border.width: 1
                                border.color: "#44FFFFFF"

                                Text {
                                    anchors.centerIn: parent
                                    text: "↻"
                                    color: "#FFFFFF"
                                    font.pixelSize: 13
                                    font.bold: true
                                }
                            }

                            // Judul Tengah "KAIRO DESKTOP"
                            Item {
                                anchors.centerIn: parent
                                anchors.verticalCenterOffset: -8
                                width: parent.width - 20
                                height: 46

                                Text {
                                    anchors.centerIn: parent
                                    anchors.verticalCenterOffset: 2
                                    text: "KAIRO DESKTOP"
                                    color: "#A6000000"
                                    font.pixelSize: 24
                                    font.weight: Font.Black
                                    font.letterSpacing: 1
                                }

                                Text {
                                    anchors.centerIn: parent
                                    text: "KAIRO DESKTOP"
                                    color: "#FFFFFF"
                                    font.pixelSize: 24
                                    font.weight: Font.Black
                                    font.letterSpacing: 1
                                }
                            }

                            // Pill Bawah Banner
                            Rectangle {
                                anchors.bottom: parent.bottom
                                anchors.horizontalCenter: parent.horizontalCenter
                                anchors.bottomMargin: 16
                                width: parent.width - 24
                                height: 29
                                radius: 14.5
                                color: "#78141210"
                                border.width: 1
                                border.color: "#40FFFFFF"

                                Text {
                                    anchors.centerIn: parent
                                    text: "FLUID TILING • GLASS EXPERIENCE"
                                    color: "#F5F5F7"
                                    font.pixelSize: 9
                                    font.bold: true
                                    elide: Text.ElideRight
                                    width: parent.width - 14
                                    horizontalAlignment: Text.AlignHCenter
                                }
                            }

                            MouseArea {
                                id: bannerM
                                anchors.fill: parent
                                hoverEnabled: true
                                cursorShape: Qt.PointingHandCursor
                                onClicked: root.pickRandomWallpaper()
                            }
                        }

                        // Kartu Developer / Maintainer ala Custom ROM
                        Rectangle {
                            Layout.fillWidth: true
                            height: 54
                            radius: 16
                            color: devCardM.containsMouse ? "#661C1E2B" : "#5214151E"
                            border.width: 1
                            border.color: "#36FFFFFF"
                            Behavior on color { ColorAnimation { duration: 60 } }

                            RowLayout {
                                anchors.fill: parent
                                anchors.leftMargin: 10
                                anchors.rightMargin: 12
                                spacing: 10

                                // Avatar Bulat dengan Inisial
                                Rectangle {
                                    width: 34
                                    height: 34
                                    radius: 17
                                    gradient: Gradient {
                                        GradientStop { position: 0.0; color: "#0A84FF" }
                                        GradientStop { position: 1.0; color: "#BF5AF2" }
                                    }

                                    Text {
                                        anchors.centerIn: parent
                                        text: "AR"
                                        color: "#FFFFFF"
                                        font.pixelSize: 12
                                        font.bold: true
                                    }
                                }

                                // Nama Developer & Role
                                ColumnLayout {
                                    Layout.fillWidth: true
                                    spacing: 1

                                    Text {
                                        text: "Arip"
                                        color: "#FFFFFF"
                                        font.pixelSize: 12
                                        font.bold: true
                                        elide: Text.ElideRight
                                        Layout.fillWidth: true
                                    }

                                    Text {
                                        text: "Developer • Up " + root.sysSpecs.uptimeStr
                                        color: "#C7C7CC"
                                        font.pixelSize: 10
                                        elide: Text.ElideRight
                                        Layout.fillWidth: true
                                    }
                                }

                                Rectangle {
                                    height: 20
                                    width: devBadgeTxt.implicitWidth + 12
                                    radius: 10
                                    color: "#26A1C6FF"
                                    border.width: 1
                                    border.color: "#44A1C6FF"

                                    Text {
                                        id: devBadgeTxt
                                        anchors.centerIn: parent
                                        text: "DEV"
                                        color: "#A1C6FF"
                                        font.pixelSize: 9
                                        font.bold: true
                                    }
                                }
                            }

                            MouseArea {
                                id: devCardM
                                anchors.fill: parent
                                hoverEnabled: true
                                cursorShape: Qt.PointingHandCursor
                                onClicked: root.pickRandomWallpaper()
                            }
                        }
                    }

                    // KOLOM KANAN: DAFTAR KARTU SPESIFIKASI ALA CUSTOM ROM HP
                    ColumnLayout {
                        Layout.fillWidth: true
                        Layout.fillHeight: true
                        spacing: 10

                        // Subheader ala ROM HP
                        Text {
                            Layout.fillWidth: true
                            text: "System & hardware specifications — click any row to copy"
                            color: "#D1D1D6"
                            font.pixelSize: 11
                            opacity: aboutCard.stage >= 1 ? 1.0 : 0.0
                            Behavior on opacity { NumberAnimation { duration: 145; easing.type: Easing.InOutCubic } }
                        }

                        // Container Kartu Utama Transparan
                        Rectangle {
                            Layout.fillWidth: true
                            Layout.fillHeight: true
                            radius: 22
                            color: "#5214151E"
                            border.width: 1
                            border.color: "#36FFFFFF"

                            ColumnLayout {
                                anchors.fill: parent
                                anchors.margins: 12
                                spacing: 6

                                // BARIS 1: DEVICE & HOST
                                Rectangle {
                                    Layout.fillWidth: true
                                    Layout.fillHeight: true
                                    radius: 13
                                    color: row1M.containsMouse ? "#26FFFFFF" : "transparent"
                                    opacity: aboutCard.stage >= 2 ? 1.0 : 0.0
                                    Behavior on color { ColorAnimation { duration: 60 } }
                                    Behavior on opacity { NumberAnimation { duration: 145; easing.type: Easing.InOutCubic } }

                                    RowLayout {
                                        anchors.fill: parent
                                        anchors.leftMargin: 8
                                        anchors.rightMargin: 10
                                        spacing: 12

                                        Rectangle {
                                            width: 36; height: 36; radius: 12; color: "#3DF4B8E4"
                                            Text { anchors.centerIn: parent; text: "💻"; font.pixelSize: 16 }
                                        }
                                        ColumnLayout {
                                            Layout.fillWidth: true; spacing: 1
                                            Text { text: root.sysSpecs.hostModel; color: "#FFFFFF"; font.pixelSize: 13; font.bold: true; elide: Text.ElideRight; Layout.fillWidth: true }
                                            Text { text: "Host: " + root.sysSpecs.userHost; color: "#C7C7CC"; font.pixelSize: 11; elide: Text.ElideRight; Layout.fillWidth: true }
                                        }
                                        Text { text: "›"; color: "#AEAEB2"; font.pixelSize: 16; font.bold: true }
                                    }

                                    MouseArea {
                                        id: row1M; anchors.fill: parent; hoverEnabled: true; cursorShape: Qt.PointingHandCursor
                                        onClicked: {
                                            root.runCmd("printf \'%s\' \"" + root.sysSpecs.hostModel + " (" + root.sysSpecs.userHost + ")\" | wl-copy");
                                            root.copiedBannerMsg = "Device Info Copied ✓";
                                            copiedToastTimer.restart();
                                        }
                                    }
                                }

                                Rectangle { Layout.fillWidth: true; height: 1; color: "#1FFFFFFF" }

                                // BARIS 2: OS & KERNEL
                                Rectangle {
                                    Layout.fillWidth: true
                                    Layout.fillHeight: true
                                    radius: 13
                                    color: row2M.containsMouse ? "#26FFFFFF" : "transparent"
                                    opacity: aboutCard.stage >= 3 ? 1.0 : 0.0
                                    Behavior on color { ColorAnimation { duration: 60 } }
                                    Behavior on opacity { NumberAnimation { duration: 145; easing.type: Easing.InOutCubic } }

                                    RowLayout {
                                        anchors.fill: parent
                                        anchors.leftMargin: 8
                                        anchors.rightMargin: 10
                                        spacing: 12

                                        Rectangle {
                                            width: 36; height: 36; radius: 12; color: "#3D89B4FA"
                                            Text { anchors.centerIn: parent; text: "🐧"; font.pixelSize: 16 }
                                        }
                                        ColumnLayout {
                                            Layout.fillWidth: true; spacing: 1
                                            Text { text: root.sysSpecs.osName; color: "#FFFFFF"; font.pixelSize: 13; font.bold: true; elide: Text.ElideRight; Layout.fillWidth: true }
                                            Text { text: "Kernel " + root.sysSpecs.kernel; color: "#C7C7CC"; font.pixelSize: 11; elide: Text.ElideRight; Layout.fillWidth: true }
                                        }
                                        Text { text: "›"; color: "#AEAEB2"; font.pixelSize: 16; font.bold: true }
                                    }

                                    MouseArea {
                                        id: row2M; anchors.fill: parent; hoverEnabled: true; cursorShape: Qt.PointingHandCursor
                                        onClicked: {
                                            root.runCmd("printf \'%s\' \"" + root.sysSpecs.osName + " | Kernel " + root.sysSpecs.kernel + "\" | wl-copy");
                                            root.copiedBannerMsg = "OS & Kernel Copied ✓";
                                            copiedToastTimer.restart();
                                        }
                                    }
                                }

                                Rectangle { Layout.fillWidth: true; height: 1; color: "#1FFFFFFF" }

                                // BARIS 3: COMPOSITOR & SHELL
                                Rectangle {
                                    Layout.fillWidth: true
                                    Layout.fillHeight: true
                                    radius: 13
                                    color: row3M.containsMouse ? "#26FFFFFF" : "transparent"
                                    opacity: aboutCard.stage >= 4 ? 1.0 : 0.0
                                    Behavior on color { ColorAnimation { duration: 60 } }
                                    Behavior on opacity { NumberAnimation { duration: 145; easing.type: Easing.InOutCubic } }

                                    RowLayout {
                                        anchors.fill: parent
                                        anchors.leftMargin: 8
                                        anchors.rightMargin: 10
                                        spacing: 12

                                        Rectangle {
                                            width: 36; height: 36; radius: 12; color: "#3DA6E3A1"
                                            Text { anchors.centerIn: parent; text: "✦"; color: "#A6E3A1"; font.pixelSize: 16; font.bold: true }
                                        }
                                        ColumnLayout {
                                            Layout.fillWidth: true; spacing: 1
                                            Text { text: root.sysSpecs.wmVer + " • " + root.sysSpecs.shellVer; color: "#FFFFFF"; font.pixelSize: 13; font.bold: true; elide: Text.ElideRight; Layout.fillWidth: true }
                                            Text { text: "Wayland Custom Desktop Shell"; color: "#C7C7CC"; font.pixelSize: 11; elide: Text.ElideRight; Layout.fillWidth: true }
                                        }
                                        Text { text: "›"; color: "#AEAEB2"; font.pixelSize: 16; font.bold: true }
                                    }

                                    MouseArea {
                                        id: row3M; anchors.fill: parent; hoverEnabled: true; cursorShape: Qt.PointingHandCursor
                                        onClicked: {
                                            root.runCmd("printf \'%s\' \"" + root.sysSpecs.wmVer + " + " + root.sysSpecs.shellVer + "\" | wl-copy");
                                            root.copiedBannerMsg = "Shell Info Copied ✓";
                                            copiedToastTimer.restart();
                                        }
                                    }
                                }

                                Rectangle { Layout.fillWidth: true; height: 1; color: "#1FFFFFFF" }

                                // BARIS 4: PROCESSOR & GRAPHICS
                                Rectangle {
                                    Layout.fillWidth: true
                                    Layout.fillHeight: true
                                    radius: 13
                                    color: row4M.containsMouse ? "#26FFFFFF" : "transparent"
                                    opacity: aboutCard.stage >= 5 ? 1.0 : 0.0
                                    Behavior on color { ColorAnimation { duration: 60 } }
                                    Behavior on opacity { NumberAnimation { duration: 145; easing.type: Easing.InOutCubic } }

                                    RowLayout {
                                        anchors.fill: parent
                                        anchors.leftMargin: 8
                                        anchors.rightMargin: 10
                                        spacing: 12

                                        Rectangle {
                                            width: 36; height: 36; radius: 12; color: "#3DCBA6F7"
                                            Text { anchors.centerIn: parent; text: "⚙"; color: "#CBA6F7"; font.pixelSize: 17; font.bold: true }
                                        }
                                        ColumnLayout {
                                            Layout.fillWidth: true; spacing: 1
                                            Text { text: root.sysSpecs.cpuModel; color: "#FFFFFF"; font.pixelSize: 12; font.bold: true; elide: Text.ElideRight; Layout.fillWidth: true }
                                            Text { text: root.sysSpecs.gpuModel + " (" + root.sysSpecs.displayInfo + ")"; color: "#C7C7CC"; font.pixelSize: 11; elide: Text.ElideRight; Layout.fillWidth: true }
                                        }
                                        Text { text: "›"; color: "#AEAEB2"; font.pixelSize: 16; font.bold: true }
                                    }

                                    MouseArea {
                                        id: row4M; anchors.fill: parent; hoverEnabled: true; cursorShape: Qt.PointingHandCursor
                                        onClicked: {
                                            root.runCmd("printf \'%s\' \"" + root.sysSpecs.cpuModel + " | " + root.sysSpecs.gpuModel + "\" | wl-copy");
                                            root.copiedBannerMsg = "CPU & GPU Copied ✓";
                                            copiedToastTimer.restart();
                                        }
                                    }
                                }

                                Rectangle { Layout.fillWidth: true; height: 1; color: "#1FFFFFFF" }

                                // BARIS 5: MEMORY & STORAGE
                                Rectangle {
                                    Layout.fillWidth: true
                                    Layout.fillHeight: true
                                    radius: 13
                                    color: row5M.containsMouse ? "#26FFFFFF" : "transparent"
                                    opacity: aboutCard.stage >= 6 ? 1.0 : 0.0
                                    Behavior on color { ColorAnimation { duration: 60 } }
                                    Behavior on opacity { NumberAnimation { duration: 145; easing.type: Easing.InOutCubic } }

                                    RowLayout {
                                        anchors.fill: parent
                                        anchors.leftMargin: 8
                                        anchors.rightMargin: 10
                                        spacing: 12

                                        Rectangle {
                                            width: 36; height: 36; radius: 12; color: "#3D94E2D5"
                                            Text { anchors.centerIn: parent; text: "▤"; color: "#94E2D5"; font.pixelSize: 15; font.bold: true }
                                        }
                                        ColumnLayout {
                                            Layout.fillWidth: true; spacing: 4
                                            RowLayout {
                                                Layout.fillWidth: true
                                                Text { text: "RAM " + root.sysSpecs.ramUsed + " / " + root.sysSpecs.ramTotal; color: "#FFFFFF"; font.pixelSize: 12; font.bold: true }
                                                Item { Layout.fillWidth: true }
                                                Text { text: "Disk " + root.sysSpecs.diskUsed + " / " + root.sysSpecs.diskTotal; color: "#C7C7CC"; font.pixelSize: 11 }
                                            }
                                            Rectangle {
                                                Layout.fillWidth: true
                                                height: 5
                                                radius: 2.5
                                                color: "#33FFFFFF"
                                                Rectangle {
                                                    width: Math.min(parent.width, parent.width * (root.sysSpecs.ramPct / 100))
                                                    height: 5
                                                    radius: 2.5
                                                    color: "#94E2D5"
                                                    Behavior on width { NumberAnimation { duration: 145; easing.type: Easing.InOutCubic } }
                                                }
                                            }
                                        }
                                        Text { text: "›"; color: "#AEAEB2"; font.pixelSize: 16; font.bold: true }
                                    }

                                    MouseArea {
                                        id: row5M; anchors.fill: parent; hoverEnabled: true; cursorShape: Qt.PointingHandCursor
                                        onClicked: {
                                            root.runCmd("printf \'%s\' \"RAM " + root.sysSpecs.ramUsed + "/" + root.sysSpecs.ramTotal + " | Disk " + root.sysSpecs.diskUsed + "/" + root.sysSpecs.diskTotal + "\" | wl-copy");
                                            root.copiedBannerMsg = "Memory & Disk Copied ✓";
                                            copiedToastTimer.restart();
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // ── 4K. KAIRO SYSTEM SETTINGS (HARMONYOS LIQUID GLASS PILLS & ORBS) ──
        Process {
            id: settingsExtraProc
            Component.onCompleted: running = true
            command: ["sh", "-c", "ip_addr=$(hostname -I 2>/dev/null | awk '{print $1}'); [ -z \"$ip_addr\" ] && ip_addr='Offline'; pprof=$(powerprofilesctl get 2>/dev/null || echo 'balanced'); printf '%s|%s\n' \"$ip_addr\" \"$pprof\""]
            stdout: StdioCollector {
                onStreamFinished: {
                    let p = text.trim().split("|");
                    if (p.length >= 2) {
                        root.localIpAddr = p[0];
                        root.powerProfile = p[1];
                    }
                }
            }
        }

        function setPowerProfile(prof) {
            root.powerProfile = prof;
            root.runCmd("powerprofilesctl set " + prof + " 2>/dev/null || true");
        }

        Rectangle {
            id: settingsCard
            z: 17
            anchors.centerIn: parent
            width: 840
            height: 628
            radius: 36
            color: "#A612141E"
            border.width: 1.2
            border.color: "#4CFFFFFF"
            clip: true
            visible: !root.preWarmDone || (root.activePopup === "settings" || opacity > 0.01)

            MouseArea { anchors.fill: parent; z: 0 }

            // Lapisan Windows 7 Aero + iOS Liquid Glass Real-Time
            Canvas {
                anchors.fill: parent
                z: 0
                property real dO: root.aeroOpacity
                property real dR: root.aeroReflection
                property real dF: root.glassFade
                property string dW: root.activeGlassWall
                property string dSt: root.glassStyle
                property real dTh: root.activeGlassDetail
                onDOChanged: requestPaint()
                onDRChanged: requestPaint()
                onDFChanged: requestPaint()
                onDWChanged: requestPaint()
                onDStChanged: requestPaint()
                onDThChanged: requestPaint()
                onPaint: {
                    let sw = Screen.width || 1366;
                    let sh = Screen.height || 768;
                    root.drawGlobalAeroGlass(getContext("2d"), width, height, 36, (sw - width) * 0.5, (sh - height) * 0.5, sw, sh, false, false);
                }
            }

            // Inner Specular Rim Kaca
            Rectangle {
                anchors.fill: parent
                anchors.margins: 1
                radius: 35
                color: "transparent"
                border.width: 1
                border.color: "#28FFFFFF"
            }

            property bool isOpen: root.activePopup === "settings"
            property int stage: 0

            onIsOpenChanged: {
                if (isOpen) {
                    stage = 1;
                    settingsStaggerTimer.restart();
                    settingsKeyCatcher.forceActiveFocus();
                } else {
                    settingsStaggerTimer.stop();
                    stage = 0;
                }
            }

            Timer {
                id: settingsStaggerTimer
                interval: 34
                repeat: true
                onTriggered: {
                    if (settingsCard.stage < 6) settingsCard.stage++;
                    else stop();
                }
            }

            Item {
                id: settingsKeyCatcher
                focus: settingsCard.isOpen && !setSearchInput.activeFocus && !setWifiPassField.activeFocus
                Keys.onEscapePressed: root.closePopups()
            }

            opacity: isOpen ? 1.0 : 0.0
            scale: isOpen ? 1.0 : 0.90
            transform: Translate {
                y: settingsCard.isOpen ? 0 : 16
                Behavior on y { SpringAnimation { spring: 7.5; damping: 0.72 } }
            }

            Behavior on opacity { NumberAnimation { duration: 145; easing.type: Easing.InOutCubic } }
            Behavior on scale { SpringAnimation { spring: 7.5; damping: 0.72 } }

            RowLayout {
                anchors.fill: parent
                anchors.margins: 18
                spacing: 16
                z: 2

                // ── SIDEBAR KIRI (KAPSUL LONJONG HARMONYOS) ───────────────
                Rectangle {
                    Layout.preferredWidth: 236
                    Layout.fillHeight: true
                    radius: 28
                    color: "#44141724"
                    border.width: 1
                    border.color: "#36FFFFFF"

                    ColumnLayout {
                        anchors.fill: parent
                        anchors.margins: 12
                        spacing: 10

                        // Header Traffic Light + Title
                        RowLayout {
                            Layout.fillWidth: true
                            Layout.leftMargin: 4
                            spacing: 8

                            Row {
                                spacing: 7
                                Rectangle {
                                    width: 12; height: 12; radius: 6
                                    color: closeSetM.containsMouse ? "#FF3B30" : "#FF5F56"
                                    Text {
                                        anchors.centerIn: parent
                                        text: "×"
                                        color: "#4D0000"
                                        font.pixelSize: 10
                                        font.bold: true
                                        visible: closeSetM.containsMouse
                                    }
                                    MouseArea {
                                        id: closeSetM
                                        anchors.fill: parent
                                        hoverEnabled: true
                                        cursorShape: Qt.PointingHandCursor
                                        onClicked: root.closePopups()
                                    }
                                }
                                Rectangle { width: 12; height: 12; radius: 6; color: "#FFBD2E" }
                                Rectangle { width: 12; height: 12; radius: 6; color: "#27C93F" }
                            }

                            Item { width: 4 }

                            Text {
                                text: "Settings"
                                color: "#FFFFFF"
                                font.pixelSize: 15
                                font.bold: true
                            }
                        }

                        // Kartu Profil User Pill Lonjong
                        Rectangle {
                            Layout.fillWidth: true
                            height: 54
                            radius: 27
                            border.width: 1.1
                            border.color: profilePillM.containsMouse ? "#58FFFFFF" : "#34FFFFFF"
                            gradient: Gradient {
                                GradientStop { position: 0.0; color: "#32FFFFFF" }
                                GradientStop { position: 1.0; color: "#14FFFFFF" }
                            }

                            RowLayout {
                                anchors.fill: parent
                                anchors.leftMargin: 8
                                anchors.rightMargin: 12
                                spacing: 10

                                Rectangle {
                                    width: 38; height: 38; radius: 19
                                    gradient: Gradient {
                                        GradientStop { position: 0.0; color: "#2E94FF" }
                                        GradientStop { position: 1.0; color: "#BF5AF2" }
                                    }
                                    Text {
                                        anchors.centerIn: parent
                                        text: "AR"
                                        color: "#FFFFFF"
                                        font.pixelSize: 13
                                        font.bold: true
                                    }
                                }

                                ColumnLayout {
                                    Layout.fillWidth: true
                                    spacing: 1
                                    Text {
                                        text: "Arip"
                                        color: "#FFFFFF"
                                        font.pixelSize: 12
                                        font.bold: true
                                        elide: Text.ElideRight
                                        Layout.fillWidth: true
                                    }
                                    Text {
                                        text: "Kairo 26.04 • L14"
                                        color: "#C7C7CC"
                                        font.pixelSize: 10
                                        elide: Text.ElideRight
                                        Layout.fillWidth: true
                                    }
                                }

                                Text { text: "›"; color: "#AEAEB2"; font.pixelSize: 15; font.bold: true }
                            }

                            MouseArea {
                                id: profilePillM
                                anchors.fill: parent
                                hoverEnabled: true
                                cursorShape: Qt.PointingHandCursor
                                onPressed: root.switchPopup("about")
                            }
                        }

                        // Search Pill Lonjong
                        Rectangle {
                            Layout.fillWidth: true
                            height: 36
                            radius: 18
                            color: "#22FFFFFF"
                            border.width: 1
                            border.color: setSearchInput.activeFocus ? "#77A1C6FF" : "#2EFFFFFF"

                            RowLayout {
                                anchors.fill: parent
                                anchors.leftMargin: 12
                                anchors.rightMargin: 12
                                spacing: 6

                                Text { text: "⌕"; color: "#AEAEB2"; font.pixelSize: 14 }

                                TextInput {
                                    id: setSearchInput
                                    Layout.fillWidth: true
                                    color: "#FFFFFF"
                                    font.pixelSize: 12
                                    clip: true
                                    onTextChanged: {
                                        root.settingsSearch = text;
                                        let q = text.trim().toLowerCase();
                                        if (q.includes("wifi") || q.includes("net") || q.includes("ip")) root.settingsTab = "wifi";
                                        else if (q.includes("blue") || q.includes("bt")) root.settingsTab = "bluetooth";
                                        else if (q.includes("bright") || q.includes("sound") || q.includes("vol") || q.includes("layar")) root.settingsTab = "display_sound";
                                        else if (q.includes("wall") || q.includes("dock") || q.includes("widget") || q.includes("kairo")) root.settingsTab = "appearance";
                                        else if (q.includes("bat") || q.includes("power") || q.includes("daya") || q.includes("about")) root.settingsTab = "power";
                                    }
                                    Keys.onEscapePressed: root.closePopups()

                                    Text {
                                        anchors.fill: parent
                                        verticalAlignment: Text.AlignVCenter
                                        text: "Cari pengaturan..."
                                        color: "#8E8E93"
                                        font.pixelSize: 11
                                        visible: setSearchInput.text === ""
                                    }
                                }
                            }
                        }

                        // Daftar Kategori Kapsul Lonjong
                        ColumnLayout {
                            Layout.fillWidth: true
                            spacing: 7

                            Repeater {
                                model: [
                                    { id: "appearance", title: "Kairo & Wallpaper", sub: "Preview, Dock, Widget", glyph: "✦" },
                                    { id: "display_sound", title: "Display & Sound", sub: "Brightness, Volume, Focus", glyph: "☀" },
                                    { id: "wifi", title: "Wi-Fi & Network", sub: root.wifiConnected ? root.wifiName : "Terputus", glyph: "ᯤ" },
                                    { id: "bluetooth", title: "Bluetooth", sub: root.btEnabled ? "Aktif" : "Mati", glyph: "ᛒ" },
                                    { id: "power", title: "Power & System", sub: root.batteryPercent >= 0 ? ("Baterai " + root.batteryPercent + "%") : "AC Power", glyph: "⚡" }
                                ]

                                Rectangle {
                                    Layout.fillWidth: true
                                    height: 44
                                    radius: 22
                                    property bool active: root.settingsTab === modelData.id
                                    border.width: 1.1
                                    border.color: active ? "#80FFFFFF" : (navPillM.containsMouse ? "#46FFFFFF" : "#22FFFFFF")
                                    scale: navPillM.pressed ? 0.96 : 1.0

                                    gradient: Gradient {
                                        GradientStop { position: 0.0; color: active ? "#D92B8EFF" : (navPillM.containsMouse ? "#2CFFFFFF" : "#18FFFFFF") }
                                        GradientStop { position: 1.0; color: active ? "#AD0866E6" : "#0DFFFFFF" }
                                    }

                                    Behavior on scale { SpringAnimation { spring: 7.5; damping: 0.72 } }

                                    RowLayout {
                                        anchors.fill: parent
                                        anchors.leftMargin: 8
                                        anchors.rightMargin: 12
                                        spacing: 10

                                        Rectangle {
                                            width: 30; height: 30; radius: 15
                                            color: active ? "#38FFFFFF" : "#24FFFFFF"
                                            border.width: 1
                                            border.color: "#36FFFFFF"
                                            Text {
                                                anchors.centerIn: parent
                                                text: modelData.glyph
                                                color: "#FFFFFF"
                                                font.pixelSize: 13
                                                font.bold: true
                                            }
                                        }

                                        ColumnLayout {
                                            Layout.fillWidth: true
                                            spacing: 0
                                            Text {
                                                text: modelData.title
                                                color: "#FFFFFF"
                                                font.pixelSize: 12
                                                font.bold: active
                                                elide: Text.ElideRight
                                                Layout.fillWidth: true
                                            }
                                            Text {
                                                text: modelData.sub
                                                color: active ? "#E5F2FF" : "#98989D"
                                                font.pixelSize: 9
                                                elide: Text.ElideRight
                                                Layout.fillWidth: true
                                            }
                                        }
                                    }

                                    MouseArea {
                                        id: navPillM
                                        anchors.fill: parent
                                        hoverEnabled: true
                                        cursorShape: Qt.PointingHandCursor
                                        onClicked: root.settingsTab = modelData.id
                                    }
                                }
                            }
                        }

                        Item { Layout.fillHeight: true }

                        // Tombol Pill About Kairo di Dasar Sidebar
                        Rectangle {
                            Layout.fillWidth: true
                            height: 36
                            radius: 18
                            color: aboutShortcutM.containsMouse ? "#2EFFFFFF" : "#1CFFFFFF"
                            border.width: 1
                            border.color: "#32FFFFFF"

                            Text {
                                anchors.centerIn: parent
                                text: "About Kairo Desktop ›"
                                color: "#E5E5EA"
                                font.pixelSize: 11
                                font.weight: Font.Medium
                            }

                            MouseArea {
                                id: aboutShortcutM
                                anchors.fill: parent
                                hoverEnabled: true
                                cursorShape: Qt.PointingHandCursor
                                onPressed: root.switchPopup("about")
                            }
                        }
                    }
                }

                // ── PANEL KANAN (HARMONYOS GLASS PILLS, ORBS & LIVE PREVIEW) ──
                Item {
                    Layout.fillWidth: true
                    Layout.fillHeight: true

                    // ========================================================
                    // TAB 1: KAIRO & WALLPAPER (OPSI 3 LIVE PREVIEW + PILLS)
                    // ========================================================
                    ColumnLayout {
                        anchors.fill: parent
                        spacing: 12
                        visible: root.settingsTab === "appearance"
                        opacity: visible ? 1.0 : 0.0
                        Behavior on opacity { NumberAnimation { duration: 145; easing.type: Easing.InOutCubic } }

                        RowLayout {
                            Layout.fillWidth: true
                            Text { text: "Kairo & Wallpaper"; color: "#FFFFFF"; font.pixelSize: 17; font.bold: true }
                            Item { Layout.fillWidth: true }

                            // Pill Next Wallpaper
                            Rectangle {
                                height: 34
                                width: nextWpPillTxt.implicitWidth + 24
                                radius: 17
                                border.width: 1.1
                                border.color: "#75FFFFFF"
                                scale: nextWpPillM.pressed ? 0.94 : 1.0
                                gradient: Gradient {
                                    GradientStop { position: 0.0; color: "#D92B8EFF" }
                                    GradientStop { position: 1.0; color: "#AD0866E6" }
                                }
                                Behavior on scale { SpringAnimation { spring: 7.5; damping: 0.72 } }

                                Text {
                                    id: nextWpPillTxt
                                    anchors.centerIn: parent
                                    text: "↻ Acak Wallpaper"
                                    color: "#FFFFFF"
                                    font.pixelSize: 11
                                    font.bold: true
                                }

                                MouseArea {
                                    id: nextWpPillM
                                    anchors.fill: parent
                                    cursorShape: Qt.PointingHandCursor
                                    onClicked: root.pickRandomWallpaper()
                                }
                            }
                        }

                        // LIVE KAIRO DESKTOP MINI-PREVIEW + KONTROL BULAT LONJONG
                        RowLayout {
                            Layout.fillWidth: true
                            height: 112
                            spacing: 12

                            // Miniatur Layar Kairo Desktop (Rounded Capsule Frame)
                            Rectangle {
                                Layout.preferredWidth: 286
                                Layout.fillHeight: true
                                radius: 26
                                color: "#1A1C28"
                                border.width: 1.2
                                border.color: "#4CFFFFFF"
                                clip: true

                                Image {
                                    anchors.fill: parent
                                    source: root.currentWallpaper
                                    fillMode: Image.PreserveAspectCrop
                                    smooth: true
                                    visible: status === Image.Ready
                                }

                                // Mini Top Bar
                                Rectangle {
                                    anchors.top: parent.top
                                    anchors.left: parent.left
                                    anchors.right: parent.right
                                    height: 14
                                    color: "#99121218"

                                    Row {
                                        anchors.left: parent.left
                                        anchors.leftMargin: 8
                                        anchors.verticalCenter: parent.verticalCenter
                                        spacing: 4
                                        Rectangle { width: 5; height: 5; radius: 2.5; color: "#FFFFFF" }
                                        Rectangle { width: 18; height: 4; radius: 2; color: "#CCFFFFFF" }
                                    }

                                    Rectangle {
                                        anchors.centerIn: parent
                                        width: 34; height: 7; radius: 3.5
                                        color: "#44FFFFFF"
                                    }
                                }

                                // Mini Desktop Widgets
                                Row {
                                    x: 12; y: 24
                                    spacing: 6
                                    Rectangle {
                                        width: 66; height: 84; radius: 11
                                        color: "#CC18181E"; border.width: 1; border.color: "#33FFFFFF"
                                    }
                                    Column {
                                        spacing: 6
                                        Rectangle {
                                            width: 40; height: 40; radius: 20
                                            color: "#CC18181E"; border.width: 1; border.color: "#33FFFFFF"
                                        }
                                        Rectangle {
                                            width: 40; height: 38; radius: 11
                                            color: "#CC2D1F14"; border.width: 1; border.color: "#33FFFFFF"
                                        }
                                    }
                                }

                                // Mini Liquid Glass Floating Dock (Merespons Mode Auto-Hide!)
                                Rectangle {
                                    anchors.bottom: parent.bottom
                                    anchors.horizontalCenter: parent.horizontalCenter
                                    anchors.bottomMargin: root.dockHideMode === "always" ? -18 : 7
                                    width: 154
                                    height: 20
                                    radius: 10
                                    color: "#AA1C1E28"
                                    border.width: 1
                                    border.color: "#55FFFFFF"
                                    Behavior on anchors.bottomMargin { SpringAnimation { spring: 7.5; damping: 0.72 } }

                                    Row {
                                        anchors.centerIn: parent
                                        spacing: 5
                                        Repeater {
                                            model: ["#1D8FE1", "#5E5CE6", "#FF9500", "#30D158", "#0A84FF", "#BF5AF2"]
                                            Rectangle {
                                                width: 12; height: 12; radius: 6
                                                color: modelData
                                            }
                                        }
                                    }
                                }

                                // Badge Live Preview
                                Rectangle {
                                    anchors.top: parent.top
                                    anchors.right: parent.right
                                    anchors.topMargin: 20
                                    anchors.rightMargin: 10
                                    height: 20
                                    width: livePrevBadge.implicitWidth + 12
                                    radius: 10
                                    color: "#8812141E"
                                    border.width: 1
                                    border.color: "#44FFFFFF"
                                    Text {
                                        id: livePrevBadge
                                        anchors.centerIn: parent
                                        text: "Live Preview"
                                        color: "#FFFFFF"
                                        font.pixelSize: 9
                                        font.bold: true
                                    }
                                }
                            }

                            // Kolom Kanan: Mode Floating Dock & Aksi Widget (Pil Bulat Lonjong)
                            ColumnLayout {
                                Layout.fillWidth: true
                                Layout.fillHeight: true
                                spacing: 8

                                Text {
                                    text: "Floating Dock Mode"
                                    color: "#D1D1D6"
                                    font.pixelSize: 11
                                    font.bold: true
                                }

                                // 3 Pilihan Mode Dock berbentuk Kapsul Lonjong
                                Repeater {
                                    model: [
                                        { mode: "smart", label: "Smart Auto-Hide" },
                                        { mode: "always", label: "Selalu Sembunyi" },
                                        { mode: "never", label: "Selalu Tampil" }
                                    ]

                                    Rectangle {
                                        Layout.fillWidth: true
                                        height: 32
                                        radius: 16
                                        property bool isSel: root.dockHideMode === modelData.mode
                                        border.width: 1.1
                                        border.color: isSel ? "#80FFFFFF" : "#30FFFFFF"
                                        gradient: Gradient {
                                            GradientStop { position: 0.0; color: isSel ? "#D92B8EFF" : "#24FFFFFF" }
                                            GradientStop { position: 1.0; color: isSel ? "#AD0866E6" : "#10FFFFFF" }
                                        }

                                        RowLayout {
                                            anchors.fill: parent
                                            anchors.leftMargin: 12
                                            anchors.rightMargin: 12
                                            Text {
                                                text: modelData.label
                                                color: "#FFFFFF"
                                                font.pixelSize: 11
                                                font.bold: isSel
                                            }
                                            Item { Layout.fillWidth: true }
                                            Rectangle {
                                                width: 14; height: 14; radius: 7
                                                color: isSel ? "#FFFFFF" : "transparent"
                                                border.width: 1.2
                                                border.color: "#88FFFFFF"
                                            }
                                        }

                                        MouseArea {
                                            anchors.fill: parent
                                            cursorShape: Qt.PointingHandCursor
                                            onClicked: root.dockHideMode = modelData.mode
                                        }
                                    }
                                }

                                // Baris 2 Pill Aksi Widget (Atur & Reset)
                                RowLayout {
                                    Layout.fillWidth: true
                                    spacing: 8

                                    Rectangle {
                                        Layout.fillWidth: true
                                        height: 34
                                        radius: 17
                                        color: editWidPillM.containsMouse ? "#34FFFFFF" : "#20FFFFFF"
                                        border.width: 1.1
                                        border.color: "#44FFFFFF"
                                        Text {
                                            anchors.centerIn: parent
                                            text: "Atur Widget"
                                            color: "#FFFFFF"
                                            font.pixelSize: 11
                                            font.bold: true
                                        }
                                        MouseArea {
                                            id: editWidPillM
                                            anchors.fill: parent
                                            hoverEnabled: true
                                            cursorShape: Qt.PointingHandCursor
                                            onClicked: {
                                                root.closePopups();
                                                win.editMode = true;
                                            }
                                        }
                                    }

                                    Rectangle {
                                        Layout.fillWidth: true
                                        height: 34
                                        radius: 17
                                        color: rstWidPillM.containsMouse ? "#34FFFFFF" : "#20FFFFFF"
                                        border.width: 1.1
                                        border.color: "#44FFFFFF"
                                        Text {
                                            anchors.centerIn: parent
                                            text: "Reset Layout"
                                            color: "#E5E5EA"
                                            font.pixelSize: 11
                                        }
                                        MouseArea {
                                            id: rstWidPillM
                                            anchors.fill: parent
                                            hoverEnabled: true
                                            cursorShape: Qt.PointingHandCursor
                                            onClicked: win.resetLayout()
                                        }
                                    }
                                }
                            }
                        }

                        // ── PILIHAN 2 OPSI GLASS + SETTINGAN INDEPENDEN MASING-MASING ──
                        RowLayout {
                            Layout.fillWidth: true
                            height: 40
                            spacing: 10

                            Repeater {
                                model: [
                                    { id: "mac", title: "Opsi 1 • Clean Glass", sub: "Frost Rata Halus" },
                                    { id: "aero", title: "Opsi 2 • Aero Blin", sub: "Pantulan Diagonal" },
                                    { id: "liquid", title: "Opsi 3 • Liquid Glass", sub: "Refraksi Niri-Glass" }
                                ]

                                Rectangle {
                                    Layout.fillWidth: true
                                    height: 40
                                    radius: 20
                                    property bool active: root.glassStyle === modelData.id
                                    border.width: 1.15
                                    border.color: active ? "#85FFFFFF" : "#3CFFFFFF"
                                    scale: optPillM.pressed ? 0.96 : 1.0
                                    gradient: Gradient {
                                        GradientStop { position: 0.0; color: active ? "#D92B8EFF" : "#26FFFFFF" }
                                        GradientStop { position: 1.0; color: active ? "#AD0866E6" : "#12FFFFFF" }
                                    }
                                    Behavior on scale { SpringAnimation { spring: 7.5; damping: 0.72 } }

                                    RowLayout {
                                        anchors.fill: parent
                                        anchors.leftMargin: 14
                                        anchors.rightMargin: 12
                                        spacing: 8

                                        ColumnLayout {
                                            Layout.fillWidth: true
                                            spacing: 0
                                            Text {
                                                text: modelData.title
                                                color: "#FFFFFF"
                                                font.pixelSize: 11
                                                font.bold: active
                                                elide: Text.ElideRight
                                                Layout.fillWidth: true
                                            }
                                            Text {
                                                text: modelData.sub
                                                color: active ? "#E5F2FF" : "#AEAEB2"
                                                font.pixelSize: 9
                                                elide: Text.ElideRight
                                                Layout.fillWidth: true
                                            }
                                        }

                                        Rectangle {
                                            width: 14; height: 14; radius: 7
                                            color: active ? "#FFFFFF" : "transparent"
                                            border.width: 1.2
                                            border.color: "#88FFFFFF"
                                        }
                                    }

                                    MouseArea {
                                        id: optPillM
                                        anchors.fill: parent
                                        cursorShape: Qt.PointingHandCursor
                                        onClicked: {
                                            root.glassStyle = modelData.id;
                                            win.saveLayout();
                                        }
                                    }
                                }
                            }
                        }

                        // SLIDER INDEPENDEN OPSI 1 (CLEAN GLASS: TRANSPARANSI & BLIN RATA)
                        RowLayout {
                            Layout.fillWidth: true
                            height: 40
                            spacing: 10
                            visible: root.glassStyle === "mac"

                            // Slider 1A: Transparansi Opsi 1
                            Rectangle {
                                Layout.fillWidth: true
                                height: 40
                                radius: 20
                                color: "#22FFFFFF"
                                border.width: 1.1
                                border.color: "#48FFFFFF"
                                clip: true

                                Rectangle {
                                    width: Math.max(40, parent.width * Math.max(0.12, Math.min(0.90, 1.0 - root.macOpacity)))
                                    height: 40
                                    radius: 20
                                    gradient: Gradient {
                                        GradientStop { position: 0.0; color: "#72FFFFFF" }
                                        GradientStop { position: 1.0; color: "#44FFFFFF" }
                                    }
                                    border.width: 1
                                    border.color: "#60FFFFFF"
                                }

                                RowLayout {
                                    anchors.fill: parent
                                    anchors.leftMargin: 14
                                    anchors.rightMargin: 14
                                    Text { text: "◌"; color: "#FFFFFF"; font.pixelSize: 14; font.bold: true }
                                    Text { text: "Transparansi"; color: "#FFFFFF"; font.pixelSize: 11; font.bold: true }
                                    Item { Layout.fillWidth: true }
                                    Text { text: Math.round((1.0 - root.macOpacity) * 100) + "%"; color: "#FFFFFF"; font.pixelSize: 11; font.bold: true }
                                }

                                MouseArea {
                                    anchors.fill: parent
                                    cursorShape: Qt.PointingHandCursor
                                    onPressed: (m) => {
                                        let t = Math.max(0.15, Math.min(0.90, m.x / width));
                                        root.macOpacity = Number((1.0 - t).toFixed(2));
                                    }
                                    onPositionChanged: (m) => {
                                        if (pressed) {
                                            let t = Math.max(0.15, Math.min(0.90, m.x / width));
                                            root.macOpacity = Number((1.0 - t).toFixed(2));
                                        }
                                    }
                                    onReleased: win.saveLayout()
                                }
                            }

                            // Slider 1B: Blin Rata Opsi 1
                            Rectangle {
                                Layout.fillWidth: true
                                height: 40
                                radius: 20
                                color: "#22FFFFFF"
                                border.width: 1.1
                                border.color: "#48FFFFFF"
                                clip: true

                                Rectangle {
                                    width: Math.max(40, parent.width * root.macFrost)
                                    height: 40
                                    radius: 20
                                    gradient: Gradient {
                                        GradientStop { position: 0.0; color: "#72FFFFFF" }
                                        GradientStop { position: 1.0; color: "#44FFFFFF" }
                                    }
                                    border.width: 1
                                    border.color: "#60FFFFFF"
                                }

                                RowLayout {
                                    anchors.fill: parent
                                    anchors.leftMargin: 14
                                    anchors.rightMargin: 14
                                    Text { text: "✦"; color: "#FFFFFF"; font.pixelSize: 13; font.bold: true }
                                    Text { text: "Blin Rata"; color: "#FFFFFF"; font.pixelSize: 11; font.bold: true }
                                    Item { Layout.fillWidth: true }
                                    Text { text: Math.round(root.macFrost * 100) + "%"; color: "#FFFFFF"; font.pixelSize: 11; font.bold: true }
                                }

                                MouseArea {
                                    anchors.fill: parent
                                    cursorShape: Qt.PointingHandCursor
                                    onPressed: (m) => root.macFrost = Number(Math.max(0.0, Math.min(1.0, m.x / width)).toFixed(2))
                                    onPositionChanged: (m) => { if (pressed) root.macFrost = Number(Math.max(0.0, Math.min(1.0, m.x / width)).toFixed(2)); }
                                    onReleased: win.saveLayout()
                                }
                            }
                        }

                        // SLIDER INDEPENDEN OPSI 2 (AERO BLIN: TRANSPARANSI, KECERAHAN BLIN & KETEBALAN BLIN)
                        RowLayout {
                            Layout.fillWidth: true
                            height: 40
                            spacing: 8
                            visible: root.glassStyle === "aero"

                            // Slider 2A: Transparansi Opsi 2
                            Rectangle {
                                Layout.fillWidth: true
                                height: 40
                                radius: 20
                                color: "#22FFFFFF"
                                border.width: 1.1
                                border.color: "#48FFFFFF"
                                clip: true

                                Rectangle {
                                    width: Math.max(36, parent.width * Math.max(0.12, Math.min(0.90, 1.0 - root.aeroBaseOpacity)))
                                    height: 40
                                    radius: 20
                                    gradient: Gradient {
                                        GradientStop { position: 0.0; color: "#72FFFFFF" }
                                        GradientStop { position: 1.0; color: "#44FFFFFF" }
                                    }
                                    border.width: 1
                                    border.color: "#60FFFFFF"
                                }

                                RowLayout {
                                    anchors.fill: parent
                                    anchors.leftMargin: 11
                                    anchors.rightMargin: 11
                                    Text { text: "Transparansi"; color: "#FFFFFF"; font.pixelSize: 10; font.bold: true }
                                    Item { Layout.fillWidth: true }
                                    Text { text: Math.round((1.0 - root.aeroBaseOpacity) * 100) + "%"; color: "#FFFFFF"; font.pixelSize: 10; font.bold: true }
                                }

                                MouseArea {
                                    anchors.fill: parent
                                    cursorShape: Qt.PointingHandCursor
                                    onPressed: (m) => {
                                        let t = Math.max(0.15, Math.min(0.90, m.x / width));
                                        root.aeroBaseOpacity = Number((1.0 - t).toFixed(2));
                                    }
                                    onPositionChanged: (m) => {
                                        if (pressed) {
                                            let t = Math.max(0.15, Math.min(0.90, m.x / width));
                                            root.aeroBaseOpacity = Number((1.0 - t).toFixed(2));
                                        }
                                    }
                                    onReleased: win.saveLayout()
                                }
                            }

                            // Slider 2B: Kecerahan Blin Opsi 2
                            Rectangle {
                                Layout.fillWidth: true
                                height: 40
                                radius: 20
                                color: "#22FFFFFF"
                                border.width: 1.1
                                border.color: "#48FFFFFF"
                                clip: true

                                Rectangle {
                                    width: Math.max(36, parent.width * root.aeroSheenBright)
                                    height: 40
                                    radius: 20
                                    gradient: Gradient {
                                        GradientStop { position: 0.0; color: "#72FFFFFF" }
                                        GradientStop { position: 1.0; color: "#44FFFFFF" }
                                    }
                                    border.width: 1
                                    border.color: "#60FFFFFF"
                                }

                                RowLayout {
                                    anchors.fill: parent
                                    anchors.leftMargin: 11
                                    anchors.rightMargin: 11
                                    Text { text: "Cerah Blin"; color: "#FFFFFF"; font.pixelSize: 10; font.bold: true }
                                    Item { Layout.fillWidth: true }
                                    Text { text: Math.round(root.aeroSheenBright * 100) + "%"; color: "#FFFFFF"; font.pixelSize: 10; font.bold: true }
                                }

                                MouseArea {
                                    anchors.fill: parent
                                    cursorShape: Qt.PointingHandCursor
                                    onPressed: (m) => root.aeroSheenBright = Number(Math.max(0.0, Math.min(1.0, m.x / width)).toFixed(2))
                                    onPositionChanged: (m) => { if (pressed) root.aeroSheenBright = Number(Math.max(0.0, Math.min(1.0, m.x / width)).toFixed(2)); }
                                    onReleased: win.saveLayout()
                                }
                            }

                            // Slider 2C: Ketebalan Blin Opsi 2
                            Rectangle {
                                Layout.fillWidth: true
                                height: 40
                                radius: 20
                                color: "#22FFFFFF"
                                border.width: 1.1
                                border.color: "#48FFFFFF"
                                clip: true

                                Rectangle {
                                    width: Math.max(36, parent.width * root.aeroSheenWidth)
                                    height: 40
                                    radius: 20
                                    gradient: Gradient {
                                        GradientStop { position: 0.0; color: "#72FFFFFF" }
                                        GradientStop { position: 1.0; color: "#44FFFFFF" }
                                    }
                                    border.width: 1
                                    border.color: "#60FFFFFF"
                                }

                                RowLayout {
                                    anchors.fill: parent
                                    anchors.leftMargin: 11
                                    anchors.rightMargin: 11
                                    Text { text: "Tebal Blin"; color: "#FFFFFF"; font.pixelSize: 10; font.bold: true }
                                    Item { Layout.fillWidth: true }
                                    Text { text: Math.round(root.aeroSheenWidth * 100) + "%"; color: "#FFFFFF"; font.pixelSize: 10; font.bold: true }
                                }

                                MouseArea {
                                    anchors.fill: parent
                                    cursorShape: Qt.PointingHandCursor
                                    onPressed: (m) => root.aeroSheenWidth = Number(Math.max(0.08, Math.min(1.0, m.x / width)).toFixed(2))
                                    onPositionChanged: (m) => { if (pressed) root.aeroSheenWidth = Number(Math.max(0.08, Math.min(1.0, m.x / width)).toFixed(2)); }
                                    onReleased: win.saveLayout()
                                }
                            }
                        }

                        // SLIDER INDEPENDEN OPSI 3 (LIQUID GLASS: TRANSPARANSI, REFRAKSI & PRISMA RGB)
                        RowLayout {
                            Layout.fillWidth: true
                            height: 40
                            spacing: 8
                            visible: root.glassStyle === "liquid"

                            Rectangle {
                                Layout.fillWidth: true
                                height: 40
                                radius: 20
                                color: "#22FFFFFF"
                                border.width: 1.1
                                border.color: "#48FFFFFF"
                                clip: true

                                Rectangle {
                                    width: Math.max(36, parent.width * Math.max(0.12, Math.min(0.90, 1.0 - root.liquidOpacity)))
                                    height: 40
                                    radius: 20
                                    gradient: Gradient {
                                        GradientStop { position: 0.0; color: "#72FFFFFF" }
                                        GradientStop { position: 1.0; color: "#44FFFFFF" }
                                    }
                                    border.width: 1
                                    border.color: "#60FFFFFF"
                                }

                                RowLayout {
                                    anchors.fill: parent
                                    anchors.leftMargin: 11
                                    anchors.rightMargin: 11
                                    Text { text: "Transparansi"; color: "#FFFFFF"; font.pixelSize: 10; font.bold: true }
                                    Item { Layout.fillWidth: true }
                                    Text { text: Math.round((1.0 - root.liquidOpacity) * 100) + "%"; color: "#FFFFFF"; font.pixelSize: 10; font.bold: true }
                                }

                                MouseArea {
                                    anchors.fill: parent
                                    cursorShape: Qt.PointingHandCursor
                                    onPressed: (m) => {
                                        let t = Math.max(0.15, Math.min(0.90, m.x / width));
                                        root.liquidOpacity = Number((1.0 - t).toFixed(2));
                                    }
                                    onPositionChanged: (m) => {
                                        if (pressed) {
                                            let t = Math.max(0.15, Math.min(0.90, m.x / width));
                                            root.liquidOpacity = Number((1.0 - t).toFixed(2));
                                        }
                                    }
                                    onReleased: win.saveLayout()
                                }
                            }

                            Rectangle {
                                Layout.fillWidth: true
                                height: 40
                                radius: 20
                                color: "#22FFFFFF"
                                border.width: 1.1
                                border.color: "#48FFFFFF"
                                clip: true

                                Rectangle {
                                    width: Math.max(36, parent.width * root.liquidRefraction)
                                    height: 40
                                    radius: 20
                                    gradient: Gradient {
                                        GradientStop { position: 0.0; color: "#72FFFFFF" }
                                        GradientStop { position: 1.0; color: "#44FFFFFF" }
                                    }
                                    border.width: 1
                                    border.color: "#60FFFFFF"
                                }

                                RowLayout {
                                    anchors.fill: parent
                                    anchors.leftMargin: 11
                                    anchors.rightMargin: 11
                                    Text { text: "Refraksi"; color: "#FFFFFF"; font.pixelSize: 10; font.bold: true }
                                    Item { Layout.fillWidth: true }
                                    Text { text: Math.round(root.liquidRefraction * 100) + "%"; color: "#FFFFFF"; font.pixelSize: 10; font.bold: true }
                                }

                                MouseArea {
                                    anchors.fill: parent
                                    cursorShape: Qt.PointingHandCursor
                                    onPressed: (m) => root.liquidRefraction = Number(Math.max(0.0, Math.min(1.0, m.x / width)).toFixed(2))
                                    onPositionChanged: (m) => { if (pressed) root.liquidRefraction = Number(Math.max(0.0, Math.min(1.0, m.x / width)).toFixed(2)); }
                                    onReleased: win.saveLayout()
                                }
                            }

                            Rectangle {
                                Layout.fillWidth: true
                                height: 40
                                radius: 20
                                color: "#22FFFFFF"
                                border.width: 1.1
                                border.color: "#48FFFFFF"
                                clip: true

                                Rectangle {
                                    width: Math.max(36, parent.width * root.liquidFringing)
                                    height: 40
                                    radius: 20
                                    gradient: Gradient {
                                        GradientStop { position: 0.0; color: "#72FFFFFF" }
                                        GradientStop { position: 1.0; color: "#44FFFFFF" }
                                    }
                                    border.width: 1
                                    border.color: "#60FFFFFF"
                                }

                                RowLayout {
                                    anchors.fill: parent
                                    anchors.leftMargin: 11
                                    anchors.rightMargin: 11
                                    Text { text: "Prisma RGB"; color: "#FFFFFF"; font.pixelSize: 10; font.bold: true }
                                    Item { Layout.fillWidth: true }
                                    Text { text: Math.round(root.liquidFringing * 100) + "%"; color: "#FFFFFF"; font.pixelSize: 10; font.bold: true }
                                }

                                MouseArea {
                                    anchors.fill: parent
                                    cursorShape: Qt.PointingHandCursor
                                    onPressed: (m) => root.liquidFringing = Number(Math.max(0.0, Math.min(1.0, m.x / width)).toFixed(2))
                                    onPositionChanged: (m) => { if (pressed) root.liquidFringing = Number(Math.max(0.0, Math.min(1.0, m.x / width)).toFixed(2)); }
                                    onReleased: win.saveLayout()
                                }
                            }
                        }

                        // Galeri Pilihan Wallpaper (Pill Rounded Thumbnails)
                        // ── WIDGET GALLERY (PILIH WIDGET 1-1 & KUNCI POSISI) ──
                        RowLayout {
                            Layout.fillWidth: true
                            Text {
                                text: "Widget Desktop (Klik untuk Tampilkan / Sembunyikan)"
                                color: "#D1D1D6"
                                font.pixelSize: 11
                                font.bold: true
                            }
                            Item { Layout.fillWidth: true }
                            Rectangle {
                                height: 24; width: setLockTxt.implicitWidth + 16; radius: 12
                                color: win.widgetsLocked ? "#44FFD60A" : "#22FFFFFF"
                                border.width: 1; border.color: win.widgetsLocked ? "#88FFD60A" : "#3CFFFFFF"
                                Text {
                                    id: setLockTxt
                                    anchors.centerIn: parent
                                    text: win.widgetsLocked ? "🔒 Posisi Terkunci" : "🔓 Posisi Bebas"
                                    color: "#FFFFFF"
                                    font.pixelSize: 10
                                    font.bold: true
                                }
                                MouseArea {
                                    anchors.fill: parent
                                    cursorShape: Qt.PointingHandCursor
                                    onClicked: win.toggleLock()
                                }
                            }
                        }

                        Flow {
                            Layout.fillWidth: true
                            spacing: 7

                            Repeater {
                                model: [
                                    { key: "media", label: "♫ Media Player" },
                                    { key: "clock", label: "🕒 Analog Clock" },
                                    { key: "weather", label: "☀ Weather" },
                                    { key: "battery", label: "🔋 Batteries Ring" },
                                    { key: "sysmon", label: "⚡ CPU & RAM" },
                                    { key: "notes", label: "📝 Calendar & Notes" }
                                ]

                                Rectangle {
                                    height: 30
                                    width: wChipTxt.implicitWidth + 24
                                    radius: 15
                                    property bool active: win.isWidgetOn(modelData.key)
                                    border.width: 1.1
                                    border.color: active ? "#85FFFFFF" : "#38FFFFFF"
                                    gradient: Gradient {
                                        GradientStop { position: 0.0; color: active ? "#D92B8EFF" : "#24FFFFFF" }
                                        GradientStop { position: 1.0; color: active ? "#AD0866E6" : "#12FFFFFF" }
                                    }

                                    Text {
                                        id: wChipTxt
                                        anchors.centerIn: parent
                                        text: (active ? "✓ " : "+ ") + modelData.label
                                        color: "#FFFFFF"
                                        font.pixelSize: 10
                                        font.bold: active
                                    }

                                    MouseArea {
                                        anchors.fill: parent
                                        cursorShape: Qt.PointingHandCursor
                                        onClicked: win.setWidgetEnabled(modelData.key, !active)
                                    }
                                }
                            }
                        }

                        Text {
                            text: "Koleksi Wallpaper (" + root.wallpaperList.length + " tersedia)"
                            color: "#D1D1D6"
                            font.pixelSize: 11
                            font.bold: true
                        }

                        GridView {
                            id: wallGrid
                            Layout.fillWidth: true
                            Layout.fillHeight: true
                            clip: true
                            cellWidth: Math.floor(width / 3)
                            cellHeight: 74
                            model: root.wallpaperList

                            delegate: Item {
                                width: wallGrid.cellWidth
                                height: wallGrid.cellHeight

                                Rectangle {
                                    anchors.fill: parent
                                    anchors.margins: 4
                                    radius: 22
                                    color: "#222534"
                                    border.width: root.currentWallpaper === modelData ? 2 : 1.1
                                    border.color: root.currentWallpaper === modelData ? "#64D2FF" : "#3CFFFFFF"
                                    clip: true
                                    scale: wpThumbM.pressed ? 0.94 : (wpThumbM.containsMouse ? 1.03 : 1.0)
                                    Behavior on scale { SpringAnimation { spring: 7.5; damping: 0.72 } }

                                    Image {
                                        anchors.fill: parent
                                        source: modelData
                                        fillMode: Image.PreserveAspectCrop
                                        sourceSize: Qt.size(260, 160)
                                        asynchronous: true
                                        smooth: true
                                    }

                                    Rectangle {
                                        anchors.right: parent.right
                                        anchors.bottom: parent.bottom
                                        anchors.margins: 7
                                        width: 22; height: 22; radius: 11
                                        color: "#0A84FF"
                                        border.width: 1
                                        border.color: "#FFFFFF"
                                        visible: root.currentWallpaper === modelData
                                        Text {
                                            anchors.centerIn: parent
                                            text: "✓"
                                            color: "#FFFFFF"
                                            font.pixelSize: 11
                                            font.bold: true
                                        }
                                    }

                                    MouseArea {
                                        id: wpThumbM
                                        anchors.fill: parent
                                        hoverEnabled: true
                                        cursorShape: Qt.PointingHandCursor
                                        onClicked: root.currentWallpaper = modelData
                                    }
                                }
                            }
                        }
                    }

                    // ========================================================
                    // TAB 2: DISPLAY & SOUND (HARMONYOS GLASS PILLS & ORBS)
                    // ========================================================
                    ColumnLayout {
                        anchors.fill: parent
                        spacing: 14
                        visible: root.settingsTab === "display_sound"
                        opacity: visible ? 1.0 : 0.0
                        Behavior on opacity { NumberAnimation { duration: 145; easing.type: Easing.InOutCubic } }

                        Text { text: "Display & Sound"; color: "#FFFFFF"; font.pixelSize: 17; font.bold: true }

                        // BARIS 1: 2 KAPSUL LONJONG BESAR ALA HARMONYOS (DND PILL + BRIGHTNESS PILL SLIDER)
                        RowLayout {
                            Layout.fillWidth: true
                            height: 58
                            spacing: 12

                            // Kapsul Lonjong Focus / Do Not Disturb (Persis kiri atas gambar referensi)
                            Rectangle {
                                Layout.fillWidth: true
                                height: 58
                                radius: 29
                                border.width: 1.2
                                border.color: root.dndEnabled ? "#85FFFFFF" : "#48FFFFFF"
                                scale: setDndPillM.pressed ? 0.96 : 1.0
                                gradient: Gradient {
                                    GradientStop { position: 0.0; color: root.dndEnabled ? "#D92B8EFF" : "#2EFFFFFF" }
                                    GradientStop { position: 1.0; color: root.dndEnabled ? "#AD0866E6" : "#14FFFFFF" }
                                }
                                Behavior on scale { SpringAnimation { spring: 7.5; damping: 0.72 } }

                                RowLayout {
                                    anchors.fill: parent
                                    anchors.leftMargin: 16
                                    anchors.rightMargin: 18
                                    spacing: 12

                                    Text { text: "☾"; color: "#FFFFFF"; font.pixelSize: 20; font.bold: true }
                                    ColumnLayout {
                                        Layout.fillWidth: true
                                        spacing: 1
                                        Text { text: "Do Not Disturb"; color: "#FFFFFF"; font.pixelSize: 13; font.bold: true }
                                        Text { text: root.dndEnabled ? "Aktif • Notifikasi Hening" : "Nonaktif"; color: "#E5E5EA"; font.pixelSize: 10 }
                                    }
                                }

                                MouseArea {
                                    id: setDndPillM
                                    anchors.fill: parent
                                    cursorShape: Qt.PointingHandCursor
                                    onClicked: root.toggleDnd()
                                }
                            }

                            // Slider Pil Kaca Brightness (Persis kanan atas gambar referensi)
                            Rectangle {
                                Layout.fillWidth: true
                                height: 58
                                radius: 29
                                color: "#22FFFFFF"
                                border.width: 1.2
                                border.color: "#4CFFFFFF"
                                clip: true

                                Rectangle {
                                    width: Math.max(58, parent.width * (root.brightnessLevel / 100))
                                    height: 58
                                    radius: 29
                                    gradient: Gradient {
                                        GradientStop { position: 0.0; color: "#78FFFFFF" }
                                        GradientStop { position: 1.0; color: "#4CFFFFFF" }
                                    }
                                    border.width: 1
                                    border.color: "#66FFFFFF"
                                    Behavior on width { NumberAnimation { duration: 110; easing.type: Easing.InOutCubic } }
                                }

                                RowLayout {
                                    anchors.fill: parent
                                    anchors.leftMargin: 18
                                    anchors.rightMargin: 18
                                    Text { text: "☀"; color: "#FFFFFF"; font.pixelSize: 19; font.bold: true }
                                    Text { text: "Brightness"; color: "#FFFFFF"; font.pixelSize: 12; font.bold: true }
                                    Item { Layout.fillWidth: true }
                                    Text { text: root.brightnessLevel + "%"; color: "#FFFFFF"; font.pixelSize: 12; font.bold: true }
                                }

                                MouseArea {
                                    anchors.fill: parent
                                    cursorShape: Qt.PointingHandCursor
                                    onPressed: (m) => root.setBrightnessPct((m.x / width) * 100)
                                    onPositionChanged: (m) => { if (pressed) root.setBrightnessPct((m.x / width) * 100); }
                                }
                            }
                        }

                        // BARIS 2: SLIDER PIL KACA SOUND VOLUME
                        Rectangle {
                            Layout.fillWidth: true
                            height: 58
                            radius: 29
                            color: "#22FFFFFF"
                            border.width: 1.2
                            border.color: "#4CFFFFFF"
                            clip: true

                            Rectangle {
                                width: root.volumeMuted ? 58 : Math.max(58, parent.width * (root.volumeLevel / 100))
                                height: 58
                                radius: 29
                                gradient: Gradient {
                                    GradientStop { position: 0.0; color: root.volumeMuted ? "#44FF453A" : "#78FFFFFF" }
                                    GradientStop { position: 1.0; color: root.volumeMuted ? "#28FF453A" : "#4CFFFFFF" }
                                }
                                border.width: 1
                                border.color: "#66FFFFFF"
                                Behavior on width { NumberAnimation { duration: 110; easing.type: Easing.InOutCubic } }
                            }

                            RowLayout {
                                anchors.fill: parent
                                anchors.leftMargin: 18
                                anchors.rightMargin: 18
                                Text { text: root.volumeMuted ? "🔇" : "🔊"; font.pixelSize: 17 }
                                Text { text: "Master Volume"; color: "#FFFFFF"; font.pixelSize: 13; font.bold: true }
                                Item { Layout.fillWidth: true }
                                Text {
                                    text: root.volumeMuted ? "Muted" : (root.volumeLevel + "%")
                                    color: "#FFFFFF"
                                    font.pixelSize: 13
                                    font.bold: true
                                }
                            }

                            MouseArea {
                                anchors.fill: parent
                                cursorShape: Qt.PointingHandCursor
                                onPressed: (m) => root.setVolumePct((m.x / width) * 100)
                                onPositionChanged: (m) => { if (pressed) root.setVolumePct((m.x / width) * 100); }
                            }
                        }

                        // BARIS 3: 4 TOMBOL BULAT KACA (CIRCULAR GLASS ORBS ALA HARMONYOS)
                        RowLayout {
                            Layout.fillWidth: true
                            spacing: 14

                            Repeater {
                                model: [
                                    { label: "Keep Awake", glyph: "⏱", active: root.keepAwake, act: "awake" },
                                    { label: "Mute Audio", glyph: "🔇", active: root.volumeMuted, act: "mute" },
                                    { label: "Screenshot", glyph: "📷", active: false, act: "ss" },
                                    { label: "Overview", glyph: "⊞", active: false, act: "ov" }
                                ]

                                ColumnLayout {
                                    Layout.fillWidth: true
                                    spacing: 6

                                    Rectangle {
                                        Layout.alignment: Qt.AlignHCenter
                                        width: 62
                                        height: 62
                                        radius: 31
                                        border.width: 1.2
                                        border.color: modelData.active ? "#88FFFFFF" : "#4CFFFFFF"
                                        scale: orbM1.pressed ? 0.92 : (orbM1.containsMouse ? 1.05 : 1.0)
                                        gradient: Gradient {
                                            GradientStop { position: 0.0; color: modelData.active ? "#E02E94FF" : "#30FFFFFF" }
                                            GradientStop { position: 1.0; color: modelData.active ? "#AD0866E6" : "#14FFFFFF" }
                                        }
                                        Behavior on scale { SpringAnimation { spring: 7.5; damping: 0.72 } }

                                        Text {
                                            anchors.centerIn: parent
                                            text: modelData.glyph
                                            color: "#FFFFFF"
                                            font.pixelSize: 21
                                        }

                                        MouseArea {
                                            id: orbM1
                                            anchors.fill: parent
                                            hoverEnabled: true
                                            cursorShape: Qt.PointingHandCursor
                                            onClicked: {
                                                if (modelData.act === "awake") root.toggleKeepAwake();
                                                else if (modelData.act === "mute") root.toggleMute();
                                                else if (modelData.act === "ss") { root.closePopups(); screenshotDelayTimer.restart(); }
                                                else if (modelData.act === "ov") { root.closePopups(); root.runCmd("niri msg action toggle-overview"); }
                                            }
                                        }
                                    }

                                    Text {
                                        Layout.alignment: Qt.AlignHCenter
                                        text: modelData.label
                                        color: "#E5E5EA"
                                        font.pixelSize: 11
                                        font.weight: Font.Medium
                                    }
                                }
                            }
                        }

                        // BARIS 4: INFO OUTPUT LAYAR (KAPSUL LONJONG)
                        Rectangle {
                            Layout.fillWidth: true
                            height: 52
                            radius: 26
                            color: "#22FFFFFF"
                            border.width: 1.1
                            border.color: "#38FFFFFF"

                            RowLayout {
                                anchors.fill: parent
                                anchors.leftMargin: 18
                                anchors.rightMargin: 18
                                Text { text: "Layar Utama • " + root.sysSpecs.displayInfo; color: "#FFFFFF"; font.pixelSize: 12; font.bold: true }
                                Item { Layout.fillWidth: true }
                                Text { text: root.sysSpecs.gpuModel; color: "#C7C7CC"; font.pixelSize: 11; elide: Text.ElideRight; Layout.maximumWidth: 250 }
                            }
                        }

                        Item { Layout.fillHeight: true }
                    }

                    // ========================================================
                    // TAB 3: WI-FI & NETWORK (KAPSUL LONJONG + ORB SCAN)
                    // ========================================================
                    ColumnLayout {
                        anchors.fill: parent
                        spacing: 12
                        visible: root.settingsTab === "wifi"
                        opacity: visible ? 1.0 : 0.0
                        Behavior on opacity { NumberAnimation { duration: 145; easing.type: Easing.InOutCubic } }

                        RowLayout {
                            Layout.fillWidth: true
                            spacing: 10

                            // Kapsul Toggle Wi-Fi
                            Rectangle {
                                Layout.fillWidth: true
                                height: 54
                                radius: 27
                                border.width: 1.2
                                border.color: root.wifiEnabled ? "#85FFFFFF" : "#48FFFFFF"
                                gradient: Gradient {
                                    GradientStop { position: 0.0; color: root.wifiEnabled ? "#D92B8EFF" : "#2EFFFFFF" }
                                    GradientStop { position: 1.0; color: root.wifiEnabled ? "#AD0866E6" : "#14FFFFFF" }
                                }

                                RowLayout {
                                    anchors.fill: parent
                                    anchors.leftMargin: 16
                                    anchors.rightMargin: 18
                                    spacing: 12

                                    Text { text: "ᯤ"; color: "#FFFFFF"; font.pixelSize: 18; font.bold: true }
                                    ColumnLayout {
                                        Layout.fillWidth: true
                                        spacing: 1
                                        Text { text: "Wi-Fi"; color: "#FFFFFF"; font.pixelSize: 13; font.bold: true }
                                        Text { text: root.wifiName + " • IP " + root.localIpAddr; color: "#E5F2FF"; font.pixelSize: 10; elide: Text.ElideRight; Layout.fillWidth: true }
                                    }
                                    Text { text: root.wifiEnabled ? "ON" : "OFF"; color: "#FFFFFF"; font.pixelSize: 11; font.bold: true }
                                }

                                MouseArea {
                                    anchors.fill: parent
                                    cursorShape: Qt.PointingHandCursor
                                    onClicked: root.toggleWifi()
                                }
                            }

                            // Tombol Bulat Kaca Rescan Wi-Fi
                            Rectangle {
                                width: 54; height: 54; radius: 27
                                border.width: 1.2
                                border.color: "#4CFFFFFF"
                                visible: root.wifiEnabled
                                gradient: Gradient {
                                    GradientStop { position: 0.0; color: "#30FFFFFF" }
                                    GradientStop { position: 1.0; color: "#14FFFFFF" }
                                }
                                Text {
                                    anchors.centerIn: parent
                                    text: root.wifiScanning ? "…" : "↻"
                                    color: "#FFFFFF"
                                    font.pixelSize: 18
                                    font.bold: true
                                }
                                MouseArea {
                                    anchors.fill: parent
                                    cursorShape: Qt.PointingHandCursor
                                    onClicked: root.scanWifiNetworks()
                                }
                            }
                        }

                        // Kapsul Input Sandi Wi-Fi
                        Rectangle {
                            Layout.fillWidth: true
                            height: 48
                            radius: 24
                            color: "#2EFFFFFF"
                            border.width: 1.2
                            border.color: "#66A1C6FF"
                            visible: root.wifiPasswordTarget !== ""

                            RowLayout {
                                anchors.fill: parent
                                anchors.leftMargin: 16
                                anchors.rightMargin: 8
                                spacing: 8

                                TextInput {
                                    id: setWifiPassField
                                    Layout.fillWidth: true
                                    echoMode: TextInput.Password
                                    color: "#FFFFFF"
                                    font.pixelSize: 12
                                    onAccepted: root.connectWifi(root.wifiPasswordTarget, text)
                                    Text {
                                        anchors.fill: parent
                                        verticalAlignment: Text.AlignVCenter
                                        text: "Sandi untuk " + root.wifiPasswordTarget + "..."
                                        color: "#C7C7CC"
                                        font.pixelSize: 11
                                        visible: setWifiPassField.text === ""
                                    }
                                }

                                Rectangle {
                                    height: 34
                                    width: 96
                                    radius: 17
                                    color: "#0A84FF"
                                    Text { anchors.centerIn: parent; text: "Hubungkan"; color: "#FFFFFF"; font.pixelSize: 11; font.bold: true }
                                    MouseArea {
                                        anchors.fill: parent
                                        cursorShape: Qt.PointingHandCursor
                                        onClicked: root.connectWifi(root.wifiPasswordTarget, setWifiPassField.text)
                                    }
                                }
                            }
                        }

                        // Daftar Jaringan Wi-Fi (Kapsul Lonjong)
                        ListView {
                            Layout.fillWidth: true
                            Layout.fillHeight: true
                            clip: true
                            spacing: 8
                            visible: root.wifiEnabled
                            model: root.wifiNetworks

                            delegate: Rectangle {
                                width: ListView.view.width
                                height: 46
                                radius: 23
                                border.width: 1.1
                                border.color: modelData.connected ? "#80FFFFFF" : "#30FFFFFF"
                                gradient: Gradient {
                                    GradientStop { position: 0.0; color: modelData.connected ? "#CC2B8EFF" : (wPillM.containsMouse ? "#2CFFFFFF" : "#1CFFFFFF") }
                                    GradientStop { position: 1.0; color: modelData.connected ? "#990866E6" : "#0EFFFFFF" }
                                }

                                RowLayout {
                                    anchors.fill: parent
                                    anchors.leftMargin: 14
                                    anchors.rightMargin: 16
                                    spacing: 10

                                    Rectangle {
                                        width: 26; height: 26; radius: 13
                                        color: "#33FFFFFF"
                                        Text {
                                            anchors.centerIn: parent
                                            text: modelData.connected ? "✓" : "ᯤ"
                                            color: "#FFFFFF"
                                            font.pixelSize: 11
                                            font.bold: true
                                        }
                                    }

                                    Text {
                                        Layout.fillWidth: true
                                        text: modelData.ssid
                                        color: "#FFFFFF"
                                        font.pixelSize: 12
                                        font.bold: modelData.connected
                                        elide: Text.ElideRight
                                    }

                                    Text {
                                        text: (modelData.secured ? "🔒 " : "") + modelData.signal + "%"
                                        color: "#E5E5EA"
                                        font.pixelSize: 11
                                    }
                                }

                                MouseArea {
                                    id: wPillM
                                    anchors.fill: parent
                                    hoverEnabled: true
                                    cursorShape: Qt.PointingHandCursor
                                    onClicked: {
                                        if (modelData.connected) return;
                                        if (modelData.secured) {
                                            root.wifiPasswordTarget = modelData.ssid;
                                            setWifiPassField.text = "";
                                            setWifiPassField.forceActiveFocus();
                                        }
                                        root.connectWifi(modelData.ssid, "");
                                    }
                                }
                            }
                        }

                        Item { Layout.fillHeight: true; visible: !root.wifiEnabled }
                    }

                    // ========================================================
                    // TAB 4: BLUETOOTH (KAPSUL LONJONG + ORB SCAN)
                    // ========================================================
                    ColumnLayout {
                        anchors.fill: parent
                        spacing: 12
                        visible: root.settingsTab === "bluetooth"
                        opacity: visible ? 1.0 : 0.0
                        Behavior on opacity { NumberAnimation { duration: 145; easing.type: Easing.InOutCubic } }

                        RowLayout {
                            Layout.fillWidth: true
                            spacing: 10

                            Rectangle {
                                Layout.fillWidth: true
                                height: 54
                                radius: 27
                                border.width: 1.2
                                border.color: root.btEnabled ? "#85FFFFFF" : "#48FFFFFF"
                                gradient: Gradient {
                                    GradientStop { position: 0.0; color: root.btEnabled ? "#D92B8EFF" : "#2EFFFFFF" }
                                    GradientStop { position: 1.0; color: root.btEnabled ? "#AD0866E6" : "#14FFFFFF" }
                                }

                                RowLayout {
                                    anchors.fill: parent
                                    anchors.leftMargin: 16
                                    anchors.rightMargin: 18
                                    spacing: 12

                                    Text { text: "ᛒ"; color: "#FFFFFF"; font.pixelSize: 18; font.bold: true }
                                    ColumnLayout {
                                        Layout.fillWidth: true
                                        spacing: 1
                                        Text { text: "Bluetooth"; color: "#FFFFFF"; font.pixelSize: 13; font.bold: true }
                                        Text { text: root.btEnabled ? (root.btDeviceName !== "" ? "Terhubung: " + root.btDeviceName : "Siap dipasangkan") : "Bluetooth Nonaktif"; color: "#E5F2FF"; font.pixelSize: 10 }
                                    }
                                    Text { text: root.btEnabled ? "ON" : "OFF"; color: "#FFFFFF"; font.pixelSize: 11; font.bold: true }
                                }

                                MouseArea {
                                    anchors.fill: parent
                                    cursorShape: Qt.PointingHandCursor
                                    onClicked: root.toggleBluetooth()
                                }
                            }

                            Rectangle {
                                width: 54; height: 54; radius: 27
                                border.width: 1.2
                                border.color: "#4CFFFFFF"
                                visible: root.btEnabled
                                gradient: Gradient {
                                    GradientStop { position: 0.0; color: "#30FFFFFF" }
                                    GradientStop { position: 1.0; color: "#14FFFFFF" }
                                }
                                Text {
                                    anchors.centerIn: parent
                                    text: root.btScanning ? "…" : "↻"
                                    color: "#FFFFFF"
                                    font.pixelSize: 18
                                    font.bold: true
                                }
                                MouseArea {
                                    anchors.fill: parent
                                    cursorShape: Qt.PointingHandCursor
                                    onClicked: root.scanBtDevices()
                                }
                            }
                        }

                        ListView {
                            Layout.fillWidth: true
                            Layout.fillHeight: true
                            clip: true
                            spacing: 8
                            visible: root.btEnabled
                            model: root.btDevices

                            delegate: Rectangle {
                                width: ListView.view.width
                                height: 48
                                radius: 24
                                border.width: 1.1
                                border.color: modelData.connected ? "#80FFFFFF" : "#30FFFFFF"
                                gradient: Gradient {
                                    GradientStop { position: 0.0; color: modelData.connected ? "#CC2B8EFF" : (btPillM.containsMouse ? "#2CFFFFFF" : "#1CFFFFFF") }
                                    GradientStop { position: 1.0; color: modelData.connected ? "#990866E6" : "#0EFFFFFF" }
                                }

                                RowLayout {
                                    anchors.fill: parent
                                    anchors.leftMargin: 14
                                    anchors.rightMargin: 16
                                    spacing: 10

                                    Rectangle {
                                        width: 28; height: 28; radius: 14
                                        color: "#33FFFFFF"
                                        Text {
                                            anchors.centerIn: parent
                                            text: modelData.connected ? "✓" : "ᛒ"
                                            color: "#FFFFFF"
                                            font.pixelSize: 12
                                            font.bold: true
                                        }
                                    }

                                    Text {
                                        Layout.fillWidth: true
                                        text: modelData.name
                                        color: "#FFFFFF"
                                        font.pixelSize: 12
                                        font.bold: modelData.connected
                                        elide: Text.ElideRight
                                    }

                                    Text {
                                        text: root.btBusyMac === modelData.mac ? "Proses..." : (modelData.connected ? "Terhubung" : "Hubungkan")
                                        color: modelData.connected ? "#32D74B" : "#E5E5EA"
                                        font.pixelSize: 11
                                        font.bold: true
                                    }
                                }

                                MouseArea {
                                    id: btPillM
                                    anchors.fill: parent
                                    hoverEnabled: true
                                    cursorShape: Qt.PointingHandCursor
                                    onClicked: root.toggleBtDevice(modelData.mac, modelData.connected)
                                }
                            }
                        }

                        Item { Layout.fillHeight: true; visible: !root.btEnabled }
                    }

                    // ========================================================
                    // TAB 5: POWER & SYSTEM (PILL PROFILES + POWER ORBS)
                    // ========================================================
                    ColumnLayout {
                        anchors.fill: parent
                        spacing: 14
                        visible: root.settingsTab === "power"
                        opacity: visible ? 1.0 : 0.0
                        Behavior on opacity { NumberAnimation { duration: 145; easing.type: Easing.InOutCubic } }

                        Text { text: "Power & System"; color: "#FFFFFF"; font.pixelSize: 17; font.bold: true }

                        // Kapsul Status Baterai
                        Rectangle {
                            Layout.fillWidth: true
                            height: 58
                            radius: 29
                            color: "#22FFFFFF"
                            border.width: 1.2
                            border.color: "#4CFFFFFF"
                            clip: true

                            Rectangle {
                                width: root.batteryPercent >= 0 ? Math.max(58, parent.width * (root.batteryPercent / 100)) : parent.width
                                height: 58
                                radius: 29
                                gradient: Gradient {
                                    GradientStop { position: 0.0; color: root.batteryStatus === "Charging" ? "#5532D74B" : "#552E94FF" }
                                    GradientStop { position: 1.0; color: "#22FFFFFF" }
                                }
                            }

                            RowLayout {
                                anchors.fill: parent
                                anchors.leftMargin: 18
                                anchors.rightMargin: 18
                                Text { text: root.batteryStatus === "Charging" ? "⚡" : "🔋"; font.pixelSize: 18 }
                                Text {
                                    text: root.batteryPercent >= 0 ? ("Baterai " + root.batteryPercent + "% (" + root.batteryStatus + ")") : "Daya Listrik Langsung (AC)"
                                    color: "#FFFFFF"
                                    font.pixelSize: 13
                                    font.bold: true
                                }
                                Item { Layout.fillWidth: true }
                                Text { text: "Up " + root.sysSpecs.uptimeStr; color: "#E5E5EA"; font.pixelSize: 11 }
                            }
                        }

                        // 3 Pil Mode Performa CPU
                        Text { text: "Mode Performa Daya"; color: "#D1D1D6"; font.pixelSize: 11; font.bold: true }

                        RowLayout {
                            Layout.fillWidth: true
                            spacing: 10

                            Repeater {
                                model: [
                                    { id: "power-saver", label: "Hemat Daya" },
                                    { id: "balanced", label: "Seimbang" },
                                    { id: "performance", label: "Performa" }
                                ]

                                Rectangle {
                                    Layout.fillWidth: true
                                    height: 44
                                    radius: 22
                                    property bool active: root.powerProfile === modelData.id
                                    border.width: 1.2
                                    border.color: active ? "#85FFFFFF" : "#38FFFFFF"
                                    gradient: Gradient {
                                        GradientStop { position: 0.0; color: active ? "#D92B8EFF" : "#26FFFFFF" }
                                        GradientStop { position: 1.0; color: active ? "#AD0866E6" : "#12FFFFFF" }
                                    }

                                    Text {
                                        anchors.centerIn: parent
                                        text: modelData.label
                                        color: "#FFFFFF"
                                        font.pixelSize: 12
                                        font.bold: active
                                    }

                                    MouseArea {
                                        anchors.fill: parent
                                        cursorShape: Qt.PointingHandCursor
                                        onClicked: root.setPowerProfile(modelData.id)
                                    }
                                }
                            }
                        }

                        // 4 Tombol Bulat Kaca Daya (Lock, Sleep, Restart, Shutdown)
                        Text { text: "Kontrol Sesi & Daya"; color: "#D1D1D6"; font.pixelSize: 11; font.bold: true }

                        RowLayout {
                            Layout.fillWidth: true
                            spacing: 14

                            Repeater {
                                model: [
                                    { label: "Lock Screen", glyph: "🔒", cmd: "swaylock -f -c 000000 || loginctl lock-session" },
                                    { label: "Sleep", glyph: "☾", cmd: "systemctl suspend" },
                                    { label: "Restart", glyph: "↻", cmd: "systemctl reboot" },
                                    { label: "Shut Down", glyph: "⏻", cmd: "systemctl poweroff" }
                                ]

                                ColumnLayout {
                                    Layout.fillWidth: true
                                    spacing: 6

                                    Rectangle {
                                        Layout.alignment: Qt.AlignHCenter
                                        width: 62
                                        height: 62
                                        radius: 31
                                        border.width: 1.2
                                        border.color: pwrOrbM.containsMouse ? "#80FFFFFF" : "#48FFFFFF"
                                        scale: pwrOrbM.pressed ? 0.92 : (pwrOrbM.containsMouse ? 1.05 : 1.0)
                                        gradient: Gradient {
                                            GradientStop { position: 0.0; color: pwrOrbM.containsMouse ? "#45FFFFFF" : "#2CFFFFFF" }
                                            GradientStop { position: 1.0; color: "#14FFFFFF" }
                                        }
                                        Behavior on scale { SpringAnimation { spring: 7.5; damping: 0.72 } }

                                        Text {
                                            anchors.centerIn: parent
                                            text: modelData.glyph
                                            color: "#FFFFFF"
                                            font.pixelSize: 20
                                        }

                                        MouseArea {
                                            id: pwrOrbM
                                            anchors.fill: parent
                                            hoverEnabled: true
                                            cursorShape: Qt.PointingHandCursor
                                            onClicked: {
                                                root.closePopups();
                                                root.runCmd(modelData.cmd);
                                            }
                                        }
                                    }

                                    Text {
                                        Layout.alignment: Qt.AlignHCenter
                                        text: modelData.label
                                        color: "#E5E5EA"
                                        font.pixelSize: 11
                                    }
                                }
                            }
                        }

                        Item { Layout.fillHeight: true }
                    }
                }
            }
        }
    }

    // 5. DESKTOP WIDGETS IRIS (SMOOTH STAGGERED ENTRANCE)
    PanelWindow {
        id: win
        anchors.top: true
        anchors.left: true
        anchors.right: true
        anchors.bottom: true
        margins.top: 28
        exclusionMode: ExclusionMode.Ignore
        WlrLayershell.layer: WlrLayer.Bottom
        WlrLayershell.namespace: "quickshell-widgets"
        WlrLayershell.keyboardFocus: (win.editMode || noteInputArea.activeFocus) ? WlrKeyboardFocus.OnDemand : WlrKeyboardFocus.None
        color: "transparent"

        property bool editMode: false
        onEditModeChanged: {
            root.desktopEditMode = editMode;
            if (editMode) {
                root.dockWidgetEditorOpen = false;
                if ("ctxMenuVisible" in win) ctxMenuVisible = false;
            }
        }
        property bool ctxMenuVisible: false
        property real ctxMenuX: 0
        property real ctxMenuY: 0

        function openWidgetCtxMenu(mx, my) {
            let maxX = Math.max(20, (win.width || 1366) - 168);
            let maxY = Math.max(20, (win.height || 768) - 130);
            ctxMenuX = Math.max(12, Math.min(maxX, mx));
            ctxMenuY = Math.max(12, Math.min(maxY, my));
            ctxMenuVisible = true;
        }
        property real posX: 24
        property real posY: 44
        property real widgetScale: 1.0
        property real glassOpacity: root.aeroOpacity
        property real glassReflection: root.aeroReflection
        property bool widgetsLocked: root.widgetCfg.locked
        property string quickNoteText: root.widgetCfg.noteText
        property var widgetStates: root.widgetCfg.items

        function defaultItems() {
            return {
                media:   { enabled: true,  x: 24,  y: 44 },
                clock:   { enabled: true,  x: 262, y: 44 },
                weather: { enabled: true,  x: 262, y: 204 },
                battery: { enabled: true,  x: 24,  y: 352 },
                sysmon:  { enabled: true,  x: 262, y: 352 },
                notes:   { enabled: false, x: 422, y: 44 }
            };
        }

        function isWidgetOn(key) {
            return widgetStates && widgetStates[key] ? !!widgetStates[key].enabled : false;
        }

        function getWidgetX(key) {
            let d = defaultItems();
            return widgetStates && widgetStates[key] && typeof widgetStates[key].x === "number" ? widgetStates[key].x : d[key].x;
        }

        function getWidgetY(key) {
            let d = defaultItems();
            return widgetStates && widgetStates[key] && typeof widgetStates[key].y === "number" ? widgetStates[key].y : d[key].y;
        }

        function setWidgetEnabled(key, val) {
            let next = JSON.parse(JSON.stringify(widgetStates));
            if (!next[key]) next[key] = defaultItems()[key];
            next[key].enabled = val;
            widgetStates = next;
            root.widgetCfg.items = next;
            saveLayout();
        }

        function setWidgetPos(key, nx, ny) {
            let maxX = Math.max(40, (win.width || 1366) - 140);
            let maxY = Math.max(40, (win.height || 768) - 120);
            let cx = Math.round(Math.max(8, Math.min(maxX, nx)));
            let cy = Math.round(Math.max(8, Math.min(maxY, ny)));
            let next = JSON.parse(JSON.stringify(widgetStates));
            if (!next[key]) next[key] = defaultItems()[key];
            next[key].x = cx;
            next[key].y = cy;
            widgetStates = next;
            root.widgetCfg.items = next;
        }

        function toggleLock() {
            widgetsLocked = !widgetsLocked;
            root.widgetCfg.locked = widgetsLocked;
            saveLayout();
        }

        function resetLayout() {
            widgetScale = 1.0;
            widgetsLocked = false;
            widgetStates = defaultItems();
            root.widgetCfg.locked = false;
            root.widgetCfg.items = widgetStates;
            saveLayout();
        }

        function syncNiriLiquidGlass() {
            let mode = root.glassStyle;
            let p1 = "0", p2 = "0", p3 = "0", p4 = "0", p5 = "0";
            if (mode === "mac") {
                p1 = String(Number(root.macOpacity.toFixed(2)));
                p2 = String(Number(root.macFrost.toFixed(2)));
            } else if (mode === "aero") {
                p1 = String(Number(root.aeroBaseOpacity.toFixed(2)));
                p2 = String(Number(root.aeroSheenBright.toFixed(2)));
                p3 = String(Number(root.aeroSheenWidth.toFixed(2)));
            } else {
                // Parameter asli zaroutt/Niri-glass: refraction-strength 0.8..3.8, fringing 0.0..1.0, edge-lighting 0.5..1.15
                p1 = String(Number((0.8 + root.liquidRefraction * 3.0).toFixed(2)));
                p2 = String(Number(root.liquidFringing.toFixed(2)));
                p3 = String(Number((0.55 + root.liquidRefraction * 0.60).toFixed(2)));
                p4 = String(Number((0.15 + root.liquidRefraction * 0.35).toFixed(2)));
                p5 = String(Number(root.liquidOpacity.toFixed(2)));
            }
            niriGlassProc.command = [
                "sh", "-c",
                "python3 \"$HOME/.config/quickshell/sync_niri_glass.py\" \"$1\" \"$2\" \"$3\" \"$4\" \"$5\" \"$6\"",
                "sh", mode, p1, p2, p3, p4, p5
            ];
            niriGlassProc.running = false;
            niriGlassProc.running = true;
        }

        Process { id: niriGlassProc }

        function saveLayout() {
            let data = JSON.stringify({
                scale: Number(widgetScale.toFixed(2)),
                locked: widgetsLocked,
                dockWidgetsEnabled: root.dockWidgetsEnabled,
                dockItems: root.dockItems,
                dockLeftOrder: root.dockLeftOrder,
                dockRightOrder: root.dockRightOrder,
                noteText: quickNoteText,
                items: widgetStates,
                glassStyle: root.glassStyle,
                macOpacity: Number(root.macOpacity.toFixed(2)),
                macFrost: Number(root.macFrost.toFixed(2)),
                aeroBaseOpacity: Number(root.aeroBaseOpacity.toFixed(2)),
                aeroSheenBright: Number(root.aeroSheenBright.toFixed(2)),
                aeroSheenWidth: Number(root.aeroSheenWidth.toFixed(2)),
                liquidOpacity: Number(root.liquidOpacity.toFixed(2)),
                liquidRefraction: Number(root.liquidRefraction.toFixed(2)),
                liquidFringing: Number(root.liquidFringing.toFixed(2))
            });
            saveCfgProc.command = ["sh", "-c", "mkdir -p \"$HOME/.config/quickshell\" && printf '%s' \"$1\" > \"$HOME/.config/quickshell/widgets.json\"", "sh", data];
            saveCfgProc.running = true;
            syncNiriLiquidGlass();
        }

        function drawWidgetGlass(ctx, w, h, rad, itemX, itemY, isCircular) {
            let scrW = win.screen ? win.screen.width : 1366;
            let scrH = win.screen ? win.screen.height : 768;
            root.drawGlobalAeroGlass(ctx, w, h, rad, itemX, itemY + 28, scrW, scrH, !!isCircular, true);
        }

        Process { id: saveCfgProc }

        Process {
            id: loadCfgProc
            Component.onCompleted: running = true
            command: ["sh", "-c", "cat \"$HOME/.config/quickshell/widgets.json\" 2>/dev/null || true"]
            stdout: StdioCollector {
                onStreamFinished: {
                    if (!text || text.trim() === "") return;
                    try {
                        let obj = JSON.parse(text.trim());
                        if (typeof obj.scale === "number") win.widgetScale = Math.max(0.65, Math.min(1.5, obj.scale));
                        if (typeof obj.dockWidgetsEnabled === "boolean") root.dockWidgetsEnabled = obj.dockWidgetsEnabled;
                        if (obj.dockItems && typeof obj.dockItems === "object") {
                            let md = { focus: true, calendar: true, cpu: true, battery: true, media: true, settings: true };
                            for (let k in md) { if (typeof obj.dockItems[k] === "boolean") md[k] = obj.dockItems[k]; }
                            root.dockItems = md;
                        }
                        if (Array.isArray(obj.dockLeftOrder) && obj.dockLeftOrder.length === 4) root.dockLeftOrder = obj.dockLeftOrder;
                        if (Array.isArray(obj.dockRightOrder) && obj.dockRightOrder.length === 2) root.dockRightOrder = obj.dockRightOrder;
                        if (typeof obj.locked === "boolean") {
                            win.widgetsLocked = obj.locked;
                            root.widgetCfg.locked = obj.locked;
                        }
                        if (typeof obj.noteText === "string") {
                            win.quickNoteText = obj.noteText;
                            root.widgetCfg.noteText = obj.noteText;
                        }
                        if (obj.items && typeof obj.items === "object") {
                            let merged = win.defaultItems();
                            for (let k in merged) {
                                if (obj.items[k]) {
                                    merged[k].enabled = !!obj.items[k].enabled;
                                    if (typeof obj.items[k].x === "number") merged[k].x = obj.items[k].x;
                                    if (typeof obj.items[k].y === "number") merged[k].y = obj.items[k].y;
                                }
                            }
                            win.widgetStates = merged;
                            root.widgetCfg.items = merged;
                        }
                        if (obj.glassStyle === "mac" || obj.glassStyle === "aero" || obj.glassStyle === "liquid") root.glassStyle = obj.glassStyle;
                        if (typeof obj.liquidOpacity === "number") root.liquidOpacity = Math.max(0.10, Math.min(0.85, obj.liquidOpacity));
                        if (typeof obj.liquidRefraction === "number") root.liquidRefraction = Math.max(0.0, Math.min(1.0, obj.liquidRefraction));
                        if (typeof obj.liquidFringing === "number") root.liquidFringing = Math.max(0.0, Math.min(1.0, obj.liquidFringing));
                        win.syncNiriLiquidGlass();
                        if (typeof obj.macOpacity === "number") root.macOpacity = Math.max(0.10, Math.min(0.85, obj.macOpacity));
                        if (typeof obj.macFrost === "number") root.macFrost = Math.max(0.0, Math.min(1.0, obj.macFrost));
                        if (typeof obj.aeroBaseOpacity === "number") root.aeroBaseOpacity = Math.max(0.10, Math.min(0.85, obj.aeroBaseOpacity));
                        if (typeof obj.aeroSheenBright === "number") root.aeroSheenBright = Math.max(0.0, Math.min(1.0, obj.aeroSheenBright));
                        if (typeof obj.aeroSheenWidth === "number") root.aeroSheenWidth = Math.max(0.08, Math.min(1.0, obj.aeroSheenWidth));
                    } catch (e) {}
                }
            }
        }

        // Monitor CPU, RAM & Suhu Real-Time untuk Widget System Activity
        Process {
            id: sysMonProc
            Component.onCompleted: running = true
            command: ["sh", "-c", "read _ u1 n1 s1 i1 w1 q1 sq1 _ < /proc/stat; sleep 0.25; read _ u2 n2 s2 i2 w2 q2 sq2 _ < /proc/stat; t1=$((u1+n1+s1+i1+w1+q1+sq1)); t2=$((u2+n2+s2+i2+w2+q2+sq2)); dt=$((t2-t1)); di=$((i2-i1)); cpu=0; [ $dt -gt 0 ] && cpu=$(( (dt - di) * 100 / dt )); read mt ma <<< $(awk '/MemTotal/{t=$2} /MemAvailable/{a=$2} END{print t, a}' /proc/meminfo); mu=$((mt - ma)); rpct=$(( mu * 100 / mt )); rgib=$(awk -v u=$mu -v t=$mt 'BEGIN{printf \"%.1f / %.1f GB\", u/1048576, t/1048576}'); temp=45; for z in /sys/class/thermal/thermal_zone*/temp; do if [ -r \"$z\" ]; then v=$(cat \"$z\"); [ \"$v\" -gt 1000 ] && v=$((v/1000)); [ \"$v\" -gt 20 ] && [ \"$v\" -lt 115 ] && temp=$v && break; fi; done; printf '%s|%s|%s|%s\n' \"$cpu\" \"$rpct\" \"$rgib\" \"$temp\""]
            stdout: StdioCollector {
                onStreamFinished: {
                    let p = text.trim().split("|");
                    if (p.length >= 4) {
                        root.cpuUsagePct = Math.max(1, Math.min(100, parseInt(p[0]) || 1));
                        root.ramUsagePct = Math.max(1, Math.min(100, parseInt(p[1]) || 1));
                        root.ramUsageText = p[2];
                        root.cpuTempC = parseInt(p[3]) || 45;
                    }
                }
            }
        }

        Timer {
            interval: 3000
            running: win.isWidgetOn("sysmon")
            repeat: true
            onTriggered: { sysMonProc.running = false; sysMonProc.running = true; }
        }

        // Klik kanan area kosong desktop untuk memunculkan menu Atur; klik kiri untuk menutup
        MouseArea {
            anchors.fill: parent
            z: 0
            acceptedButtons: Qt.LeftButton | Qt.RightButton
            onClicked: (m) => {
                if (m.button === Qt.RightButton) {
                    win.openWidgetCtxMenu(m.x, m.y);
                } else {
                    win.ctxMenuVisible = false;
                    if (win.editMode) {
                        win.editMode = false;
                        win.saveLayout();
                    }
                }
            }
        }

        // Menu Konteks Kaca Klik Kanan ("Atur Widget")
        Item {
            id: widgetCtxMenu
            z: 60
            x: win.ctxMenuX
            y: win.ctxMenuY
            width: 156
            height: 112
            visible: win.ctxMenuVisible || opacity > 0.01
            opacity: win.ctxMenuVisible ? 1.0 : 0.0
            scale: win.ctxMenuVisible ? 1.0 : 0.90
            transformOrigin: Item.TopLeft

            Behavior on opacity { NumberAnimation { duration: 145; easing.type: Easing.InOutCubic } }
            Behavior on scale { NumberAnimation { duration: 165; easing.type: Easing.InOutCubic } }

            Canvas {
                anchors.fill: parent
                property real dX: widgetCtxMenu.x
                property real dY: widgetCtxMenu.y
                property real dO: root.aeroOpacity
                property real dR: root.aeroReflection
                property string dSt: root.glassStyle
                property real dTh: root.activeGlassDetail
                onDXChanged: requestPaint()
                onDYChanged: requestPaint()
                onDOChanged: requestPaint()
                onDRChanged: requestPaint()
                onDStChanged: requestPaint()
                onDThChanged: requestPaint()
                onPaint: win.drawWidgetGlass(getContext("2d"), width, height, 18, widgetCtxMenu.x, widgetCtxMenu.y, false)
            }

            ColumnLayout {
                anchors.fill: parent
                anchors.margins: 7
                spacing: 4

                // Opsi 1: Masuk / Keluar Mode Atur Widget
                Rectangle {
                    Layout.fillWidth: true
                    height: 30
                    radius: 13
                    color: ctxOpt1M.containsMouse ? "#34FFFFFF" : "transparent"
                    RowLayout {
                        anchors.fill: parent
                        anchors.leftMargin: 10
                        anchors.rightMargin: 10
                        Text { text: win.editMode ? "✓" : "✥"; color: "#A1C6FF"; font.pixelSize: 12; font.bold: true }
                        Text {
                            text: win.editMode ? "Selesai Atur" : "Atur Widget"
                            color: "#FFFFFF"
                            font.pixelSize: 11
                            font.bold: true
                        }
                        Item { Layout.fillWidth: true }
                    }
                    MouseArea {
                        id: ctxOpt1M
                        anchors.fill: parent
                        hoverEnabled: true
                        cursorShape: Qt.PointingHandCursor
                        onClicked: {
                            win.ctxMenuVisible = false;
                            if (win.editMode) {
                                win.editMode = false;
                                win.saveLayout();
                            } else {
                                win.editMode = true;
                            }
                        }
                    }
                }

                // Opsi 2: Kunci / Buka Kunci Posisi Widget
                Rectangle {
                    Layout.fillWidth: true
                    height: 30
                    radius: 13
                    color: ctxOpt2M.containsMouse ? "#34FFFFFF" : "transparent"
                    RowLayout {
                        anchors.fill: parent
                        anchors.leftMargin: 10
                        anchors.rightMargin: 10
                        Text { text: win.widgetsLocked ? "🔓" : "🔒"; font.pixelSize: 11 }
                        Text {
                            text: win.widgetsLocked ? "Buka Kunci" : "Lock Posisi"
                            color: "#F5F5F7"
                            font.pixelSize: 11
                        }
                        Item { Layout.fillWidth: true }
                    }
                    MouseArea {
                        id: ctxOpt2M
                        anchors.fill: parent
                        hoverEnabled: true
                        cursorShape: Qt.PointingHandCursor
                        onClicked: {
                            win.ctxMenuVisible = false;
                            win.toggleLock();
                        }
                    }
                }

                // Opsi 3: Tambah / Pilih Widget di Gallery
                Rectangle {
                    Layout.fillWidth: true
                    height: 30
                    radius: 13
                    color: ctxOpt3M.containsMouse ? "#34FFFFFF" : "transparent"
                    RowLayout {
                        anchors.fill: parent
                        anchors.leftMargin: 10
                        anchors.rightMargin: 10
                        Text { text: "+"; color: "#32D74B"; font.pixelSize: 14; font.bold: true }
                        Text {
                            text: "Pilih Widget"
                            color: "#F5F5F7"
                            font.pixelSize: 11
                        }
                        Item { Layout.fillWidth: true }
                    }
                    MouseArea {
                        id: ctxOpt3M
                        anchors.fill: parent
                        hoverEnabled: true
                        cursorShape: Qt.PointingHandCursor
                        onClicked: {
                            win.ctxMenuVisible = false;
                            root.settingsTab = "appearance";
                            root.switchPopup("settings");
                        }
                    }
                }
            }
        }

        // Bilah Kontrol Mengambang Saat Mode Atur Widget Aktif
        Rectangle {
            id: editToolbar
            z: 50
            anchors.top: parent.top
            anchors.horizontalCenter: parent.horizontalCenter
            anchors.topMargin: 12
            height: 38
            width: editToolbarRow.implicitWidth + 24
            radius: 19
            color: "#D9181A24"
            border.width: 1.1
            border.color: "#55FFFFFF"
            visible: win.editMode

            RowLayout {
                id: editToolbarRow
                anchors.centerIn: parent
                spacing: 8

                Text {
                    text: win.widgetsLocked ? "🔒 Terkunci" : "✥ Geser Tiap Widget"
                    color: win.widgetsLocked ? "#FFD60A" : "#E5E5EA"
                    font.pixelSize: 11
                    font.bold: true
                }

                // Tombol Lock / Unlock Posisi
                Rectangle {
                    height: 24; width: lockBtnTxt.implicitWidth + 16; radius: 12
                    color: win.widgetsLocked ? "#44FFD60A" : "#24FFFFFF"
                    border.width: 1; border.color: win.widgetsLocked ? "#88FFD60A" : "#3CFFFFFF"
                    Text {
                        id: lockBtnTxt
                        anchors.centerIn: parent
                        text: win.widgetsLocked ? "Buka Kunci" : "Lock"
                        color: "#FFFFFF"
                        font.pixelSize: 10
                        font.bold: true
                    }
                    MouseArea {
                        anchors.fill: parent
                        cursorShape: Qt.PointingHandCursor
                        onClicked: win.toggleLock()
                    }
                }

                // Tombol + Tambah / Pilih Widget (Buka Gallery di Settings)
                Rectangle {
                    height: 24; width: addWidTxt.implicitWidth + 16; radius: 12
                    color: "#28FFFFFF"
                    border.width: 1; border.color: "#44FFFFFF"
                    Text {
                        id: addWidTxt
                        anchors.centerIn: parent
                        text: "+ Widget"
                        color: "#A1C6FF"
                        font.pixelSize: 10
                        font.bold: true
                    }
                    MouseArea {
                        anchors.fill: parent
                        cursorShape: Qt.PointingHandCursor
                        onClicked: {
                            win.editMode = false;
                            win.saveLayout();
                            root.settingsTab = "appearance";
                            root.switchPopup("settings");
                        }
                    }
                }

                // Tombol Reset Posisi
                Rectangle {
                    height: 24; width: 48; radius: 12
                    color: "#24FFFFFF"
                    Text { anchors.centerIn: parent; text: "Reset"; color: "#FFFFFF"; font.pixelSize: 10 }
                    MouseArea {
                        anchors.fill: parent
                        cursorShape: Qt.PointingHandCursor
                        onClicked: win.resetLayout()
                    }
                }

                // Tombol Selesai
                Rectangle {
                    height: 24; width: 56; radius: 12
                    color: "#0A84FF"
                    Text { anchors.centerIn: parent; text: "Selesai"; color: "#FFFFFF"; font.pixelSize: 10; font.bold: true }
                    MouseArea {
                        anchors.fill: parent
                        cursorShape: Qt.PointingHandCursor
                        onClicked: {
                            win.editMode = false;
                            win.saveLayout();
                        }
                    }
                }
            }
        }

        // ====================================================================
        // WIDGET 1: MEDIA PLAYER (INDEPENDEN)
        // ====================================================================
        Item {
            id: wMedia
            x: win.getWidgetX("media")
            y: win.getWidgetY("media")
            width: 226
            height: 296
            scale: win.widgetScale
            transformOrigin: Item.TopLeft
            visible: win.isWidgetOn("media")
            opacity: root.bootStage >= 2 ? 1.0 : 0.0
            Behavior on opacity { NumberAnimation { duration: 145; easing.type: Easing.InOutCubic } }

            Canvas {
                anchors.fill: parent
                property real dX: wMedia.x
                property real dY: wMedia.y
                property real dO: root.aeroOpacity
                property real dR: root.aeroReflection
                property string dSt: root.glassStyle
                property real dTh: root.activeGlassDetail
                onDXChanged: requestPaint()
                onDYChanged: requestPaint()
                onDOChanged: requestPaint()
                onDRChanged: requestPaint()
                onDStChanged: requestPaint()
                onDThChanged: requestPaint()
                onPaint: win.drawWidgetGlass(getContext("2d"), width, height, 24, wMedia.x, wMedia.y, false)
            }

            ColumnLayout {
                anchors.fill: parent
                anchors.margins: 18
                spacing: 12

                RowLayout {
                    Layout.fillWidth: true
                    spacing: 12

                    Rectangle {
                        width: 64; height: 64; radius: 14
                        color: "#28FFFFFF"
                        border.width: 1
                        border.color: "#44FFFFFF"
                        clip: true
                        Image {
                            anchors.fill: parent
                            source: root.mediaArtUrl
                            fillMode: Image.PreserveAspectCrop
                            visible: root.mediaArtUrl !== "" && status === Image.Ready
                        }
                        Row {
                            anchors.centerIn: parent
                            spacing: 4
                            visible: !root.mediaArtUrl || root.mediaArtUrl === ""
                            Repeater {
                                model: [14, 24, 18]
                                Rectangle { width: 4; height: modelData; radius: 2; color: "#A1C6FF"; anchors.verticalCenter: parent.verticalCenter }
                            }
                        }
                    }

                    ColumnLayout {
                        Layout.fillWidth: true
                        spacing: 3
                        Text {
                            text: root.mediaTitle
                            color: "#FFFFFF"
                            font.pixelSize: 15
                            font.bold: true
                            elide: Text.ElideRight
                            Layout.fillWidth: true
                        }
                        Text {
                            text: root.mediaArtist
                            color: "#B4B4BC"
                            font.pixelSize: 12
                            elide: Text.ElideRight
                            Layout.fillWidth: true
                        }
                    }
                }

                Item { Layout.fillHeight: true }

                ColumnLayout {
                    Layout.fillWidth: true
                    spacing: 6
                    Rectangle {
                        Layout.fillWidth: true
                        height: 4; radius: 2; color: "#2CFFFFFF"
                        Rectangle {
                            width: root.mediaLength > 0 ? parent.width * Math.min(1, root.mediaPosition / root.mediaLength) : 0
                            height: 4; radius: 2; color: "#A1C6FF"
                        }
                    }
                    RowLayout {
                        Layout.fillWidth: true
                        Text { text: root.formatTime(root.mediaPosition); color: "#8E8E93"; font.pixelSize: 10 }
                        Item { Layout.fillWidth: true }
                        Text { text: root.formatTime(root.mediaLength); color: "#8E8E93"; font.pixelSize: 10 }
                    }
                }

                RowLayout {
                    Layout.alignment: Qt.AlignHCenter
                    spacing: 22

                    Text {
                        text: "⏮"
                        color: "#FFFFFF"
                        font.pixelSize: 18
                        MouseArea { anchors.fill: parent; cursorShape: Qt.PointingHandCursor; onClicked: root.runCmd("playerctl previous") }
                    }

                    Rectangle {
                        width: 44; height: 44; radius: 22
                        color: "#A1C6FF"
                        Text {
                            anchors.centerIn: parent
                            text: root.mediaPlaying ? "⏸" : "▶"
                            color: "#0C101A"
                            font.pixelSize: 16
                            font.bold: true
                        }
                        MouseArea { anchors.fill: parent; cursorShape: Qt.PointingHandCursor; onClicked: root.runCmd("playerctl play-pause") }
                    }

                    Text {
                        text: "⏭"
                        color: "#FFFFFF"
                        font.pixelSize: 18
                        MouseArea { anchors.fill: parent; cursorShape: Qt.PointingHandCursor; onClicked: root.runCmd("playerctl next") }
                    }
                }
            }

            // Drag Handle Saat Edit Mode (Tidak Aktif Jika Locked)
            MouseArea {
                anchors.fill: parent
                z: 18
                acceptedButtons: Qt.RightButton
                onClicked: (m) => {
                    let p = mapToItem(win.contentItem, m.x, m.y);
                    win.openWidgetCtxMenu(p.x, p.y);
                }
            }

            MouseArea {
                anchors.fill: parent
                z: 20
                visible: win.editMode && !win.widgetsLocked
                cursorShape: Qt.SizeAllCursor
                property real sx: 0; property real sy: 0; property real ox: 0; property real oy: 0
                onPressed: (m) => { let p = mapToItem(win.contentItem, m.x, m.y); sx = p.x; sy = p.y; ox = wMedia.x; oy = wMedia.y; }
                onPositionChanged: (m) => { if (pressed) { let p = mapToItem(win.contentItem, m.x, m.y); win.setWidgetPos("media", ox + (p.x - sx), oy + (p.y - sy)); } }
                onReleased: win.saveLayout()
            }

            // Tombol Sembunyikan Widget Saat Edit Mode
            Rectangle {
                anchors.top: parent.top; anchors.left: parent.left; anchors.margins: -6
                z: 25; width: 22; height: 22; radius: 11
                color: "#FF453A"; border.width: 1; border.color: "#FFFFFF"
                visible: win.editMode
                Text { anchors.centerIn: parent; text: "×"; color: "#FFFFFF"; font.pixelSize: 13; font.bold: true }
                MouseArea { anchors.fill: parent; cursorShape: Qt.PointingHandCursor; onClicked: win.setWidgetEnabled("media", false) }
            }
        }

        // ====================================================================
        // WIDGET 2: ANALOG CLOCK (KLIK GANDA TIDAK UBAH WALLPAPER)
        // ====================================================================
        Item {
            id: wClock
            x: win.getWidgetX("clock")
            y: win.getWidgetY("clock")
            width: 148
            height: 148
            scale: win.widgetScale
            transformOrigin: Item.TopLeft
            visible: win.isWidgetOn("clock")
            opacity: root.bootStage >= 3 ? 1.0 : 0.0
            Behavior on opacity { NumberAnimation { duration: 145; easing.type: Easing.InOutCubic } }

            Canvas {
                anchors.fill: parent
                property real dX: wClock.x
                property real dY: wClock.y
                property real dO: root.aeroOpacity
                property real dR: root.aeroReflection
                property string dSt: root.glassStyle
                property real dTh: root.activeGlassDetail
                onDXChanged: requestPaint()
                onDYChanged: requestPaint()
                onDOChanged: requestPaint()
                onDRChanged: requestPaint()
                onDStChanged: requestPaint()
                onDThChanged: requestPaint()
                onPaint: win.drawWidgetGlass(getContext("2d"), width, height, 74, wClock.x, wClock.y, true)
            }

            Canvas {
                id: analogClockFace
                anchors.fill: parent
                property date now: new Date()
                Timer {
                    interval: 1000
                    running: wClock.visible
                    repeat: true
                    onTriggered: { analogClockFace.now = new Date(); analogClockFace.requestPaint(); }
                }
                onPaint: {
                    let ctx = getContext("2d");
                    ctx.reset();
                    let cx = width / 2, cy = height / 2, r = width / 2 - 8;
                    for (let i = 0; i < 60; i++) {
                        let ang = (i * 6 - 90) * Math.PI / 180;
                        let isMajor = i % 5 === 0;
                        let r1 = isMajor ? r - 9 : r - 4;
                        ctx.strokeStyle = isMajor ? "rgba(255,255,255,0.88)" : "rgba(255,255,255,0.34)";
                        ctx.lineWidth = isMajor ? 1.8 : 1.0;
                        ctx.beginPath();
                        ctx.moveTo(cx + Math.cos(ang) * r1, cy + Math.sin(ang) * r1);
                        ctx.lineTo(cx + Math.cos(ang) * r, cy + Math.sin(ang) * r);
                        ctx.stroke();
                    }
                    let days = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];
                    ctx.fillStyle = "rgba(235,235,245,0.78)";
                    ctx.font = "600 10px sans-serif";
                    ctx.textAlign = "center";
                    ctx.fillText(days[now.getDay()] + " " + now.getDate(), cx, cy + 22);

                    let sec = now.getSeconds();
                    let min = now.getMinutes() + sec / 60;
                    let hr = (now.getHours() % 12) + min / 60;

                    let hAng = (hr * 30 - 90) * Math.PI / 180;
                    ctx.strokeStyle = "#FFFFFF";
                    ctx.lineWidth = 3.2;
                    ctx.lineCap = "round";
                    ctx.beginPath();
                    ctx.moveTo(cx, cy);
                    ctx.lineTo(cx + Math.cos(hAng) * (r * 0.52), cy + Math.sin(hAng) * (r * 0.52));
                    ctx.stroke();

                    let mAng = (min * 6 - 90) * Math.PI / 180;
                    ctx.lineWidth = 2.2;
                    ctx.beginPath();
                    ctx.moveTo(cx, cy);
                    ctx.lineTo(cx + Math.cos(mAng) * (r * 0.74), cy + Math.sin(mAng) * (r * 0.74));
                    ctx.stroke();

                    let sAng = (sec * 6 - 90) * Math.PI / 180;
                    ctx.strokeStyle = "#FF9F0A";
                    ctx.lineWidth = 1.4;
                    ctx.beginPath();
                    ctx.moveTo(cx - Math.cos(sAng) * 10, cy - Math.sin(sAng) * 10);
                    ctx.lineTo(cx + Math.cos(sAng) * (r * 0.80), cy + Math.sin(sAng) * (r * 0.80));
                    ctx.stroke();

                    ctx.fillStyle = "#FF9F0A";
                    ctx.beginPath();
                    ctx.arc(cx, cy, 3.2, 0, Math.PI * 2);
                    ctx.fill();
                }
            }
            MouseArea {
                anchors.fill: parent
                z: 18
                acceptedButtons: Qt.RightButton
                onClicked: (m) => {
                    let p = mapToItem(win.contentItem, m.x, m.y);
                    win.openWidgetCtxMenu(p.x, p.y);
                }
            }

            MouseArea {
                anchors.fill: parent
                z: 20
                visible: win.editMode && !win.widgetsLocked
                cursorShape: Qt.SizeAllCursor
                property real sx: 0; property real sy: 0; property real ox: 0; property real oy: 0
                onPressed: (m) => { let p = mapToItem(win.contentItem, m.x, m.y); sx = p.x; sy = p.y; ox = wClock.x; oy = wClock.y; }
                onPositionChanged: (m) => { if (pressed) { let p = mapToItem(win.contentItem, m.x, m.y); win.setWidgetPos("clock", ox + (p.x - sx), oy + (p.y - sy)); } }
                onReleased: win.saveLayout()
            }

            Rectangle {
                anchors.top: parent.top; anchors.left: parent.left; anchors.margins: -4
                z: 25; width: 22; height: 22; radius: 11
                color: "#FF453A"; border.width: 1; border.color: "#FFFFFF"
                visible: win.editMode
                Text { anchors.centerIn: parent; text: "×"; color: "#FFFFFF"; font.pixelSize: 13; font.bold: true }
                MouseArea { anchors.fill: parent; cursorShape: Qt.PointingHandCursor; onClicked: win.setWidgetEnabled("clock", false) }
            }
        }

        // ====================================================================
        // WIDGET 3: WEATHER (KLIK REFRESH CUACA)
        // ====================================================================
        Item {
            id: wWeather
            x: win.getWidgetX("weather")
            y: win.getWidgetY("weather")
            width: 148
            height: 136
            scale: win.widgetScale
            transformOrigin: Item.TopLeft
            visible: win.isWidgetOn("weather")
            opacity: root.bootStage >= 4 ? 1.0 : 0.0
            Behavior on opacity { NumberAnimation { duration: 145; easing.type: Easing.InOutCubic } }

            Canvas {
                anchors.fill: parent
                property real dX: wWeather.x
                property real dY: wWeather.y
                property real dO: root.aeroOpacity
                property real dR: root.aeroReflection
                property string dSt: root.glassStyle
                property real dTh: root.activeGlassDetail
                onDXChanged: requestPaint()
                onDYChanged: requestPaint()
                onDOChanged: requestPaint()
                onDRChanged: requestPaint()
                onDStChanged: requestPaint()
                onDThChanged: requestPaint()
                onPaint: win.drawWidgetGlass(getContext("2d"), width, height, 24, wWeather.x, wWeather.y, false)
            }

            ColumnLayout {
                anchors.fill: parent
                anchors.margins: 14
                spacing: 4

                Text {
                    text: root.weatherCity
                    color: "#D1D1D6"
                    font.pixelSize: 11
                    font.weight: Font.Medium
                    elide: Text.ElideRight
                    Layout.fillWidth: true
                }
                Text {
                    text: root.weatherTemp
                    color: "#FFFFFF"
                    font.pixelSize: 34
                    font.weight: Font.Light
                }
                Item { Layout.fillHeight: true }
                Text { text: root.weatherIcon; font.pixelSize: 15 }
                Text {
                    text: root.weatherDesc
                    color: "#E5E5EA"
                    font.pixelSize: 10
                    elide: Text.ElideRight
                    Layout.fillWidth: true
                }
            }

            MouseArea {
                anchors.fill: parent
                visible: !win.editMode
                cursorShape: Qt.PointingHandCursor
                onClicked: root.refreshWeather()
            }

            MouseArea {
                anchors.fill: parent
                z: 18
                acceptedButtons: Qt.RightButton
                onClicked: (m) => {
                    let p = mapToItem(win.contentItem, m.x, m.y);
                    win.openWidgetCtxMenu(p.x, p.y);
                }
            }

            MouseArea {
                anchors.fill: parent
                z: 20
                visible: win.editMode && !win.widgetsLocked
                cursorShape: Qt.SizeAllCursor
                property real sx: 0; property real sy: 0; property real ox: 0; property real oy: 0
                onPressed: (m) => { let p = mapToItem(win.contentItem, m.x, m.y); sx = p.x; sy = p.y; ox = wWeather.x; oy = wWeather.y; }
                onPositionChanged: (m) => { if (pressed) { let p = mapToItem(win.contentItem, m.x, m.y); win.setWidgetPos("weather", ox + (p.x - sx), oy + (p.y - sy)); } }
                onReleased: win.saveLayout()
            }

            Rectangle {
                anchors.top: parent.top; anchors.left: parent.left; anchors.margins: -6
                z: 25; width: 22; height: 22; radius: 11
                color: "#FF453A"; border.width: 1; border.color: "#FFFFFF"
                visible: win.editMode
                Text { anchors.centerIn: parent; text: "×"; color: "#FFFFFF"; font.pixelSize: 13; font.bold: true }
                MouseArea { anchors.fill: parent; cursorShape: Qt.PointingHandCursor; onClicked: win.setWidgetEnabled("weather", false) }
            }
        }

        // ====================================================================
        // WIDGET 4: BATTERIES RING ALA MACOS (INDEPENDEN)
        // ====================================================================
        Item {
            id: wBattery
            x: win.getWidgetX("battery")
            y: win.getWidgetY("battery")
            width: 226
            height: 116
            scale: win.widgetScale
            transformOrigin: Item.TopLeft
            visible: win.isWidgetOn("battery")

            Canvas {
                anchors.fill: parent
                property real dX: wBattery.x
                property real dY: wBattery.y
                property real dO: root.aeroOpacity
                property real dR: root.aeroReflection
                property string dSt: root.glassStyle
                property real dTh: root.activeGlassDetail
                onDXChanged: requestPaint()
                onDYChanged: requestPaint()
                onDOChanged: requestPaint()
                onDRChanged: requestPaint()
                onDStChanged: requestPaint()
                onDThChanged: requestPaint()
                onPaint: win.drawWidgetGlass(getContext("2d"), width, height, 24, wBattery.x, wBattery.y, false)
            }

            RowLayout {
                anchors.fill: parent
                anchors.margins: 16
                spacing: 14

                // Cincin Baterai Laptop
                Item {
                    width: 68; height: 68
                    Canvas {
                        anchors.fill: parent
                        property int pct: root.batteryPercent >= 0 ? root.batteryPercent : 100
                        property string st: root.batteryStatus
                        onPctChanged: requestPaint()
                        onStChanged: requestPaint()
                        onPaint: {
                            let ctx = getContext("2d");
                            ctx.reset();
                            let cx = width / 2, cy = height / 2, r = 28;
                            ctx.strokeStyle = "rgba(255,255,255,0.18)";
                            ctx.lineWidth = 6;
                            ctx.beginPath();
                            ctx.arc(cx, cy, r, 0, Math.PI * 2);
                            ctx.stroke();

                            let frac = Math.max(0.02, Math.min(1.0, pct / 100));
                            ctx.strokeStyle = st === "Charging" ? "#32D74B" : (pct <= 20 ? "#FF453A" : "#30D158");
                            ctx.lineCap = "round";
                            ctx.beginPath();
                            ctx.arc(cx, cy, r, -Math.PI / 2, -Math.PI / 2 + frac * Math.PI * 2);
                            ctx.stroke();
                        }
                    }
                    Text {
                        anchors.centerIn: parent
                        text: root.batteryPercent >= 0 ? (root.batteryPercent + "%") : "AC"
                        color: "#FFFFFF"
                        font.pixelSize: 13
                        font.bold: true
                    }
                }

                ColumnLayout {
                    Layout.fillWidth: true
                    spacing: 4
                    Text {
                        text: "ThinkPad L14"
                        color: "#FFFFFF"
                        font.pixelSize: 13
                        font.bold: true
                    }
                    Text {
                        text: root.batteryStatus === "Charging" ? "⚡ Sedang Mengisi" : "Daya Baterai"
                        color: "#32D74B"
                        font.pixelSize: 11
                    }
                    Text {
                        text: root.btDeviceName !== "" ? ("ᛒ " + root.btDeviceName) : "ᛒ Bluetooth Standby"
                        color: "#C7C7CC"
                        font.pixelSize: 10
                        elide: Text.ElideRight
                        Layout.fillWidth: true
                    }
                }
            }

            MouseArea {
                anchors.fill: parent
                z: 18
                acceptedButtons: Qt.RightButton
                onClicked: (m) => {
                    let p = mapToItem(win.contentItem, m.x, m.y);
                    win.openWidgetCtxMenu(p.x, p.y);
                }
            }

            MouseArea {
                anchors.fill: parent
                z: 20
                visible: win.editMode && !win.widgetsLocked
                cursorShape: Qt.SizeAllCursor
                property real sx: 0; property real sy: 0; property real ox: 0; property real oy: 0
                onPressed: (m) => { let p = mapToItem(win.contentItem, m.x, m.y); sx = p.x; sy = p.y; ox = wBattery.x; oy = wBattery.y; }
                onPositionChanged: (m) => { if (pressed) { let p = mapToItem(win.contentItem, m.x, m.y); win.setWidgetPos("battery", ox + (p.x - sx), oy + (p.y - sy)); } }
                onReleased: win.saveLayout()
            }

            Rectangle {
                anchors.top: parent.top; anchors.left: parent.left; anchors.margins: -6
                z: 25; width: 22; height: 22; radius: 11
                color: "#FF453A"; border.width: 1; border.color: "#FFFFFF"
                visible: win.editMode
                Text { anchors.centerIn: parent; text: "×"; color: "#FFFFFF"; font.pixelSize: 13; font.bold: true }
                MouseArea { anchors.fill: parent; cursorShape: Qt.PointingHandCursor; onClicked: win.setWidgetEnabled("battery", false) }
            }
        }

        // ====================================================================
        // WIDGET 5: SYSTEM ACTIVITY (CPU / RAM / SUHU REAL-TIME)
        // ====================================================================
        Item {
            id: wSysmon
            x: win.getWidgetX("sysmon")
            y: win.getWidgetY("sysmon")
            width: 226
            height: 116
            scale: win.widgetScale
            transformOrigin: Item.TopLeft
            visible: win.isWidgetOn("sysmon")

            Canvas {
                anchors.fill: parent
                property real dX: wSysmon.x
                property real dY: wSysmon.y
                property real dO: root.aeroOpacity
                property real dR: root.aeroReflection
                property string dSt: root.glassStyle
                property real dTh: root.activeGlassDetail
                onDXChanged: requestPaint()
                onDYChanged: requestPaint()
                onDOChanged: requestPaint()
                onDRChanged: requestPaint()
                onDStChanged: requestPaint()
                onDThChanged: requestPaint()
                onPaint: win.drawWidgetGlass(getContext("2d"), width, height, 24, wSysmon.x, wSysmon.y, false)
            }

            ColumnLayout {
                anchors.fill: parent
                anchors.margins: 14
                spacing: 7

                RowLayout {
                    Layout.fillWidth: true
                    Text { text: "System Activity"; color: "#FFFFFF"; font.pixelSize: 12; font.bold: true }
                    Item { Layout.fillWidth: true }
                    Text { text: root.cpuTempC + "°C"; color: root.cpuTempC > 75 ? "#FF453A" : "#64D2FF"; font.pixelSize: 11; font.bold: true }
                }

                // CPU Bar
                ColumnLayout {
                    Layout.fillWidth: true
                    spacing: 3
                    RowLayout {
                        Layout.fillWidth: true
                        Text { text: "CPU Ryzen 5"; color: "#D1D1D6"; font.pixelSize: 10 }
                        Item { Layout.fillWidth: true }
                        Text { text: root.cpuUsagePct + "%"; color: "#FFFFFF"; font.pixelSize: 10; font.bold: true }
                    }
                    Rectangle {
                        Layout.fillWidth: true; height: 5; radius: 2.5; color: "#28FFFFFF"
                        Rectangle {
                            width: parent.width * (root.cpuUsagePct / 100)
                            height: 5; radius: 2.5; color: "#0A84FF"
                            Behavior on width { NumberAnimation { duration: 250 } }
                        }
                    }
                }

                // RAM Bar
                ColumnLayout {
                    Layout.fillWidth: true
                    spacing: 3
                    RowLayout {
                        Layout.fillWidth: true
                        Text { text: "Memory"; color: "#D1D1D6"; font.pixelSize: 10 }
                        Item { Layout.fillWidth: true }
                        Text { text: root.ramUsageText; color: "#FFFFFF"; font.pixelSize: 10; font.bold: true }
                    }
                    Rectangle {
                        Layout.fillWidth: true; height: 5; radius: 2.5; color: "#28FFFFFF"
                        Rectangle {
                            width: parent.width * (root.ramUsagePct / 100)
                            height: 5; radius: 2.5; color: "#BF5AF2"
                            Behavior on width { NumberAnimation { duration: 250 } }
                        }
                    }
                }
            }

            MouseArea {
                anchors.fill: parent
                z: 18
                acceptedButtons: Qt.RightButton
                onClicked: (m) => {
                    let p = mapToItem(win.contentItem, m.x, m.y);
                    win.openWidgetCtxMenu(p.x, p.y);
                }
            }

            MouseArea {
                anchors.fill: parent
                z: 20
                visible: win.editMode && !win.widgetsLocked
                cursorShape: Qt.SizeAllCursor
                property real sx: 0; property real sy: 0; property real ox: 0; property real oy: 0
                onPressed: (m) => { let p = mapToItem(win.contentItem, m.x, m.y); sx = p.x; sy = p.y; ox = wSysmon.x; oy = wSysmon.y; }
                onPositionChanged: (m) => { if (pressed) { let p = mapToItem(win.contentItem, m.x, m.y); win.setWidgetPos("sysmon", ox + (p.x - sx), oy + (p.y - sy)); } }
                onReleased: win.saveLayout()
            }

            Rectangle {
                anchors.top: parent.top; anchors.left: parent.left; anchors.margins: -6
                z: 25; width: 22; height: 22; radius: 11
                color: "#FF453A"; border.width: 1; border.color: "#FFFFFF"
                visible: win.editMode
                Text { anchors.centerIn: parent; text: "×"; color: "#FFFFFF"; font.pixelSize: 13; font.bold: true }
                MouseArea { anchors.fill: parent; cursorShape: Qt.PointingHandCursor; onClicked: win.setWidgetEnabled("sysmon", false) }
            }
        }

        // ====================================================================
        // WIDGET 6: CALENDAR & INTERACTIVE QUICK NOTES (BISA LANGSUNG DIISI)
        // ====================================================================
        Item {
            id: wNotes
            x: win.getWidgetX("notes")
            y: win.getWidgetY("notes")
            width: 226
            height: 206
            scale: win.widgetScale
            transformOrigin: Item.TopLeft
            visible: win.isWidgetOn("notes")

            SystemClock {
                id: notesClock
                precision: SystemClock.Minutes
            }

            Canvas {
                anchors.fill: parent
                property real dX: wNotes.x
                property real dY: wNotes.y
                property real dO: root.aeroOpacity
                property real dR: root.aeroReflection
                property string dSt: root.glassStyle
                property real dTh: root.activeGlassDetail
                property real dSc: win.widgetScale
                onDXChanged: requestPaint()
                onDYChanged: requestPaint()
                onDOChanged: requestPaint()
                onDRChanged: requestPaint()
                onDStChanged: requestPaint()
                onDThChanged: requestPaint()
                onDScChanged: requestPaint()
                onPaint: win.drawWidgetGlass(getContext("2d"), width, height, 24, wNotes.x, wNotes.y, false)
            }

            ColumnLayout {
                anchors.fill: parent
                anchors.margins: 14
                spacing: 8

                // Header Kalender Hari Ini ala macOS
                RowLayout {
                    Layout.fillWidth: true
                    spacing: 8

                    Rectangle {
                        Layout.preferredWidth: 34
                        Layout.preferredHeight: 34
                        radius: 10
                        color: "#22FFFFFF"
                        border.width: 1; border.color: "#38FFFFFF"
                        Column {
                            anchors.centerIn: parent
                            spacing: -1
                            Text {
                                anchors.horizontalCenter: parent.horizontalCenter
                                text: notesClock.date.toLocaleString(Qt.locale("id_ID"), "ddd").toUpperCase()
                                color: "#FF453A"
                                font.pixelSize: 8
                                font.bold: true
                            }
                            Text {
                                anchors.horizontalCenter: parent.horizontalCenter
                                text: Qt.formatDate(notesClock.date, "d")
                                color: "#FFFFFF"
                                font.pixelSize: 13
                                font.bold: true
                            }
                        }
                    }

                    ColumnLayout {
                        Layout.fillWidth: true
                        spacing: 0
                        Text {
                            text: notesClock.date.toLocaleString(Qt.locale("id_ID"), "MMMM yyyy")
                            color: "#FFFFFF"
                            font.pixelSize: 12
                            font.bold: true
                        }
                        Text {
                            text: win.editMode ? "Mode Atur Widget" : "Quick Notes • Klik untuk mengetik"
                            color: "#AEAEB2"
                            font.pixelSize: 9
                        }
                    }
                }

                // Area Tulis Catatan Interaktif (Auto-Save & Auto-Scroll)
                Rectangle {
                    Layout.fillWidth: true
                    Layout.fillHeight: true
                    radius: 14
                    color: noteInputArea.activeFocus ? "#24FFFFFF" : "#14FFFFFF"
                    border.width: 1
                    border.color: noteInputArea.activeFocus ? "#66A1C6FF" : "#28FFFFFF"

                    Timer {
                        id: noteSaveDebounce
                        interval: 600
                        onTriggered: win.saveLayout()
                    }

                    Flickable {
                        id: noteFlick
                        anchors.fill: parent
                        anchors.margins: 8
                        contentWidth: width
                        contentHeight: Math.max(noteInputArea.paintedHeight, height)
                        clip: true

                        Text {
                            anchors.fill: parent
                            text: "Tulis catatan di sini..."
                            color: "#66FFFFFF"
                            font.pixelSize: 11
                            visible: noteInputArea.text.length === 0 && !noteInputArea.activeFocus && !win.editMode
                        }

                        TextEdit {
                            id: noteInputArea
                            width: noteFlick.width
                            height: Math.max(paintedHeight, noteFlick.height)
                            wrapMode: TextEdit.Wrap
                            selectByMouse: true
                            color: "#F5F5F7"
                            selectionColor: "#550A84FF"
                            font.pixelSize: 11
                            text: win.quickNoteText
                            enabled: !win.editMode
                            onCursorRectangleChanged: {
                                let r = cursorRectangle;
                                if (r.y < noteFlick.contentY) {
                                    noteFlick.contentY = r.y;
                                } else if (r.y + r.height > noteFlick.contentY + noteFlick.height) {
                                    noteFlick.contentY = r.y + r.height - noteFlick.height;
                                }
                            }
                            onActiveFocusChanged: {
                                if (!activeFocus && noteSaveDebounce.running) {
                                    noteSaveDebounce.stop();
                                    win.saveLayout();
                                }
                            }
                            Component.onDestruction: {
                                if (noteSaveDebounce.running) {
                                    noteSaveDebounce.stop();
                                    win.saveLayout();
                                }
                            }
                            onTextChanged: {
                                if (win.quickNoteText !== text) {
                                    win.quickNoteText = text;
                                    root.widgetCfg.noteText = text;
                                    noteSaveDebounce.restart();
                                }
                            }
                        }
                    }
                }
            }

            MouseArea {
                anchors.fill: parent
                z: 18
                acceptedButtons: Qt.RightButton
                onClicked: (m) => {
                    let p = mapToItem(win.contentItem, m.x, m.y);
                    win.openWidgetCtxMenu(p.x, p.y);
                }
            }

            MouseArea {
                anchors.fill: parent
                z: 20
                visible: win.editMode && !win.widgetsLocked
                cursorShape: Qt.SizeAllCursor
                property real sx: 0; property real sy: 0; property real ox: 0; property real oy: 0
                onPressed: (m) => { let p = mapToItem(win.contentItem, m.x, m.y); sx = p.x; sy = p.y; ox = wNotes.x; oy = wNotes.y; }
                onPositionChanged: (m) => { if (pressed) { let p = mapToItem(win.contentItem, m.x, m.y); win.setWidgetPos("notes", ox + (p.x - sx), oy + (p.y - sy)); } }
                onReleased: win.saveLayout()
            }

            Rectangle {
                anchors.top: parent.top; anchors.left: parent.left; anchors.margins: -6
                z: 25; width: 22; height: 22; radius: 11
                color: "#FF453A"; border.width: 1; border.color: "#FFFFFF"
                visible: win.editMode
                Text { anchors.centerIn: parent; text: "×"; color: "#FFFFFF"; font.pixelSize: 13; font.bold: true }
                MouseArea { anchors.fill: parent; cursorShape: Qt.PointingHandCursor; onClicked: win.setWidgetEnabled("notes", false) }
            }
        }
    }

    // 6. MACOS FLOATING DOCK (AUTO-HIDE + REGION MASK)
    // ========================================================================
    PanelWindow {
        id: macDockWin
        anchors.bottom: true
        anchors.left: true
        anchors.right: true
        implicitHeight: 132
        exclusionMode: ExclusionMode.Ignore
        WlrLayershell.layer: WlrLayer.Overlay
        WlrLayershell.namespace: "quickshell-macos-dock"
        WlrLayershell.keyboardFocus: WlrKeyboardFocus.None
        color: "transparent"

        property bool dwellTriggered: false
        property bool startupPeek: true
        readonly property bool isDockOpen: !win.editMode && (dwellTriggered || startupPeek)
        property var runningList: []

        // Tetap aktif selama tidak di Edit Mode (atau saat animasi slide-down berjalan)
        visible: !win.editMode || macDockPill.slideY < 82

        // Region Mask: hanya menangkap mouse pada strip 4px tepi bawah saat tersembunyi,
        // dan melebar mengikuti kapsul Dock + area ikon membesar saat terbuka
        mask: Region {
            item: macDockMaskItem
        }

        Item {
            id: macDockMaskItem
            readonly property real targetPillW: Math.max(220, macDockPill.width)
            readonly property real targetPillX: (parent.width - targetPillW) * 0.5
            x: win.editMode ? 0 : Math.max(0, targetPillX - (macDockWin.isDockOpen ? 24 : 4))
            y: win.editMode ? parent.height : (macDockWin.isDockOpen ? 0 : parent.height - 3)
            width: win.editMode ? 0 : Math.min(parent.width, targetPillW + (macDockWin.isDockOpen ? 48 : 8))
            height: win.editMode ? 0 : (macDockWin.isDockOpen ? parent.height : 3)
        }

        onIsDockOpenChanged: {
            if (isDockOpen) {
                macDockHideTimer.stop();
            } else {
                macDockPill.pointerActive = false;
                macDockPill.pointerScreenX = -1000;
            }
        }

        Timer {
            id: macDockStartupTimer
            interval: 1500
            running: true
            repeat: false
            onTriggered: macDockWin.startupPeek = false
        }

        // Edge Dwell ~115ms ala macOS agar tidak terpanggil tak sengaja saat menyentuh tepi layar
        Timer {
            id: macDockDwellTimer
            interval: 115
            repeat: false
            onTriggered: {
                if (!win.editMode && dockInputHandler.hovered) {
                    macDockWin.dwellTriggered = true;
                }
            }
        }

        // Jedah singkat ~280ms sebelum turun bersembunyi saat kursor meninggalkan zona Dock
        Timer {
            id: macDockHideTimer
            interval: 280
            repeat: false
            onTriggered: {
                if (!dockInputHandler.hovered) {
                    macDockWin.dwellTriggered = false;
                    macDockWin.startupPeek = false;
                }
            }
        }

        function findRunningWinId(matchKey) {
            if (!matchKey || matchKey === "") return -1;
            let key = matchKey.toLowerCase();
            for (let i = 0; i < runningList.length; i++) {
                let w = runningList[i];
                let appId = (w.app_id || "").toLowerCase();
                let title = (w.title || "").toLowerCase();
                if (appId.includes(key) || title.includes(key)) return w.id;
            }
            return -1;
        }

        Process {
            id: macDockWinProc
            command: ["niri", "msg", "-j", "windows"]
            stdout: SplitParser {
                splitMarker: ""
                onRead: data => {
                    try {
                        let parsed = JSON.parse(data);
                        if (Array.isArray(parsed)) macDockWin.runningList = parsed;
                    } catch (e) {}
                }
            }
        }

        Timer {
            interval: 2000
            running: macDockWin.isDockOpen
            repeat: true
            triggeredOnStart: true
            onTriggered: macDockWinProc.running = true
        }

        // Input Root berkoordinat layar penuh yang statis (0 .. Screen.width) -> Anti-Jitter 100%
        Item {
            id: macDockInputRoot
            anchors.fill: parent

            HoverHandler {
                id: dockInputHandler
                enabled: !win.editMode
                onHoveredChanged: {
                    if (hovered) {
                        macDockHideTimer.stop();
                        if (macDockWin.isDockOpen) {
                            macDockPill.pointerActive = true;
                            macDockPill.pointerScreenX = point.position.x;
                        } else {
                            macDockDwellTimer.restart();
                        }
                    } else {
                        macDockDwellTimer.stop();
                        macDockPill.pointerActive = false;
                        macDockPill.pointerScreenX = -1000;
                        macDockHideTimer.restart();
                    }
                }
                onPointChanged: {
                    if (!hovered) return;
                    if (macDockWin.isDockOpen) {
                        macDockPill.pointerActive = true;
                        macDockPill.pointerScreenX = point.position.x;
                    } else if (!macDockDwellTimer.running) {
                        macDockDwellTimer.restart();
                    }
                }
            }

            Rectangle {
                id: macDockPill
                anchors.bottom: parent.bottom
                anchors.bottomMargin: 8
                anchors.horizontalCenter: parent.horizontalCenter
                height: 58
                width: Math.round(macDockRow.width + 24)
                radius: 19
                color: "transparent"

                property bool pointerActive: false
                property real pointerScreenX: -1000
                property real slideY: macDockWin.isDockOpen ? 0 : 86

                // Jarak vertikal kapsul kaca saat sembunyi/muncul (Critically Damped Spring tanpa overshoot)
                opacity: macDockWin.isDockOpen ? 1.0 : 0.0
                transform: Translate { y: macDockPill.slideY }

                Behavior on slideY {
                    SpringAnimation {
                        spring: 6.4
                        damping: 0.94
                        epsilon: 0.002
                    }
                }
                Behavior on opacity {
                    NumberAnimation {
                        duration: 150
                        easing.type: Easing.InOutCubic
                    }
                }

                // Kalkulasi pembesaran berbasis koordinat layar statis (tidak terpengaruh lebar dinamis kapsul)
                function calcMag(slotIndex) {
                    if (!pointerActive || pointerScreenX < 0 || !macDockWin.isDockOpen) return 1.0;
                    let cnt = macDockRepeater.count;
                    if (cnt <= 0) return 1.0;
                    let basePitch = 46.0; // 40px ikon + 6px spacing
                    let restRowW = cnt * 40.0 + Math.max(0, cnt - 1) * 6.0;
                    let restLeftX = (macDockWin.width - restRowW) * 0.5;
                    let restCenterX = restLeftX + slotIndex * basePitch + 20.0;

                    let dist = Math.abs(pointerScreenX - restCenterX);
                    let radius = 112.0;
                    if (dist >= radius) return 1.0;
                    let bell = 0.5 * (1.0 + Math.cos(Math.PI * (dist / radius)));
                    return 1.0 + 0.52 * (bell * bell);
                }

                // Material Kaca macOS selaras tema Global Aero/Clean Glass
                Canvas {
                    anchors.fill: parent
                    z: 0
                    property real dO: root.aeroOpacity
                    property real dR: root.aeroReflection
                    property string dSt: root.glassStyle
                    property real dTh: root.activeGlassDetail
                    property real dW: parent.width
                    onDOChanged: requestPaint()
                    onDRChanged: requestPaint()
                    onDStChanged: requestPaint()
                    onDThChanged: requestPaint()
                    onDWChanged: requestPaint()
                    onPaint: {
                        let sw = Screen.width || 1366;
                        let sh = Screen.height || 768;
                        let gx = macDockPill.x;
                        let gy = sh - height - 8;
                        root.drawGlobalAeroGlass(getContext("2d"), width, height, parent.radius, gx, gy, sw, sh, false, true);
                    }
                }

                // Bingkai kaca luar & kilau tepi atas tipis ala macOS Sonoma/Sequoia
                Rectangle {
                    anchors.fill: parent
                    radius: parent.radius
                    color: "transparent"
                    border.width: 1
                    border.color: "#3AFFFFFF"
                    z: 1

                    Rectangle {
                        anchors.top: parent.top
                        anchors.topMargin: 1
                        anchors.horizontalCenter: parent.horizontalCenter
                        width: Math.max(0, parent.width - 28)
                        height: 1
                        color: "#2CFFFFFF"
                    }
                }

                Row {
                    id: macDockRow
                    anchors.bottom: parent.bottom
                    anchors.horizontalCenter: parent.horizontalCenter
                    spacing: 6
                    z: 2

                    Repeater {
                        id: macDockRepeater
                        model: [
        { name: "Finder", icon: "system-file-manager", glyph: "F", bg: "#1E88E5", cmd: "thunar", match: "thunar" },
        { name: "Launchpad", icon: "view-app-grid-symbolic", glyph: "::", bg: "#5E5CE6", cmd: "", match: "" },
        { name: "Firefox", icon: "firefox", glyph: "FF", bg: "#FF7139", cmd: "firefox", match: "firefox" },
        { name: "Terminal", icon: "Alacritty", glyph: ">_", bg: "#1C1C1E", cmd: "alacritty", match: "alacritty" },
        { name: "Settings", icon: "preferences-system", glyph: "S", bg: "#8E8E93", cmd: "", match: "" }
    ]

                        Item {
                            id: macDockSlot
                            readonly property bool hasDivider: index > 0 && modelData.name === "Settings"
                            readonly property real targetMag: macDockPill.calcMag(index)
                            property real smoothMag: 1.0
                            property real bounceY: 0
                            property int winId: macDockWin.findRunningWinId(modelData.match)
                            property bool isRunning: winId >= 0

                            Binding {
                                target: macDockSlot
                                property: "smoothMag"
                                value: macDockSlot.targetMag
                            }

                            Behavior on smoothMag {
                                SpringAnimation {
                                    spring: 7.2
                                    damping: 0.68
                                    epsilon: 0.001
                                }
                            }

                            readonly property real iconSize: 40.0 * smoothMag
                            width: Math.round(iconSize + (hasDivider ? 13 : 0))
                            height: 84

                            // Garis pemisah vertikal tipis khas macOS sebelum Settings
                            Rectangle {
                                visible: macDockSlot.hasDivider
                                anchors.left: parent.left
                                anchors.leftMargin: 3
                                anchors.bottom: parent.bottom
                                anchors.bottomMargin: 12
                                width: 1
                                height: 34
                                radius: 0.5
                                color: "#38FFFFFF"
                            }

                            // Animasi pantulan peluncuran aplikasi khas macOS
                            SequentialAnimation {
                                id: macDockBounce
                                NumberAnimation { target: macDockSlot; property: "bounceY"; to: 14; duration: 140; easing.type: Easing.OutQuad }
                                NumberAnimation { target: macDockSlot; property: "bounceY"; to: 0; duration: 160; easing.type: Easing.InQuad }
                                NumberAnimation { target: macDockSlot; property: "bounceY"; to: 6; duration: 100; easing.type: Easing.OutQuad }
                                NumberAnimation { target: macDockSlot; property: "bounceY"; to: 0; duration: 120; easing.type: Easing.InQuad }
                            }

                            // Tooltip mengambang tepat di atas puncak ikon yang membesar
                            Rectangle {
                                anchors.horizontalCenter: macIconSquircle.horizontalCenter
                                anchors.bottom: macIconSquircle.top
                                anchors.bottomMargin: macSlotMouse.containsMouse ? 8 : 4
                                width: Math.round(macTipTxt.implicitWidth + 16)
                                height: 22
                                radius: 6.5
                                color: "#EB1C1C22"
                                border.width: 1
                                border.color: "#3CFFFFFF"
                                opacity: (macSlotMouse.containsMouse && macDockWin.isDockOpen) ? 1.0 : 0.0
                                scale: macSlotMouse.containsMouse ? 1.0 : 0.92
                                visible: opacity > 0.01

                                Behavior on opacity { NumberAnimation { duration: 110; easing.type: Easing.InOutCubic } }
                                Behavior on scale { SpringAnimation { spring: 6.8; damping: 0.72 } }
                                Behavior on anchors.bottomMargin { NumberAnimation { duration: 110; easing.type: Easing.OutCubic } }

                                Text {
                                    id: macTipTxt
                                    anchors.centerIn: parent
                                    text: modelData.name
                                    color: "#F5F5F7"
                                    font.pixelSize: 11
                                    font.weight: Font.Medium
                                }
                            }

                            // Ikon Squircle macOS (Membesar dari dasar hingga menyembul keluar kapsul kaca)
                            Rectangle {
                                id: macIconSquircle
                                anchors.horizontalCenter: parent.horizontalCenter
                                anchors.horizontalCenterOffset: macDockSlot.hasDivider ? 6 : 0
                                anchors.bottom: parent.bottom
                                anchors.bottomMargin: 9 + macDockSlot.bounceY - (macSlotMouse.pressed ? 2 : 0)
                                width: Math.round(macDockSlot.iconSize)
                                height: Math.round(macDockSlot.iconSize)
                                radius: Math.round(10 * macDockSlot.smoothMag)
                                color: macAppImg.status === Image.Ready ? "transparent" : (modelData.bg || "#2C2C2E")

                                Image {
                                    id: macAppImg
                                    anchors.fill: parent
                                    source: modelData.icon !== "" ? Quickshell.iconPath(modelData.icon, true) : ""
                                    sourceSize: Qt.size(128, 128)
                                    smooth: true
                                    mipmap: true
                                    visible: status === Image.Ready
                                }

                                Text {
                                    anchors.centerIn: parent
                                    text: modelData.glyph || ""
                                    color: "#FFFFFF"
                                    font.pixelSize: Math.round(13 * macDockSlot.smoothMag)
                                    font.bold: true
                                    visible: macAppImg.status !== Image.Ready
                                }

                                MouseArea {
                                    id: macSlotMouse
                                    anchors.fill: parent
                                    enabled: macDockWin.isDockOpen
                                    hoverEnabled: true
                                    cursorShape: Qt.PointingHandCursor
                                    onClicked: {
                                        if (modelData.name === "Launchpad") {
                                            macDockBounce.restart();
                                            root.switchPopup("launchpad");
                                        } else if (modelData.name === "Settings") {
                                            macDockBounce.restart();
                                            root.switchPopup("settings");
                                        } else if (macDockSlot.winId >= 0) {
                                            root.runCmd("niri msg action focus-window --id " + macDockSlot.winId);
                                        } else if (modelData.cmd && modelData.cmd !== "") {
                                            macDockBounce.restart();
                                            root.runCmd(modelData.cmd);
                                        }
                                    }
                                }
                            }

                            // Titik indikator aplikasi berjalan di dasar kapsul Dock
                            Rectangle {
                                anchors.bottom: parent.bottom
                                anchors.bottomMargin: 2.5
                                anchors.horizontalCenter: macIconSquircle.horizontalCenter
                                width: 4.5
                                height: 4.5
                                radius: 2.25
                                color: "#EBFFFFFF"
                                visible: macDockSlot.isRunning
                            }
                        }
                    }
                }
            }
        }
    }






    // ========================================================================
    // PANEL STUDIO KHUSUS: EDIT WIDGET DOCK
    // ========================================================================
    
}
